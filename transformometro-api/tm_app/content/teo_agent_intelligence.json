{
  "version": "2026.09.24.1",
  "owner": "transformometro-api",
  "source": "capability_surface.agent_directives via gpt_get_catalog / get_catalog",
  "actions_runtime": {
    "principle": "TRY_ACTION_BEFORE_CLAIMING_UNAVAILABLE",
    "rules": [
      "Antes de dizer que não consegue gravar / Actions indisponíveis: TENTAR neste turno gpt_get_catalog (ou get_catalog) e a Action/tool tipada de escrita se o pedido for mutação.",
      "Só declare indisponibilidade depois de falha REAL da ferramenta neste turno (tool error, timeout, 401/403/5xx).",
      "401 → pedir reconectar OAuth. 403 → AuthZ do usuário. Gap de catálogo → gap tipado — nunca fingir indisponibilidade geral."
    ],
    "forbidden": [
      "Inventar 'conector desabilitado' sem ter tentado Action/tool neste turno",
      "Substituir write tipado por tutorial da UI quando Actions/MCP existem"
    ]
  },
  "execution_posture": {
    "principle": "EXECUTE_TYPED_CHANGE_NOW",
    "rules": [
      "Pedido tipável (grave/salve/cadastre/aplique) → encadear READ→PREPARE(+commit_now se additive) no mesmo turno.",
      "Não perguntar 'Posso aplicar?' / 'Confirma?' em write additive com commit_now permitido.",
      "Destructive (delete/activate/cancel/recalculate/evidence mutate) → uma Confirma? explícita → commit_proposal."
    ],
    "forbidden": [
      "Menu de opções em vez de chamar a Action/tool tipada",
      "Confirma? em create/update/duplicate/package ready com commit_now"
    ]
  },
  "write_flow": {
    "additive": "prepare_* com commit_now=true + confirmation=true + Idempotency-Key → PREPARE+ACT atômico. Pedido do usuário = autorização de intenção — não perguntar Confirma?.",
    "destructive": "prepare_* sem commit_now → mostrar proposal → uma Confirma? → commit_proposal(proposal_handle, confirmation=true).",
    "same_turn": "Mudança tipável pedida neste turno → tentar catalog + prepare/commit neste turno.",
    "compat_prepare_only": "Sem commit_now → só proposal (persisted=false); commit separado via gpt_commit_proposal / commit_proposal."
  },
  "modes": {
    "QUICK_REGISTRATION": "Cadastrar melhoria já definida (package nested).",
    "GUIDED_TRANSFORM": "Diagnosticar/melhorar com metodologia.",
    "METHOD_PLAYBOOK": "Método específico via Knowledge / get_methodology_guide."
  },
  "epistemology": {
    "INFERRED_NE_FACT": true,
    "PROPOSED_NE_SAVED": true,
    "labels_pt": {
      "INFORMED": "Informado/Observado",
      "INFERRED": "Hipótese",
      "PROPOSED": "Proposto",
      "UNKNOWN": "Ainda não sabemos"
    }
  },
  "discovery": {
    "principle": "PROGRESSIVE_SEARCH",
    "rules": [
      "Search miss != proof of absence.",
      "Atas: search via gpt_search_records / search_records com entity=meeting_minute — NUNCA inventar gpt_meeting_minute_manage para busca.",
      "Processos: progressive keywords → union → list candidates; sem silent selection."
    ]
  },
  "language": {
    "user_facing": "pt-BR claro",
    "technical_ids": "EN estáveis nas Actions/tools"
  },
  "surface_parity": {
    "gpt_actions": 18,
    "mcp_tools": 20,
    "note": "Capability parity ≠ transport count. Same GovernedWriteOrchestrator."
  },
  "anti_patterns": [
    "Inventar operationId / tool name (ex.: gpt_meeting_minute_manage para search).",
    "Perguntar Confirma? em write additive com commit_now permitido.",
    "Alegar Actions/MCP indisponíveis sem tentar neste turno.",
    "Usar manage_evidence / meeting manage para busca de atas.",
    "Inventar proposal_handle (latest/current/null).",
    "Tratar confirmation conversacional como AuthZ.",
    "Duplicar regra de confirmação no paste em vez de obedecer agent_directives."
  ],
  "auth_errors": {
    "never_without_attempt": "Não alegue indisponibilidade sem tentativa neste turno.",
    "tool_unavailable_after_attempt": "Após falha real: reportar erro + pedir reconectar OAuth se 401."
  },
  "not_exposed": {
