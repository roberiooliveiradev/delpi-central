      "firstNWord": "\\b(?:[dn]?os|[dn]?as)\\s+(dois|duas|tres|quatro|cinco|seis|sete|oito|nove|dez)\\s+primeir[oa]s\\b",
      "firstNNumeric": "\\b(?:[dn]?os|[dn]?as)\\s+(\\d{1,2})\\s+primeir[oa]s\\b",
