  "deflectionMarkers": [
    "preciso acessar",
    "precisarei acessar",
    "preciso consultar",
    "precisarei consultar",
    "precisaria de informações",
    "preciso de informações adicionais",
    "seria necessario acessar",
    "seria necessário acessar",
    "seria necessario consultar",
    "seria necessário consultar",
    "talvez seja necessario",
    "talvez seja necessário",
    "para responder a sua consulta",
    "precisamos consultar",
    "vou verificar rapidamente",
    "nao tenho acesso",
    "não tenho acesso",
    "nao posso consultar",
    "não posso consultar",
    "nao consigo consultar",
    "não consigo consultar",
    "desculpe pela confusao",
    "desculpe pela confusão",
    "houve um erro",
    "nao especifico",
    "não especifico",
    "nao especifiquei",
    "não especifiquei",
    "no momento nao tenho",
    "no momento não tenho",
    "nao tenho informacoes",
    "não tenho informações",
    "nao foi possivel obter",
    "não foi possível obter"
  ],
  "genericContextStopwords": [
    "produto",
    "status",
    "estoque",
    "fabrica",
    "fábrica",
    "hoje",
    "filial",
    "quantidade",
    "saldo",
    "sistema",
    "gestao",
    "gestão"
  ],
  "limits": {
    "maxTemplateSimilarity": 0.72,
    "minContextTokenOverlap": 2,
    "minContextTokenLength": 4,
    "minAnswerChars": {
      "fast": 120,
      "normal": 72,
      "thinker": 160
    },
    "maxAnswerChars": {
      "fast": 420,
      "normal": 3600,
      "thinker": 4200
    },
    "maxElapsedSec": {
      "fast": 15,
      "normal": 45,
      "thinker": 90
    }
  },
  "modeLadder": {
    "requireDistinctContents": true,
    "fastMaxCharsVsNormalRatio": 1.05,
    "fastMaxElapsedVsNormalRatio": 1.25,
    "minPairwiseContentDistance": 0.06
  },
  "pipeline": {
    "allowDirectResponseModes": ["fast"],
    "directResponseEffects": {
      "fast": "llm_synthesis_brief"
    }
  },
  "coherenceChecks": {
    "gaps": {
      "emptyAnswer": "resposta vazia após síntese LLM",
      "repeatedSentences": "resposta com frases repetidas",
      "sparseNumberedList": "lista numerada com itens vazios ou esparsos"
    },
    "repeatedSentenceMinChars": 48,
    "repeatedSentenceKeyChars": 160,
    "minRepeatedSentences": 1,
    "sparseListMinLines": 2,
    "sparseListPatterns": [
      "^\\d+\\.\\s*$",
      "^\\d+\\.\\s+\\d+\\."
    ]
  }
}
