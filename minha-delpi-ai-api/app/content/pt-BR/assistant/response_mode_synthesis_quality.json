    "talvez seja necessário",
    "para responder a sua consulta",
    "precisamos consultar",
    "vou verificar rapidamente",
    "nao tenho acesso",
    "não tenho acesso",
    "nao posso consultar",
    "não posso consultar",
    "nao consigo consultar",
    "não consigo consultar",
    "desculpe pela confusao",
    "desculpe pela confusão",
