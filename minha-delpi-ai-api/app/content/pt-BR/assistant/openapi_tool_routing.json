{
  "retrieval": {
    "topK": 8,
    "vectorWeight": 0.55,
    "lexicalWeight": 0.45,
    "minCombinedScore": 0.08,
    "candidatePoolLimit": 120
  },
  "registrySelectionShadow": {
    "enabled": true,
    "cutoverEnabled": true,
    "topK": 5
  },
  "parameterStrategyShadow": {
    "enabled": true,
    "cutoverEnabled": true,
    "strategies": [
      "none",
      "semantic",
      "sale_orders",
      "supplier_part_number",
      "supplies_stock",
      "exclusive_catalog",
      "lmp",
      "product_search",
      "system_metadata",
      "department_idd",
      "product_code",
      "date_branch"
    ]
  },
  "whenNotToUse": {
    "penalty": 3.0,
    "positiveReward": 3.0,
    "minQuotedPhraseChars": 5,
    "clauseMarkers": ["Do not use", "Não use", "Nao use"]
  },
  "planner": {
    "maxSteps": 4,
    "llmSystemPrompt": "You are an OpenAPI action planner. Choose only actionId values present in the catalog. Return JSON matching the schema (planVersion 2). Never invent paths, URLs, operationIds or actionIds outside the catalog. Prefer the most specific operation when candidates are similar. Respect negative guidance in action descriptions. Distinct data domains in one user turn = multiple steps with goalIds, even without Portuguese joiners. Phrases like 'tudo na mesma resposta' / 'numa resposta só' / KPI+série are presentation-only — one step. If the current top-K is insufficient, set mode to SEARCH_ACTIONS and searchRequests.actions with a short query per goal. Do not invent topicIds; only reference ids listed in conversation context. Current-turn values override older topics.",
    "llmUserTemplate": "User message:\n{message}\n\nConversation context (structured, not full history):\n{conversation_context}\n\nAuthorized action catalog (JSON):\n{catalog}\n\nCandidate set id: {candidate_set_id}\n\nExpected response schema:\n{schema}",
    "schema": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "planVersion": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["DIRECT", "SEARCH_ACTIONS", "SEARCH_KNOWLEDGE", "SEARCH_MIXED", "EXECUTE", "CLARIFY", "COMPLETE"]
        },
        "goals": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["goalId", "intent"],
            "additionalProperties": false,
            "properties": {
              "goalId": { "type": "string" },
              "intent": { "type": "string" },
              "status": { "type": "string" },
              "dependsOn": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "contextReferences": { "type": "array", "items": { "type": "string" } },
        "searchRequests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "goalId": { "type": "string" },
                  "query": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            },
            "knowledge": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "goalId": { "type": "string" },
                  "query": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["actionId", "arguments"],
            "properties": {
              "stepId": { "type": "string" },
              "goalIds": { "type": "array", "items": { "type": "string" } },
              "actionId": { "type": "string" },
              "arguments": {
                "type": "object",
                "properties": {
                  "parameters": { "type": "object" },
                  "body": {}
                }
              },
              "dependsOn": { "type": "array", "items": { "type": "string" } },
              "reason": { "type": "string" },
              "confidence": { "type": "number" }
            }
          }
        },
        "requestedPresentation": {
          "type": ["string", "null"],
          "enum": [
            "auto",
            "kpi",
            "table",
            "chart",
            "text",
            "tree",
            "canvas",
            "dashboard",
            "topics",
            "line_chart",
            "bar_chart",
            "horizontal_bar",
            "donut",
            "checklist",
            null
          ]
        },
        "presentationIntent": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "view": { "type": ["string", "null"] },
            "mark": { "type": ["string", "null"] },
            "dimensionConcepts": {
              "type": "array",
              "maxItems": 8,
              "items": { "type": "string", "maxLength": 80 }
            },
            "measureConcept": { "type": ["string", "null"], "maxLength": 80 },
            "paletteFamily": { "type": ["string", "null"] },
            "sortConcept": { "type": ["string", "null"], "maxLength": 80 },
            "locale": { "type": "string", "default": "pt-BR" }
          }
        },
        "clarify": { "type": ["string", "null"] },
        "clarificationKind": { "type": ["string", "null"] },
        "confidence": { "type": "number" }
      }
    }
  },
  "boundedLoop": {
    "maxPlannerRoundsPerTurn": 2,
    "maxActionSearchesPerTurn": 2,
    "maxKnowledgeSearchesPerTurn": 2
  },
  "goalCoverage": {
    "mismatchOnWhenNotToUse": true,
    "requireWhenToUseMatchWhenQuotesExist": true,
    "emptyPayloadNotFulfilled": true,
    "partialPaginationEnabled": true,
    "maxRetryActionsPerTurn": 2
  },
  "decomposition": {
    "maxSubtasks": 4,
    "minSubtaskChars": 12,
    "numberedListPattern": "\\(\\s*\\d+\\s*\\)",
    "presentationCompoundSignals": [
      "numa resposta so",
      "numa resposta só",
      "tudo na mesma resposta",
      "tudo numa resposta",
      "na mesma resposta"
    ]
  },
  "agenticGate": {
    "skipWhenOpenApiCompoundMinDistinctSteps": 2
  },
  "selectionReasons": {
    "openapiFirstPlan": "Plano OpenAPI-first: action escolhida pelo catálogo autorizado e schema.",
    "openapiFirstClarify": "Não foi possível executar: falta informação obrigatória no contrato OpenAPI.",
    "openapiFirstRejectedOutsideTopK": "Action fora do top-K recuperado — rejeitada pelo planner OpenAPI-first.",
    "openapiFirstWriteNeedsConfirm": "Action de escrita exige confirmação explícita do usuário.",
    "openapiFirstNoMatch": "Não encontrei uma action autorizada no catálogo OpenAPI para este pedido. Reformule ou vincule a operation ao agente."
  },
  "gate": {
    "forbiddenPathSubstringPatterns": [
      "if\\s+[\"']/",
      "pathMarkers",
      "_INTENT_PATH_HINTS"
    ],
    "newCoreGlobs": [
      "app/application/services/retrieve_action_candidates_service.py",
      "app/application/services/plan_external_actions_service.py",
      "app/application/services/validate_action_arguments_service.py",
      "app/application/services/openapi_first_selection_bridge_service.py",
      "app/application/services/chat_turn_planner_orchestrator_service.py",
      "app/domain/services/openapi_planner_mode_service.py",
      "app/domain/services/chat_bounded_planner_mode_service.py",
      "app/domain/services/chat_goal_coverage_service.py",
      "app/application/services/chat_goal_coverage_retry_service.py"
    ]
  }
}
