{
  "version": "2026.06.16",
  "domains": {
    "product": {
      "label": "Produto",
      "pathMarkers": ["/products/{code}", "/products/"],
      "excludePathMarkers": ["/products/search", "/products/directives/"],
      "parameterStrategy": "product_code",
      "method": "GET"
    },
    "product_directives": {
      "label": "Diretivas do produto",
      "pathMarkers": ["/products/directives/"],
      "parameterStrategy": "product_code",
      "method": "GET"
    },
    "product_search": {
      "label": "Busca de produtos",
      "pathMarkers": ["/products/search"],
      "parameterStrategy": "product_search",
      "method": "GET"
    },
    "product_exclusive_catalog": {
      "label": "Catálogo MP exclusiva",
      "pathMarkers": ["/products/exclusive-raw-materials/catalog"],
      "parameterStrategy": "exclusive_catalog",
      "method": "GET"
    },
    "production_consumption": {
      "label": "Consumo produção",
      "pathMarkers": ["/production/consumption/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_losses": {
      "label": "Perdas produção",
      "pathMarkers": ["/production/losses/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_schedule": {
      "label": "Programação produção",
      "pathMarkers": ["/production/schedule/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_orders": {
      "label": "Ordens de produção",
      "pathMarkers": ["/production/orders/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_work_centers": {
      "label": "Centros de trabalho",
      "pathMarkers": ["/production/work-centers/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "purchases_ranking": {
      "label": "Ranking de compras",
      "pathMarkers": ["/purchases/top-products"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "open_sales_orders": {
      "label": "Pedidos de venda em aberto",
      "pathMarkers": ["/pedidos-venda-abertos/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "commercial_proposal_documents": {
      "label": "Propostas comerciais internas",
      "pathMarkers": ["/propostas-comerciais/"],
      "parameterStrategy": "semantic",
      "method": "GET"
    },
    "quality_action_plans": {
      "label": "PAC — planos de ação",
      "pathMarkers": ["/quality/action-plans/"],
      "parameterStrategy": "semantic",
      "method": "GET"
    },
    "department_kpi": {
      "label": "KPI departamental",
      "pathMarkers": [
        "/commercial/",
        "/financial/",
        "/production/",
        "/hr/",
        "/quality/"
      ],
      "excludePathMarkers": [
        "/production/consumption/",
        "/production/losses/",
        "/production/schedule/",
        "/production/orders/",
        "/production/work-centers/",
        "/production/allocation-gaps",
        "/production/planned-vs-real-time",
        "/quality/action-plans/"
      ],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "department_idd": {
      "label": "IDD estratégico (metas e realizado)",
      "pathMarkers": [
        "/dashboard/department-idd",
        "/dashboard/department-indicators",
        "/dashboard/departments-indicators"
      ],
      "parameterStrategy": "department_idd",
      "method": "GET"
    },
    "supplies_kpi": {
      "label": "KPI suprimentos",
      "pathMarkers": ["/supplies/"],
      "excludePathMarkers": ["/supplies/safety-stock/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "safety_stock": {
      "label": "Estoque de segurança",
      "pathMarkers": ["/supplies/safety-stock/"],
      "parameterStrategy": "product_code",
      "method": "GET"
    },
    "lmp": {
      "label": "LMP / transformação",
      "pathMarkers": ["/lmp", "/transforma"],
      "parameterStrategy": "lmp",
      "method": "GET"
    },
    "sql": {
      "label": "SQL / dados",
      "pathMarkers": ["/data/sql", "/data/"],
      "parameterStrategy": "sql",
      "method": "POST"
    },
    "system": {
      "label": "Metadados Protheus",
      "pathMarkers": ["/system/"],
      "parameterStrategy": "system_metadata",
      "method": "GET"
    },
    "generic": {
      "label": "Operacional genérico",
      "pathMarkers": [],
      "parameterStrategy": "semantic",
      "method": "GET"
    }
  },
  "parameterStrategies": {
    "product_code": {
      "description": "Código de produto com paginação, filial e armazém",
      "registryOnly": true
    },
    "date_branch": {
      "description": "Filial, intervalo de datas, paginação e granularidade",
      "patterns": {
        "branch": "\\bfilial\\s+(\\d{2})\\b",
        "work_center": "\\bct\\s+(\\S+)",
        "product_group": "\\bgrupo\\s+(\\d{4})\\b"
      },
      "bindings": [
        {
          "source": "branch_regex",
          "matchAliases": ["branch", "filial", "branch_code"]
        },
        {
          "source": "date_range.start",
          "matchAliases": [
            "start_date",
            "startdate",
            "data_inicio",
            "data_inicial",
            "date_start",
            "datestart"
          ]
        },
        {
          "source": "date_range.end",
          "matchAliases": [
            "end_date",
            "enddate",
            "data_fim",
            "data_final",
            "date_end",
            "dateend"
          ]
        },
        {
          "source": "date_range.start",
          "matchAliases": ["reference_date", "referencedate"]
        },
        {
          "source": "pagination.page",
          "matchAliases": ["page"]
        },
        {
          "source": "pagination.page_size",
          "matchAliases": ["page_size", "pagesize"]
        },
        {
          "source": "work_center_regex",
          "matchAliases": ["work_center", "workcenter"]
        },
        {
          "source": "product_group_regex",
          "matchAliases": ["product_group"]
        },
        {
          "source": "granularity_inferred",
          "matchAliases": ["granularity"]
        }
      ],
      "granularityTerms": {
        "day": ["diario", "diaria", "por dia", " ao dia", " diaria"],
        "week": ["semanal", "por semana", " semana ", "semanas"],
        "year": ["anual", "por ano", " ano ", " anos "],
        "month": [
          "serie",
          "series",
          "evolucao",
          "no tempo",
          "temporal",
          "mes",
          "mensal",
          "trimestre",
          "marco",
          "janeiro",
          "fevereiro",
          "abril",
          "maio",
          "junho",
          "julho",
          "agosto",
          "setembro",
          "outubro",
          "novembro",
          "dezembro"
        ]
      },
      "granularityDefault": "month",
      "emptyDefault": {
        "limit": 10
      }
    },
    "department_idd": {
      "description": "Departamento SI (IDD) + filial/datas para metas e realizado",
      "patterns": {
        "branch": "\\bfilial\\s+(\\d{2})\\b",
        "department_id": "\\b(comercial|commercial|qualidade|quality|producao|produção|production|financeiro|financial|financerio|suprimentos|supplies|engenharia|engineering|egenharia|engenharria|rh|hr|recursos humanos)\\b"
      },
      "departmentIdAliases": {
        "comercial": "commercial",
        "commercial": "commercial",
        "qualidade": "quality",
        "quality": "quality",
        "producao": "production",
        "produção": "production",
        "production": "production",
        "financeiro": "financial",
        "financial": "financial",
        "financerio": "financial",
        "suprimentos": "supplies",
        "supplies": "supplies",
        "engenharia": "engineering",
        "engineering": "engineering",
        "egenharia": "engineering",
        "engenharria": "engineering",
        "rh": "hr",
        "hr": "hr",
        "recursos humanos": "hr"
      },
      "pathPrefixToDepartmentId": {
        "/commercial/": "commercial",
        "/financial/": "financial",
        "/production/": "production",
        "/quality/": "quality",
        "/hr/": "hr",
        "/supplies/": "supplies",
        "/engineering/": "engineering"
      },
      "bindings": [
        {
          "source": "branch_regex",
          "matchAliases": ["branch", "filial", "branch_code"]
        },
        {
          "source": "date_range.start",
          "matchAliases": [
            "start_date",
            "startdate",
            "data_inicio",
            "data_inicial",
            "date_start",
            "datestart"
          ]
        },
        {
          "source": "date_range.end",
          "matchAliases": [
            "end_date",
            "enddate",
            "data_fim",
            "data_final",
            "date_end",
            "dateend"
          ]
        },
        {
          "source": "department_id_regex",
          "matchAliases": ["department_id", "departamento"]
        }
      ]
    },
    "product_search": {
      "description": "Termo ou código de busca",
      "registryOnly": true
    },
    "exclusive_catalog": {
      "description": "Catálogo MP exclusiva (PA/MP)",
      "registryOnly": true
    },
    "supplies_stock": {
      "description": "Limite top para valor de estoque",
      "bindings": [
        {
          "source": "literal",
          "value": 10,
          "matchAliases": ["top_limit", "limit"]
        }
      ]
    },
    "sale_orders": {
      "description": "Paginação e intervalo de datas para OVs",
      "bindings": [
        {
          "source": "pagination.page",
          "matchAliases": ["page"]
        },
        {
          "source": "pagination.page_size",
          "matchAliases": ["page_size", "pagesize", "limit"]
        }
      ],
      "emptyDefault": {
        "limit": 50
      }
    },
    "lmp": {
      "description": "Número OV ou paginação LMP",
      "registryOnly": true
    },
    "system_metadata": {
      "description": "Tabela/coluna Protheus",
      "registryOnly": true
    },
    "sql": {
      "description": "Consulta SQL somente leitura",
      "registryOnly": true
    },
    "none": {
      "description": "Sem parâmetros automáticos",
      "registryOnly": true
    },
    "semantic": {
      "description": "Ranking semântico sobre candidatos",
      "registryOnly": true
    }
  }
}
