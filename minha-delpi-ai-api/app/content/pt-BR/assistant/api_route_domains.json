      "parameterStrategy": "product_search",
      "method": "GET"
    },
    "product_exclusive_catalog": {
      "label": "Catálogo MP exclusiva",
      "pathMarkers": ["/products/exclusive-raw-materials/catalog"],
      "parameterStrategy": "semantic",
      "method": "GET"
    },
    "production_consumption": {
      "label": "Consumo produção",
      "pathMarkers": ["/production/consumption/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_losses": {
      "label": "Perdas produção",
      "pathMarkers": ["/production/losses/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_schedule": {
      "label": "Programação produção",
      "pathMarkers": ["/production/schedule/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_orders": {
      "label": "Ordens de produção",
      "pathMarkers": ["/production/orders/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "production_work_centers": {
      "label": "Centros de trabalho",
      "pathMarkers": ["/production/work-centers/"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "purchases_ranking": {
