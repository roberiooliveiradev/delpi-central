      "pathMarkers": ["/purchases/top-products"],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "department_kpi": {
      "label": "KPI departamental",
      "pathMarkers": [
        "/commercial/",
        "/financial/",
        "/production/",
        "/hr/",
        "/quality/"
      ],
      "excludePathMarkers": [
        "/production/consumption/",
        "/production/losses/",
        "/production/schedule/",
        "/production/orders/",
        "/production/work-centers/",
        "/production/allocation-gaps",
        "/production/planned-vs-real-time"
      ],
      "parameterStrategy": "date_branch",
      "method": "GET"
    },
    "supplies_kpi": {
      "label": "KPI suprimentos",
      "pathMarkers": ["/supplies/"],
