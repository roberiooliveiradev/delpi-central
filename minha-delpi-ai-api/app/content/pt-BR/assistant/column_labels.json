    "inspection": {
      "detect": {
        "anyKeys": ["inspection_type"],
        "anyKeyGroups": [["characteristic", "specification"]]
      },
      "preferredColumns": [
        ["inspection_type", "Tipo inspeção"],
        ["sequence", "Sequência"],
        ["characteristic", "Característica"],
        ["specification", "Especificação"],
        ["method", "Método"],
        ["frequency", "Frequência"],
        ["result", "Resultado"]
      ]
    },
    "movement": {
      "detect": {
        "anyKeys": ["origin_warehouse", "destination_warehouse"]
      },
      "preferredColumns": [
        ["movement_date", "Data"],
        ["operation", "Operação"],
        ["origin_warehouse", "Armazém origem"],
        ["destination_warehouse", "Armazém destino"],
        ["quantity", "Quantidade"],
        ["document", "Documento"],
        ["lot", "Lote"]
      ]
    },
    "price": {
      "detect": {
        "anyKeys": ["table_code", "sale_price"]
      },
      "preferredColumns": [
        ["table_code", "Cód. tabela"],
        ["table_description", "Tabela"],
        ["sale_price", "Preço venda"],
        ["max_price", "Preço máx."],
        ["discount_value", "Desconto"],
        ["discount_percent", "% Desconto"]
      ]
    },
    "supplier": {
      "detect": {
        "anyKeys": ["supplier_name", "supplier_code"],
        "excludeIfAnyKeys": ["invoice_number"]
      },
      "preferredColumns": [
        ["supplier_code", "Cód. fornecedor"],
        ["supplier_name", "Fornecedor"],
        ["supplier_part_number", "Part number"],
        ["last_price", "Últ. preço"],
        ["last_price_date", "Data últ. preço"],
        ["real_avg_lead_time_days", "Lead time médio (dias)"],
        ["registered_lead_time_days", "Lead time cadastrado"],
        ["real_lead_time_sample_size", "Amostras"]
      ]
    },
    "customer": {
      "detect": {
        "anyKeys": ["customer_name", "customer_code"],
        "excludeIfAnyKeys": ["invoice_number"]
      },
      "preferredColumns": [
        ["customer_code", "Cód. cliente"],
        ["customer_name", "Cliente"],
        ["customer_store", "Loja"],
        ["last_sale_date", "Data últ. venda"],
        ["last_sale_price", "Últ. preço venda"],
        ["total_quantity", "Qtd. total"],
        ["total_value", "Valor total"]
      ]
    },
    "production": {
      "detect": {
        "anyKeys": ["production_order", "scheduled_quantity", "produced_quantity"]
      },
      "preferredColumns": [
        ["production_order", "Ordem produção"],
        ["product_code", "Produto"],
        ["scheduled_date", "Data programada"],
        ["scheduled_quantity", "Qtd. programada"],
        ["produced_quantity", "Qtd. produzida"],
        ["scrap_quantity", "Qtd. refugo"],
        ["branch", "Filial"],
        ["status", "Status"]
      ]
    },
    "lmp": {
      "detect": {
        "anyKeys": ["sale_number", "sale_order"]
      },
      "preferredColumns": [
        ["sale_number", "Nº OV"],
        ["product_code", "Produto"],
        ["description", "Descrição"],
        ["branch", "Filial"],
        ["status", "Status"],
        ["delivery_date", "Data entrega"],
        ["quantity", "Quantidade"]
      ]
    },
    "kpi": {
      "detect": {
        "anyKeys": ["kpi_label", "kpi_value"]
      },
