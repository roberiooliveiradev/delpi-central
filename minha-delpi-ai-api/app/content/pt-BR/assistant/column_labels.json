  "tableProfiles": {
    "stock": {
      "detect": {
        "anyKeys": ["current_quantity", "available_quantity"]
      },
      "preferredColumns": [
        ["branch", "Filial"],
        ["warehouse", "Armazém"],
        ["product_code", "Produto"],
        ["current_quantity", "Qtd. atual"],
        ["available_quantity", "Qtd. disponível"],
        ["committed_quantity", "Qtd. empenhada"],
        ["reserved_quantity", "Qtd. reservada"],
        ["physical_location", "Localização"],
        ["cost_center", "Centro de custo"]
      ]
    },
    "invoice": {
      "detect": {
        "anyKeys": ["invoice_number"]
      },
      "preferredColumns": [
        ["invoice_number", "Nº nota"],
        ["invoice_series", "Série"],
        ["supplier_name", "Fornecedor"],
        ["customer_name", "Cliente"],
        ["issue_date", "Data emissão"],
        ["quantity", "Quantidade"],
        ["unit_price", "Preço unitário"],
        ["total_value", "Valor total"]
      ]
    },
    "guide": {
      "detect": {
        "anyKeyGroups": [
          ["operation_code", "operation_description"],
