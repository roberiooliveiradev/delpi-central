  "fallbackPolicies": [
    {
      "id": "productionSqlPreflight",
      "policy": "sql_until_rest",
      "phase": "sqlFallback",
      "order": 5,
      "runBeforeSqlRefinement": true,
      "reasonKey": "productionSqlFastPath",
      "resolver": "production_query",
      "when": {
        "productionQueryExecute": true,
        "notProductionRestRoute": true,
        "notAuthoring": true
      }
    },
    {
      "id": "productionSqlNoRestRoute",
      "policy": "sql_until_rest",
      "phase": "sqlFallback",
      "order": 10,
      "reasonKey": "productionSqlFastPath",
      "resolver": "production_query",
      "when": {
        "requiresProductionSqlKnowledge": true,
        "notProductionRestRoute": true,
        "notAuthoring": true
      }
    },
    {
      "id": "productionSqlRestMiss",
      "policy": "sql_until_rest",
      "phase": "operationalRoutes",
      "order": 10,
      "reasonKey": "productionSqlFastPath",
      "resolver": "production_query",
      "when": {
        "productionRestRoute": true,
        "notAuthoring": true,
        "afterRestMiss": true,
        "restActionNotReady": true
      }
    },
    {
      "id": "inventorySql",
      "policy": "sql_until_rest",
      "phase": "sqlFallback",
      "order": 20,
      "reasonKey": "inventorySqlFastPath",
      "resolver": "inventory_query",
      "when": {
        "requiresSqlKnowledge": true,
        "notAuthoring": true
      }
    },
    {
      "id": "genericAutoSql",
      "policy": "auto_execute",
      "phase": "sqlFallback",
      "order": 30,
      "reasonKey": "genericSql",
      "resolver": "generic_auto_execute",
      "when": {
        "requiresSqlKnowledge": true,
        "notAuthoring": true
      },
      "blockRemainingWhenRequiresSqlKnowledge": true
    },
    {
      "id": "genericAutoSqlExplicit",
      "policy": "auto_execute",
      "phase": "sqlFallback",
      "order": 40,
      "reasonKey": "genericSql",
      "resolver": "generic_auto_execute",
      "when": {
        "requiresAutoExecuteSql": true,
        "notAuthoring": true
      }
    }
  ],
