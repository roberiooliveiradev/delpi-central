      "reasonKey": "genericSql",
      "resolver": "generic_auto_execute",
      "when": {
        "requiresSqlKnowledge": true,
        "notAuthoring": true
      },
      "blockRemainingWhenRequiresSqlKnowledge": true
    },
    {
      "id": "genericAutoSqlExplicit",
