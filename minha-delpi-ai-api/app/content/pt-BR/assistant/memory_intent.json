{
  "durability": {
    "preferencePatterns": [
      "\\b(?:de agora em diante|a partir de agora|sempre que possivel|daqui (?:pra|para) frente)\\b.{0,4}(?P<rest>.{4,160})",
      "\\b(?:sempre|por favor sempre)\\s+(?P<rest>(?:responda|me responda|escreva|formate|use|prefira|evite|fale)\\b.{2,160})",
      "\\b(?:eu )?(?:prefiro|gosto de|gostaria que voce)\\s+(?P<rest>.{4,160})"
    ],
    "profilePatterns": [
      "\\b(?:meu nome (?:e|é)|pode me chamar de|me chame de)\\s+(?P<rest>[A-Za-zÀ-ÿ'\\- ]{2,60})",
      "\\b(?:meu cargo (?:e|é)|minha funcao (?:e|é)|minha função (?:e|é)|eu trabalho (?:no|na|como)|sou (?:do|da|de) (?:setor|departamento|area|área))\\s+(?P<rest>.{2,80})"
    ],
    "limits": {
      "minMessageChars": 6,
      "maxMessageChars": 400,
      "profileConfidence": 0.7,
      "preferenceConfidence": 0.65
    }
  },
  "semantic": {
    "patterns": {
      "docQuestion": "\\b(?:como\\s+funciona|o\\s+que\\s+[eé]|documenta[cç][aã]o|manual|pol[ií]tica|procedimento|arquitetura|rbac|autoriza[cç][aã]o|permiss[aã]o|fluxo\\s+de)\\b",
      "playbook": "\\b(?:playbook|padr[aã]o\\s+do\\s+playbook|mesmo\\s+padr[aã]o|roteiro\\s+oficial)\\b",
      "operationalBlock": "\\b(?:estoque|produto\\s+\\d|filial\\s+\\d|roteiro|consulta\\s+operacional)\\b"
    },
    "enrichTaskTypes": [
      "playbook_creation",
      "documentation",
      "sql_task"
    ],
    "taskTypeIntentMap": {
      "playbook_creation": "playbook",
      "documentation": "documentation",
      "sql_task": "technical"
    },
    "limits": {
      "minMessageChars": 8
    }
  },
  "episodic": {
    "patterns": {
      "recall": "\\b(?:como\\s+fizemos|playbook\\s+anterior|continue\\s+de\\s+onde|volte\\s+ao\\s+que|lembra\\s+quando|mesmo\\s+padr[aã]o|fa[cç]a\\s+igual|use\\s+o\\s+mesmo|retome\\s+a\\s+conversa|documento\\s+anterior)\\b",
      "delete": "\\b(?:apague|esque[cç]a|remova|exclua)\\b.{0,40}\\b(?:epis[oó]dio|tarefa\\s+anterior|hist[oó]rico)\\b",
      "save": "\\b(?:salve|guarde|registre)\\b.{0,30}\\b(?:epis[oó]dio|tarefa|progresso)\\b"
    },
    "limits": {
      "maxEpisodes": 8
    }
  },
  "ux": {
    "patterns": {
      "introspect": "\\b(?:quais\\s+informa[cç][oõ]es|qual\\s+contexto|o\\s+que\\s+voc[eê]\\s+est[aá]\\s+usando|mem[oó]ria\\s+usada|contexto\\s+ativo|o\\s+que\\s+lembra)\\b",
      "editPreference": "\\b(?:editar|alterar|mudar)\\b.{0,20}\\bprefer"
    }
  },
  "contextSafety": {
    "patterns": {
      "sensitive": "\\b(?:senha|password|token|api[_-]?key|cpf|cart[aã]o|chave\\s+privada|secret|bearer\\s+)\\b",
      "cpf": "\\b\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}\\b",
      "writeBlock": "\\b(?:n[aã]o\\s+salve|n[aã]o\\s+grave|sem\\s+mem[oó]ria|modo\\s+an[oô]nimo)\\b"
    }
  },
  "preference": {
    "patterns": {
      "revoke": "\\b(?:n[aã]o\\s+use\\s+mais\\b.*\\bprefer|remov(?:a|e)\\b.*\\bprefer|limpe?\\s+as\\s+prefer|esque[cç]a\\s+(?:as|essa|a)\\s+prefer|volte?\\s+ao\\s+normal|volte?\\s+ao\\s+padr[aã]o|comportamento\\s+padr[aã]o)\\w*\\b"
    },
    "labels": {
      "responseFormat:table": "Respostas em tabela",
      "responseFormat:topics": "Respostas em tópicos",
      "responseFormat:text": "Respostas em texto puro",
      "responseFormat:tree": "Respostas em árvore",
      "responseFormat:chart": "Respostas em gráfico",
      "toolsPolicy:on_request": "Não usar ferramentas sem pedir",
      "tone:formal": "Tom formal",
      "tone:direct": "Tom direto",
      "tone:simple": "Linguagem simples",
      "answerLength:short": "Respostas curtas",
      "finalVersionOnly:true": "Só versão final (correção)",
      "email:alwaysSubject": "E-mail sempre com assunto",
      "email:blankSignature": "Assinatura em branco",
      "email:direct": "E-mails mais diretos",
      "text:deliver_final_only": "Texto: só versão final",
      "text:tone_formal": "Texto: tom formal",
      "text:email_direct": "E-mails textuais diretos",
      "correction:deliverFinalOnly": "Correção: só versão final",
      "correction:preserveStyle": "Correção: preservar estilo"
    }
  },
  "sessionClear": {
    "pattern": "(?:desconsidere|ignore|esqueça|esqueca|limpe|limpar|resete|reinicie).{0,80}(?:produto|filial|prefer[eê]ncias?|contexto|mem[oó]ria|conversa|lousa|assunto)",
    "fullPhrases": [
