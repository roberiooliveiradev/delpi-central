{
  "modes": [
    {
      "id": "fast",
      "label": "Rápida",
      "description": "Síntese curta com modelo leve — ideal para respostas rápidas sem perder o painel de dados.",
      "default": false
    },
    {
      "id": "normal",
      "label": "Normal",
      "description": "Equilíbrio entre qualidade e velocidade — narrativa consultiva com limites moderados.",
      "default": true
    },
    {
      "id": "thinker",
      "label": "Pensador",
      "description": "Respostas mais elaboradas e contexto ampliado (pode demorar mais).",
      "default": false
    }
  ],
