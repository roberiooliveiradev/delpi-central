{
  "modes": [
    {
      "id": "fast",
      "label": "Rápida",
      "description": "Síntese curta com modelo leve — ideal para respostas rápidas sem perder o painel de dados.",
      "default": false
    },
    {
      "id": "normal",
      "label": "Normal",
      "description": "Equilíbrio entre qualidade e velocidade — narrativa consultiva com limites moderados.",
      "default": true
    },
    {
      "id": "thinker",
      "label": "Pensador",
      "description": "Respostas mais elaboradas e contexto ampliado (pode demorar mais).",
      "default": false
    }
  ],
  "aliases": {
    "rapida": "fast",
    "rápida": "fast",
    "quick": "fast",
    "veloz": "fast",
    "pensador": "thinker",
    "pensar": "thinker",
    "think": "thinker",
    "deep": "thinker",
    "profundo": "thinker",
    "balanced": "normal",
    "padrao": "normal",
    "padrão": "normal",
    "default": "normal"
  },
  "pipelineEffects": {
    "llm_synthesis": "Texto gerado pelo modelo com base nos dados consultados.",
    "llm_synthesis_brief": "Síntese curta gerada pelo modelo — tabelas e gráficos permanecem no painel.",
    "operational_direct": "Resposta direta dos dados — consultas factuais estreitas (filial, quantidade exata) não passam pelo modelo.",
    "simple_direct": "Resposta direta do catálogo — sem síntese LLM (saudação, hora/data, utilitários)."
  },
  "fastCommentaryDirect": {
    "enabled": true,
    "minAnswerChars": 40
  },
  "normalCommentaryDirect": {
    "enabled": true,
    "minAnswerChars": 40
  },
  "fastLlmBudget": {
    "maxFactsChars": 380,
    "skipProsePanelRules": true
  },
  "normalLlmBudget": {
    "maxFactsChars": 520,
    "skipProsePanelRules": false
  },
  "thinkerLlmBudget": {
    "maxFactsChars": 680,
    "skipProsePanelRules": false
  },
  "generationLimits": {
    "fast": {
      "model": "qwen2.5:1.5b",
      "maxTokens": 256,
      "numCtx": 1024,
      "temperature": 0.2
    },
    "normal": {
      "model": "qwen2.5:1.5b",
      "maxTokens": 1024,
      "numCtx": 4096,
      "temperature": 0.1
    },
    "thinker": {
      "model": "qwen2.5:3b",
      "maxTokens": 2048,
      "numCtx": 8192,
      "temperature": 0.15
    }
  },
  "contextBudget": {
    "fast": {
      "historyMaxMessages": 4,
      "historySummaryMaxChars": 600,
      "ragMaxChunks": 3,
      "ragMaxChars": 4000,
      "toolContextMaxChars": 4000,
      "messageSearchMaxHits": 3,
      "messageSearchMaxChars": 1500,
      "messageSearchLookbackMessages": 40
    },
    "normal": {
      "historyMaxMessages": 12,
      "historySummaryMaxChars": 1500,
      "ragMaxChunks": 6,
      "ragMaxChars": 9000,
      "toolContextMaxChars": 9000,
      "messageSearchMaxHits": 6,
      "messageSearchMaxChars": 3500,
      "messageSearchLookbackMessages": 80
    },
    "thinker": {
      "historyMaxMessages": 20,
      "historySummaryMaxChars": 2500,
      "ragMaxChunks": 8,
      "ragMaxChars": 12000,
      "toolContextMaxChars": 12000,
      "messageSearchMaxHits": 10,
      "messageSearchMaxChars": 6000,
      "messageSearchLookbackMessages": 120
    }
  },
  "latencyTargetsSec": {
    "fast": 3,
    "normal": 5,
    "thinker": 15
  },
  "qualityFallbackMinChars": 40,
  "commentaryLead": {
    "depthByMode": {
      "fast": "brief",
      "normal": "standard",
      "thinker": "expanded"
    },
    "defaultDepth": "standard",
    "briefDirectToolContextFlag": "commentaryBriefDirect",
    "synthesisEffectByDepth": {
      "brief": "llm_synthesis_brief",
      "standard": "llm_synthesis",
      "expanded": "llm_synthesis"
    },
    "profiles": {
      "brief": {
        "highlightLimit": 1,
        "interpretationMaxChars": 180,
        "summaryLineLimit": 1,
        "attentionLimit": 0,
        "limitationsLimit": 0,
        "nextStepsLimit": 0,
        "includeNarrativeInsight": false,
        "includeSummaryWhenNoHighlights": false,
        "includeNextSteps": false
      },
      "standard": {
        "highlightLimit": 2,
        "interpretationMaxChars": 0,
        "summaryLineLimit": 3,
        "attentionLimit": 3,
        "limitationsLimit": 0,
        "nextStepsLimit": 1,
        "includeNarrativeInsight": false,
        "includeSummaryWhenNoHighlights": true,
        "includeNextSteps": true
      },
      "expanded": {
        "highlightLimit": 6,
        "interpretationMaxChars": 0,
        "summaryLineLimit": 3,
        "attentionLimit": 6,
        "limitationsLimit": 4,
        "nextStepsLimit": 3,
        "includeNarrativeInsight": true,
        "includeSummaryWhenNoHighlights": true,
        "includeNextSteps": true
      }
    }
  }
}
