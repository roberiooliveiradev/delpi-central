{
  "version": "2026.09.1",
  "cutoverEnabled": true,
  "enrichMapsDeprecated": true,
  "limits": {
    "maxExtraRoutesPerTurn": 4,
    "maxFanOutKeys": 8
  },
  "domains": {
    "product": {
      "parameterStrategy": "product_code",
      "capabilities": [
        {
          "routeId": "productSummary",
          "scopeKey": "profile",
          "labelKey": "summary",
          "suggest": true
        },
        {
          "routeId": "productStock",
          "scopeKey": "stock",
          "labelKey": "stock",
          "suggest": true
        },
        {
          "routeId": "productSales",
          "scopeKey": "sales",
          "labelKey": "sales",
          "suggest": true
        },
        {
          "routeId": "productStructure",
          "scopeKey": "structure",
          "labelKey": "structure",
          "suggest": true
        },
        {
          "routeId": "productParents",
          "scopeKey": "parents",
          "labelKey": "parents",
          "suggest": false
        }
      ]
    }
  },
  "scopeToRouteId": {
    "profile": "productSummary",
    "stock": "productStock",
    "sales": "productSales",
    "structure": "productStructure",
    "parents": "productParents",
    "purchases": "productPurchases",
    "suppliers": "productSuppliers"
  },
  "enrichInsightScopes": {
    "structure": ["stock", "profile"],
    "stock": ["structure"],
    "default": ["profile"]
  },
  "semanticGoals": {
    "enrichByArtifact": {
      "structure": [
        {
          "goalId": "enrich_stock",
          "scopeLabel": "stock",
          "intentTemplate": "estoque dos itens relacionados ao produto {product_code}",
          "queryHints": ["estoque", "saldo", "disponível", "stock"]
        },
        {
          "goalId": "enrich_profile",
          "scopeLabel": "profile",
          "intentTemplate": "cadastro ou resumo dos itens do produto {product_code}",
          "queryHints": ["descrição", "cadastro", "ficha", "resumo", "summary", "profile"]
        }
      ],
      "stock": [
        {
          "goalId": "enrich_structure",
          "scopeLabel": "structure",
          "intentTemplate": "estrutura dos itens do produto {product_code}",
          "queryHints": ["estrutura", "bom", "structure"]
        }
      ],
      "default": [
        {
          "goalId": "enrich_profile",
          "scopeLabel": "profile",
          "intentTemplate": "cadastro ou resumo do produto {product_code}",
          "queryHints": ["descrição", "cadastro", "ficha", "resumo", "summary", "profile"]
        }
      ]
    }
  },
  "enrichInsightLimitsByMode": {
    "fast": {
      "maxExtraRoutes": 2,
      "maxFanOut": 4
    },
    "normal": {
      "maxExtraRoutes": 4,
      "maxFanOut": 8
    },
    "thinker": {
      "maxExtraRoutes": 6,
      "maxFanOut": 12
    }
  },
  "artifactToEnrichKey": {
    "product_structure": "structure",
    "product_stock": "stock",
    "product_summary": "profile"
  }
