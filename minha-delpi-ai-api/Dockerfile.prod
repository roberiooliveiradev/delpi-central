FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV CHAT_VISION_EXTRAS_WARN=true
ENV CHAT_EASYOCR_MODEL_DIR=/opt/delpi-vision/easyocr

# INSTALL_VISION_EXTRAS=true instala requirements-vision.txt + modelos EasyOCR na imagem.
ARG INSTALL_VISION_EXTRAS=true
ENV INSTALL_VISION_EXTRAS=${INSTALL_VISION_EXTRAS}

COPY minha-delpi-ai-api/requirements.txt minha-delpi-ai-api/requirements-vision.txt ./
COPY minha-delpi-ai-api/scripts/docker_install_vision_extras.sh \
     minha-delpi-ai-api/scripts/prefetch_vision_models.py \
     minha-delpi-ai-api/scripts/check_vision_profile_deps.py \
     ./scripts/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-por \
        tesseract-ocr-eng \
        poppler-utils \
        antiword \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && chmod +x scripts/docker_install_vision_extras.sh \
    && INSTALL_VISION_EXTRAS="${INSTALL_VISION_EXTRAS}" APP_ROOT=/app bash scripts/docker_install_vision_extras.sh

COPY minha-delpi-ai-api/ .
COPY shared/delpi_auth /app/delpi_auth

COPY minha-delpi-ai-api/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /app/scripts/install_vision_extras.sh

ENV FLASK_APP=app.main:app

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "-w", "2", "-k", "gthread", "--threads", "4", "--timeout", "300", "--graceful-timeout", "60", "--keep-alive", "5", "-b", "0.0.0.0:8000", "app.main:app"]
