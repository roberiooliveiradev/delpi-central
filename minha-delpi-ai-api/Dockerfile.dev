# Dev — Tesseract + extras de visão (EasyOCR, Docling) para OCR regional multi-motor.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=app.main:app
ENV FLASK_ENV=development
ENV CHAT_VISION_EXTRAS_ENABLED=true

COPY requirements.txt requirements-vision.txt ./

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-por \
        tesseract-ocr-eng \
        poppler-utils \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -r requirements.txt \
    && if grep -qv '^#' requirements-vision.txt | grep -q '[a-zA-Z0-9]'; then \
        pip install --no-cache-dir -r requirements-vision.txt; \
    fi

COPY . .

RUN chmod +x /entrypoint.sh /app/scripts/install_vision_extras.sh 2>/dev/null || chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["flask", "run", "--host=0.0.0.0", "--port=8000"]
