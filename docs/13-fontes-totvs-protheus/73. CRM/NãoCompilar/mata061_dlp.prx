//-------------------------------------------------------------------
/*{Protheus.doc} MATA061
Cadastro de Produto X Fornecedores (Modelo 2)

@since 03/04/2013
@version P11.80
@author Andre Anjos
*/
//-------------------------------------------------------------------
user Function DMATA061()
	Local oBrowse := BrowseDef()
	oBrowse:Activate()
Return

Static Function BrowseDef()
	Local oBrowse

	SA5->(dbSetOrder(2))

	oBrowse := FWmBrowse():New()
	oBrowse:SetAlias('SA5')
	oBrowse:SetDescription("Produto X Fornecedor")

Return oBrowse

