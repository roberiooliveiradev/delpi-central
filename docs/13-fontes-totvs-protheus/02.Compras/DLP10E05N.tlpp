#INCLUDE 'TOTVS.CH'
#INCLUDE 'FWMVCDEF.CH'
#INCLUDE 'RWMAKE.CH'
#INCLUDE 'FWPrintSetup.ch'
#INCLUDE 'TopConn.ch'
#INCLUDE 'RPTDef.ch'
#INCLUDE 'PROTHEUS.CH'

// Refatoracao do DLP10E05A em TLPP.
// Corrige: saldo 99 quebrado em multiplos lotes, ausencia de tratamento
// para o 98, perda da 2a NF quando o produto ja esta com B1_RASTRO=L,
// quantidade da NF gravada com qtd da embalagem em vez de qtd da NF.

/*/{Protheus.doc} DLP10E05N
Geracao de lote e impressao de etiqueta de recebimento Delpi.
Fluxo:
  [B] Primeira NF do produto (B1_RASTRO != L):
        gera lote unico consolidado para saldo pre-existente
        em armazem 01 (qtd = saldo atual - qtd NF), 99 e 98
        (data dDataBase-1, etiquetas por embalagem).
  [C] Sempre: gera/reaproveita lote da NF em armazem 01,
        com D5_QUANT = qtd NF, data dDataBase, etiquetas por embalagem.
Idempotencia via SD1->D1_ZLTDLP: o lote gerado e gravado em todas as
linhas SD1 da NF/produto. Reprocesso reusa lote em vez de duplicar.
@type user function
@author Pedro H. Koerich
@since 20/05/2026
/*/
User Function DLP10E05N(cDoc, cSerie, cFornece, cLoja, cFil)
    Local aArea     := FwGetArea()       as array
    Local aAreaSB1  := SB1->(FwGetArea()) as array
    Local aAreaSB2  := SB2->(FwGetArea()) as array
    Local aAreaSD1  := SD1->(FwGetArea()) as array
    Local aRet      as array
    Local nX        as numeric
    Local nQtdNF    as numeric
    Local nEmbal    as numeric
    Local nSld01    as numeric
    Local nSld99    as numeric
    Local nSld98    as numeric
    Local cLote     as character
    Local cFunBkp   as character

    Default cDoc     := SF1->F1_DOC
    Default cSerie   := SF1->F1_SERIE
    Default cFornece := SF1->F1_FORNECE
    Default cLoja    := SF1->F1_LOJA
    Default cFil     := SF1->F1_FILIAL

    cFilAnt := cFil
    FWSM0Util():setSM0PositionBycFilAnt()

    DbSelectArea("SF1")
    SF1->(DbSetOrder(1))
    If !SF1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja))
        FWAlertError("NF nao localizada", "DLP10E05N")
        FwRestArea(aArea)
        Return
    EndIf

    DbSelectArea("SA2")
    SA2->(DbSetOrder(1))
    If !SA2->(DbSeek(xFilial("SA2") + cFornece + cLoja))
        FWAlertError("Fornecedor nao localizado", "DLP10E05N")
        FwRestArea(aArea)
        Return
    EndIf

    aRet := U_zGTela(cFil, cDoc, cSerie, cFornece, cLoja)
    If aRet == Nil .Or. Len(aRet) == 0
        FwRestArea(aArea)
        Return
    EndIf

    cFunBkp := FunName()
    SetFunName("MATA220")

    For nX := 1 To Len(aRet)

        DbSelectArea("SD1")
        SD1->(DbSetOrder(1))
        If !SD1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja + aRet[nX][2]))
            FWAlertError("Item NF nao localizado: " + AllTrim(aRet[nX][2]), "DLP10E05N")
            Loop
        EndIf

        DbSelectArea("SB1")
        SB1->(DbSetOrder(1))
        If !SB1->(DbSeek(xFilial("SB1") + SD1->D1_COD))
            FWAlertError("Produto nao localizado: " + AllTrim(SD1->D1_COD), "DLP10E05N")
            Loop
        EndIf

        DbSelectArea("SBZ")
        SBZ->(DbSetOrder(1))
        If !SBZ->(DbSeek(xFilial("SBZ") + SD1->D1_COD))
            FWAlertError("SBZ nao localizado: " + AllTrim(SD1->D1_COD), "DLP10E05N")
            Loop
        EndIf

        DbSelectArea("SA5")
        SA5->(DbSetOrder(1))
        If !SA5->(DbSeek(xFilial("SA5") + cFornece + cLoja + SD1->D1_COD))
            FWAlertError("SA5 nao localizado: " + AllTrim(SD1->D1_COD), "DLP10E05N")
            Loop
        EndIf

        nQtdNF := aRet[nX][4]
        nEmbal := aRet[nX][5]

        // [B] Primeira NF do produto: ativa rastro e gera lotes pre-existentes
        Rastro(SB1->B1_COD, "L")
        RecLock("SB1", .F.)
        SB1->B1_RASTRO := "L"
        SB1->(MsUnlock())
        // [B.1] Saldo pre-existente armazem 01
        nSld01 := fGetEstoq(SD1->D1_COD, "01") - nQtdNF
        If nSld01 > 0
            cLote := NextLote(SD1->D1_COD, "L")
            If fGeraLote(SD1->D1_COD, "01", SD1->D1_DOC, SD1->D1_SERIE, dDataBase - 1, nSld01, cLote)
                SD1->(DbSetOrder(1))
                SD1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja + aRet[nX][2]))
                fImpEtq("DELPI COMPONENTES ", SD1->D1_DOC, DtoC(dDataBase - 1), SB1->B1_CODBAR, ;
                        SB1->B1_COD, SA5->A5_CODPRF, SB1->B1_UM, nSld01, nEmbal, ;
                        SB1->B1_DESC, aRet[nX][1], cLote, SBZ->BZ_MPLOCAL)
            EndIf
        EndIf
        // [B.2] Saldo pre-existente armazem 99
        SD1->(DbSetOrder(1))
        SD1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja + aRet[nX][2]))
        nSld99 := fGetEstoq(SD1->D1_COD, "99")
        If nSld99 > 0
            fDelEmp(SD1->D1_COD, Space(GetSx3Cache("D4_LOTECTL", "X3_TAMANHO")))
            cLote := NextLote(SD1->D1_COD, "L")
            If fGeraLote(SD1->D1_COD, "99", SD1->D1_DOC, SD1->D1_SERIE, dDataBase - 1, nSld99, cLote)
                SD1->(DbSetOrder(1))
                SD1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja + aRet[nX][2]))
                FWMsgRun(, {|| fImpEtq("DELPI COMPONENTES ", SD1->D1_DOC, DtoC(dDataBase - 1), ;
                                      SB1->B1_CODBAR, SD1->D1_COD, SA5->A5_CODPRF, SB1->B1_UM, ;
                                      nSld99, nEmbal, SB1->B1_DESC, aRet[nX][1], cLote, ;
                                      SBZ->BZ_MPLOCAL)}, ;
                         "Delpi - Etiqueta", "Inserindo Empenho - " + AllTrim(SD1->D1_COD))
            EndIf
        EndIf
        // [B.3] Saldo pre-existente armazem 98 (NOVO)
        SD1->(DbSetOrder(1))
        SD1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja + aRet[nX][2]))
        nSld98 := fGetEstoq(SD1->D1_COD, "98")
        If nSld98 > 0
            cLote := NextLote(SD1->D1_COD, "L")
            If fGeraLote(SD1->D1_COD, "98", SD1->D1_DOC, SD1->D1_SERIE, dDataBase - 1, nSld98, cLote)
                SD1->(DbSetOrder(1))
                SD1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja + aRet[nX][2]))
                fImpEtq("DELPI COMPONENTES ", SD1->D1_DOC, DtoC(dDataBase - 1), SB1->B1_CODBAR, ;
                        SD1->D1_COD, SA5->A5_CODPRF, SB1->B1_UM, nSld98, nEmbal, ;
                        SB1->B1_DESC, aRet[nX][1], cLote, SBZ->BZ_MPLOCAL)
            EndIf
        EndIf
        

        // [C] Lote da NF no armazem 01 - sempre, idempotente via D1_ZLTDLP
        If nQtdNF > 0
            cProd := SD1->D1_COD
            cLote := fAchaLoteNF(SD1->D1_COD, cDoc, cSerie, cFornece, cLoja)
            SD1->(DBsetOrder(1))
            SD1->(DbSeek(cFil + cDoc + cSerie + cFornece + cLoja + cProd))
            If Empty(cLote)
                cLote := NextLote(SD1->D1_COD, "L")
                If fGeraLote(SD1->D1_COD, "01", cDoc, cSerie, dDataBase, nQtdNF, cLote)
                    fGravaLoteSD1(SD1->D1_COD, cDoc, cSerie, cFornece, cLoja, cLote)
                Else
                    cLote := ""
                EndIf
            EndIf
            If !Empty(cLote)
                fImpEtq(SA2->A2_NOME, cDoc, DtoC(dDataBase), SB1->B1_CODBAR, SB1->B1_COD, ;
                        SA5->A5_CODPRF, SB1->B1_UM, nQtdNF, nEmbal, SB1->B1_DESC, ;
                        aRet[nX][1], cLote, SBZ->BZ_MPLOCAL)
            EndIf
        EndIf
    Next nX

    SetFunName(cFunBkp)

    FwRestArea(aAreaSD1)
    FwRestArea(aAreaSB2)
    FwRestArea(aAreaSB1)
    FwRestArea(aArea)
Return


/*/{Protheus.doc} fAchaLoteNF
Varre SD1 da mesma NF/produto/fornecedor/loja e retorna o
primeiro D1_ZLTDLP nao vazio (lote da NF previamente gerado).
@type Static Function
@author Pedro H. Koerich
@since 20/05/2026
@param cProd, character, codigo do produto
@param cDoc, character, numero da NF
@param cSerie, character, serie da NF
@param cFornece, character, codigo do fornecedor
@param cLoja, character, loja do fornecedor
@return character, lote encontrado ou string vazia
/*/
Static Function fAchaLoteNF(cProd, cDoc, cSerie, cFornece, cLoja)
    Local cFilSD1 := xFilial("SD1") as character
    Local cLote   := ""             as character

    DbSelectArea("SD1")
    SD1->(DbSetOrder(1))
    If SD1->(DbSeek(cFilSD1 + cDoc + cSerie + cFornece + cLoja + cProd))
        While !SD1->(EoF()) .And. ;
              SD1->D1_FILIAL  == cFilSD1  .And. ;
              SD1->D1_DOC     == cDoc     .And. ;
              SD1->D1_SERIE   == cSerie   .And. ;
              SD1->D1_FORNECE == cFornece .And. ;
              SD1->D1_LOJA    == cLoja    .And. ;
              SD1->D1_COD     == cProd
            If !Empty(SD1->D1_ZLTDLP)
                cLote := AllTrim(SD1->D1_ZLTDLP)
                Exit
            EndIf
            SD1->(DbSkip())
        End
    EndIf
Return cLote


/*/{Protheus.doc} fGravaLoteSD1
Grava o lote em D1_ZLTDLP de todas as linhas SD1 da NF/produto.
@type Static Function
@author Pedro H. Koerich
@since 20/05/2026
/*/
Static Function fGravaLoteSD1(cProd, cDoc, cSerie, cFornece, cLoja, cLote)
    Local cFilSD1 := xFilial("SD1") as character

    DbSelectArea("SD1")
    SD1->(DbSetOrder(1))
    If SD1->(DbSeek(cFilSD1 + cDoc + cSerie + cFornece + cLoja + cProd))
        While !SD1->(EoF()) .And. ;
              SD1->D1_FILIAL  == cFilSD1  .And. ;
              SD1->D1_DOC     == cDoc     .And. ;
              SD1->D1_SERIE   == cSerie   .And. ;
              SD1->D1_FORNECE == cFornece .And. ;
              SD1->D1_LOJA    == cLoja    .And. ;
              SD1->D1_COD     == cProd
            RecLock("SD1", .F.)
            SD1->D1_ZLTDLP := cLote
            SD1->(MsUnlock())
            SD1->(DbSkip())
        End
    EndIf
Return


/*/{Protheus.doc} fGeraLote
Gera um registro SD5 (lote consolidado) via Mata390.
D5_QUANT recebe a quantidade total (saldo ou NF), nao a embalagem.
@type Static Function
@author Pedro H. Koerich
@since 20/05/2026
@return logical, .T. se gerou com sucesso, .F. se erro
/*/
Static Function fGeraLote(cProd, cLocal, cDoc, cSerie, dData, nQuant, cLote)
    Local cForDlp01 := "000052" as character
    Local cForDlp02 := "000972" as character
    Local aLote     := {}       as array
    Local lOk       := .F.      as logical

    Private lMsErroAuto := .F.

    aAdd(aLote, {"D5_PRODUTO", cProd            , Nil})
    aAdd(aLote, {"D5_LOCAL"  , cLocal           , Nil})
    aAdd(aLote, {"D5_DOC"    , cDoc             , Nil})
    aAdd(aLote, {"D5_SERIE"  , cSerie           , Nil})
    aAdd(aLote, {"D5_DATA"   , dData            , Nil})
    aAdd(aLote, {"D5_QUANT"  , nQuant           , Nil})
    aAdd(aLote, {"D5_LOTECTL", cLote            , Nil})
    aAdd(aLote, {"D5_DTVALID", STOD("20491231") , Nil})

    If cEmpAnt == "01" .And. cFilAnt == "01"
        aAdd(aLote, {"D5_CLIFOR", cForDlp01, Nil})
        aAdd(aLote, {"D5_LOJA"  , "01"     , Nil})
    ElseIf cEmpAnt == "01" .And. cFilAnt == "02"
        aAdd(aLote, {"D5_CLIFOR", cForDlp02, Nil})
        aAdd(aLote, {"D5_LOJA"  , "01"     , Nil})
    EndIf

    FWMsgRun(, {|| MSExecAuto({|x, y| Mata390(x, y)}, aLote, 3)}, ;
             "Delpi - Mata390", cLocal + " - Gerando lote " + AllTrim(cLote) + " - " + AllTrim(cProd))

    If lMsErroAuto
        MostraErro()
    Else
        lOk := .T.
    EndIf
Return lOk


/*/{Protheus.doc} fGetEstoq
Retorna saldo atual de um produto/armazem respeitando MV_TPSALDO.
@type Static Function
@author replicado de DLP10E05.PRW
/*/
Static Function fGetEstoq(cProduto, cLocal)
    Local aArea    := FwGetArea()       as array
    Local aSB2Area := SB2->(FwGetArea()) as array
    Local aSB1Area := SB1->(FwGetArea()) as array
    Local nQtdStok := 0                 as numeric
    Local cFilSB2  := xFilial("SB2")    as character
    Local cTipo    := SuperGetMV("MV_TPSALDO", .F., "Q") as character

    Begin Sequence
        If cTipo == "Q"
            SB2->(DbSetOrder(1))
            If !SB2->(MsSeek(cFilSB2 + cProduto + cLocal))
                Break
            EndIf
            nQtdStok := SB2->B2_QATU - SB2->B2_QACLASS - SB2->B2_RESERVA
        ElseIf cTipo == "C"
            //DbSelectArea("SB1")
            //SB1->(DbSetOrder(1))
            //If !SB1->(MsSeek(FwxFilial("SB1") + cProduto))
            //    Break
            //EndIf
            //nQtdStok := CalcEst(cProduto, cLocal, dDataBase, "01")[1]

            SB2->(DbSetOrder(1))
            If !SB2->(MsSeek(cFilSB2 + cProduto + cLocal))
                Break
            EndIf
            nQtdStok := SB2->B2_QATU - SB2->B2_QACLASS - SB2->B2_RESERVA
        ElseIf cTipo == "S"
            DbSelectArea("SB2")
            SB2->(DbSetOrder(1))
            If !SB2->(MsSeek(cFilSB2 + cProduto + cLocal))
                Break
            EndIf
            nQtdStok := SaldoSB2(.T., , , , , , )
        EndIf
    End Sequence

    If nQtdStok <= 0
        nQtdStok := SB2->B2_QATU
    EndIf

    FwRestArea(aSB2Area)
    FwRestArea(aSB1Area)
    FwRestArea(aArea)
Return nQtdStok


/*/{Protheus.doc} fDelEmp
Faz backup em ZA1 e remove empenhos de OP para um produto antes de
gerar lote do saldo pre-existente do armazem 99.
@type Static Function
@author replicado de DLP10E05.PRW
/*/
Static Function fDelEmp(cProd, cLote)
    Local nX      := 0   as numeric
    Local aCab    := {}  as array
    Local aLine   := {}  as array
    Local aItens  := {}  as array
    Local nPosOri := 0   as numeric
    Local nPosQtd := 0   as numeric
    Local cSql    := ""  as character
    Local cEol    := Chr(10) as character

    Private lMsErroAuto := .F.

    cSql := "SELECT R_E_C_N_O_ [RECSD4], * FROM " + RetSqlName("SD4") + " SD4 (NOLOCK) " + cEol
    cSql += "WHERE SD4.D_E_L_E_T_ = '' " + cEol
    cSql += "AND SD4.D4_FILIAL = " + ValToSql(xFilial("SD4")) + cEol
    cSql += "AND D4_COD = " + ValToSql(cProd) + cEol
    cSql += "AND D4_QUANT > 0 "

    If Select("TMPSD4") <> 0
        TMPSD4->(DbCloseArea())
    EndIf
    TCQuery cSql Alias TMPSD4 New

    While TMPSD4->(!EoF())
        aCab := {{"D4_OP", TMPSD4->D4_OP, Nil}, ;
                 {"INDEX", 2, Nil}}
        aItens := {}

        SDC->(DbSetOrder(2))
        SD4->(DbSetOrder(2))
        SD4->(DbSeek(xFilial("SD4") + PadR(TMPSD4->D4_OP, Len(SD4->D4_OP))))

        While SD4->(!EoF()) .And. SD4->(D4_FILIAL + D4_OP) == ;
              xFilial("SD4") + PadR(TMPSD4->D4_OP, Len(SD4->D4_OP))
            If cProd == SD4->D4_COD
                RecLock("ZA1", .T.)
                ZA1->ZA1_FILIAL := SD4->D4_FILIAL
                ZA1->ZA1_STATUS := "0"
                ZA1->ZA1_COD    := SD4->D4_COD
                ZA1->ZA1_OP     := SD4->D4_OP
                ZA1->ZA1_QUANT  := SD4->D4_QUANT
                ZA1->ZA1_QTDEOR := SD4->D4_QTDEORI
                ZA1->ZA1_RECSD3 := TMPSD4->RECSD4
                ZA1->ZA1_DATA   := dDataBase
                ZA1->ZA1_CDROT  := SD4->D4_ROTEIRO
                ZA1->ZA1_OPERAC := SD4->D4_OPERAC
                ZA1->(MsUnlock())
            EndIf

            aLine := {}
            For nX := 1 To SD4->(FCount())
                aAdd(aLine, {SD4->(Field(nX)), SD4->(FieldGet(nX)), Nil})
            Next nX

            aAdd(aLine, {"LINPOS", "D4_COD+D4_TRT+D4_LOTECTL+D4_NUMLOTE+D4_LOCAL+D4_OPORIG+D4_SEQ", ;
                         SD4->D4_COD, SD4->D4_TRT, SD4->D4_LOTECTL, SD4->D4_NUMLOTE, ;
                         SD4->D4_LOCAL, SD4->D4_OPORIG, SD4->D4_SEQ})

            If cProd == SD4->D4_COD .And. SD4->D4_QTDEORI == SD4->D4_QUANT
                aAdd(aLine, {"AUTDELETA", "S", Nil})
            ElseIf cProd == SD4->D4_COD .And. SD4->D4_QTDEORI != SD4->D4_QUANT
                nPosOri := aScan(aLine, {|x| x[1] == "D4_QTDEORI"})
                nPosQtd := aScan(aLine, {|x| x[1] == "D4_QUANT"})
                aLine[nPosOri, 2] -= SD4->D4_QUANT
                aLine[nPosQtd, 2] := 0.00
            EndIf

            aAdd(aItens, aLine)
            SD4->(DbSkip())
        End

        lMsErroAuto := .F.
        If Len(aItens) == 1
            MSExecAuto({|x, y, z| Mata381(x, y, z)}, aCab, {}, 5)
        Else
            MSExecAuto({|x, y, z| Mata381(x, y, z)}, aCab, aItens, 4)
        EndIf

        If lMsErroAuto
            DbSelectArea("ZA1")
            ZA1->(DbSetOrder(1))
            If ZA1->(DbSeek(xFilial("ZA1") + TMPSD4->D4_COD + TMPSD4->D4_OP))
                RecLock("ZA1", .F.)
                ZA1->ZA1_STATUS := "A"
                ZA1->ZA1_DLPLTC := cLote
                ZA1->(MsUnlock())
            EndIf
            MostraErro()
        Else
            DbSelectArea("ZA1")
            ZA1->(DbSetOrder(1))
            If ZA1->(DbSeek(xFilial("ZA1") + TMPSD4->D4_COD + TMPSD4->D4_OP))
                RecLock("ZA1", .F.)
                ZA1->ZA1_STATUS := "1"
                ZA1->ZA1_DLPLTC := cLote
                ZA1->(MsUnlock())
            EndIf
        EndIf

        TMPSD4->(DbSkip())
    End
    TMPSD4->(DbCloseArea())
Return


/*/{Protheus.doc} fImpEtq
Imprime N etiquetas de recebimento Delpi, uma por embalagem.
N = Ceiling(cQtdNf / cEmbal). Replicado do DLP10E05 (Static do .PRW).
Strings ASCII para garantir gravacao em cp1252.
@type Static Function
/*/
Static Function fImpEtq(cNomeFor, cNF, cReceb, cCodBar, cCodProd, cProdFor, ;
                        cUnidMed, cQtdNf, cEmbal, cDescPr, cSitIns, cLote, cMpLoc)
    Local cDir     := "C:\Etiqueta\" as character
    Local cArquivo as character
    Local nX       := 0  as numeric
    Local nRest    := 0  as numeric
    Local nColMeio as numeric
    Local nColIni  := 10 as numeric
    Local nColFin  := 215 as numeric
    Local lDebug   := .T. as logical
    Local lSetup   := .T. as logical
    Local cLogoD   as character
    Local cDscSit  := "" as character
    Local oPrintPvt
    Local oFont22N, oFont16N, oFont13, oFont10, oFont08, oFont06, oFont06T

    cArquivo := "dlpetiq" + RetCodUsr() + "_" + DtoS(Date()) + "_" + StrTran(Time(), ":", "-") + ".pdf"
    nColMeio := (nColFin - nColIni) / 2

    cCodBar := AllTrim(cCodBar)

    If lDebug
        oPrintPvt := FWMSPrinter():New(cArquivo, IMP_PDF, .F., cDir, lSetup, , @oPrintPvt, , , , , .T.)
        oPrintPvt:cPathPDF := GetTempPath()
        oPrintPvt:SetResolution(72)
        oPrintPvt:SetPortrait()
        oPrintPvt:SetPaperSize(0, 80, 110)
        oPrintPvt:SetMargin(025, 001, 001, 001)
    Else
        oPrintPvt := FWMSPrinter():New(cArquivo, IMP_SPOOL, .F., , lSetup, , @oPrintPvt, , .F., , , .F.)
        oPrintPvt:SetMargin(025, 001, 001, 001)
    EndIf

    cEmbal := Iif(cEmbal == 0, cQtdNf, cEmbal)

    For nX := 1 To Ceiling(cQtdNf / cEmbal)
        oPrintPvt:StartPage()

        cLogoD := GetSrvProfString("Startpath", "") + "lgrl" + cEmpAnt + ".BMP"

        oFont22N := TFontEx():New(oPrintPvt, "Arial", 22, 22, .T., .T., .F.)
        oFont16N := TFontEx():New(oPrintPvt, "Arial", 16, 16, .T., .T., .F.)
        oFont13  := TFontEx():New(oPrintPvt, "Arial", 13, 13, .F., .T., .F.)
        oFont10  := TFontEx():New(oPrintPvt, "Arial", 10, 10, .F., .T., .F.)
        oFont08  := TFontEx():New(oPrintPvt, "Arial", 08, 08, .F., .T., .F.)
        oFont06  := TFontEx():New(oPrintPvt, "Arial", 10, 10, .T., .T., .F.)
        oFont06T := TFontEx():New(oPrintPvt, "Arial", 15, 15, .T., .T., .F.)

        oPrintPvt:SayBitmap(009, 20, cLogoD, 045, 030)
        oPrintPvt:Say(025, nColMeio - 15, "ETIQUETA RECEBIMENTO"          , oFont16N:oFont, 50)
        oPrintPvt:Say(053, nColIni      , "Fornecedor: "                  , oFont06:oFont , 50)
        oPrintPvt:Say(053, nColIni + 50 , cNomeFor                        , oFont06:oFont , 50)
        oPrintPvt:Say(068, nColIni      , "NF: "                          , oFont06:oFont , 50)
        oPrintPvt:Say(068, nColIni + 20 , cNF                             , oFont06:oFont , 50)
        oPrintPvt:Say(068, nColMeio + (nColMeio / 2)      , "Recebido: "  , oFont06:oFont , 50)
        oPrintPvt:Say(068, nColMeio + (nColMeio / 2) + 40 , cReceb        , oFont06:oFont , 50)
        oPrintPvt:Say(078, nColMeio + (nColMeio / 2)      , "Mapa Localizacao: ", oFont06:oFont, 50)
        oPrintPvt:Say(088, nColMeio + (nColMeio / 2)      , cMpLoc        , oFont10:oFont , 50)

        oPrintPvt:Code128(075, nColIni, cLote, 1, 22, .T., , 75)

        oPrintPvt:Say(130, nColIni + 10, "Produto Fornecedor: " , oFont06:oFont, 50)
        oPrintPvt:Say(140, nColIni + 25, cProdFor               , oFont06:oFont, 50)
        oPrintPvt:Say(155, nColIni     , "Especie Volume: "     , oFont06:oFont, 50)
        oPrintPvt:Say(155, nColIni + 65, cUnidMed               , oFont06:oFont, 50)
        oPrintPvt:Say(170, nColIni     , "Quantidade NF: "      , oFont06:oFont, 50)
        oPrintPvt:Say(170, nColIni + 63, cValToChar(cQtdNf)     , oFont06:oFont, 50)
        oPrintPvt:Say(185, nColIni     , "Qtd Volume: "         , oFont06:oFont, 50)

        If nX == Ceiling(cQtdNf / cEmbal)
            If cQtdNf % cEmbal == 0
                oPrintPvt:Say(185, nColIni + 53, cValToChar(cEmbal), oFont06:oFont, 50)
            Else
                nRest := cQtdNf % cEmbal
                oPrintPvt:Say(185, nColIni + 53, cValToChar(nRest), oFont06:oFont, 50)
            EndIf
        Else
            oPrintPvt:Say(185, nColIni + 53, cValToChar(cEmbal), oFont06:oFont, 50)
        EndIf

        oPrintPvt:Say(098, nColMeio + (nColMeio / 2)     , "Produto:", oFont06:oFont, 50)
        oPrintPvt:Say(098, nColMeio + (nColMeio / 2) + 40, cCodProd  , oFont10:oFont, 50)

        oPrintPvt:Say(110, nColMeio + (nColMeio / 2), MemoLine(cDescPr, 30, 1), oFont08:oFont, 50)
        oPrintPvt:Say(120, nColMeio + (nColMeio / 2), MemoLine(cDescPr, 30, 2), oFont08:oFont, 50)
        oPrintPvt:Say(130, nColMeio + (nColMeio / 2), MemoLine(cDescPr, 30, 3), oFont08:oFont, 50)

        oPrintPvt:Code128C(170, nColMeio + (nColMeio / 2), Left(cCodBar, 40), 35)

        oPrintPvt:Say(185, nColMeio + (nColMeio / 2)     , "Volume:", oFont06:oFont, 50)
        oPrintPvt:Say(185, nColMeio + (nColMeio / 2) + 35, ;
                      cValToChar(nX) + "/" + cValToChar(Ceiling(cQtdNf / cEmbal)), oFont06:oFont, 50)

        cDscSit := ""
        If !Empty(cSitIns)
            If AllTrim(cSitIns) == "1"
                cDscSit := "Aprovado"
            ElseIf AllTrim(cSitIns) == "2"
                cDscSit := "Rejeitado"
            Else
                cDscSit := "Lib. Condicional"
            EndIf
            oPrintPvt:Say(185, nColMeio + (nColMeio / 2)     , "Sit. Inspecao:", oFont06:oFont, 50)
            oPrintPvt:Say(195, nColMeio + (nColMeio / 2) + 55, cDscSit         , oFont06:oFont, 50)
        EndIf

        oPrintPvt:EndPage()
    Next nX

    oPrintPvt:Print()
Return


/*/{Protheus.doc} User Function zGTela
Tela Para selecionar itens do documento de entrada.
@author Eduardo Dalitz
@since 20/02/2025
@version 1.0
@type function
/*/
User Function zGTela(cFil, cNF, cSerie, cFornece, cLoja)
    Local aArea := FWGetArea()
    Private aRet := {}

    fMontaTela(cFil, cNF, cSerie, cFornece, cLoja)

    FWRestArea(aArea)
Return aRet

Static Function fMontaTela(cFil, cNF, cSerie, cFornece, cLoja)
    Local aArea         := GetArea()
    Local aCampos := {}
    Local oTempTable := Nil
    Local aColunas := {}
    Local cFontPad    := 'Tahoma'
    Local oFontGrid   := TFont():New(cFontPad, /*uPar2*/, -14)
    //Barra de Botões
    Local bBlocoOk     := {|| lOk := .T., oDlgBrow:End()}
    Local bBlocoCan    := {|| lOk := .F., oDlgBrow:End()}
    Local aOutrasAc    := {}
    Local bBlocoIni    := {|| EnchoiceBar(oDlgBrow, bBlocoOk, bBlocoCan, , aOutrasAc)}
    Private lOk        := .F.
    //Janela e componentes
    Private oDlgBrow
    Private oPanGrid
    Private oFWBrowse
    Private cAliasTmp := GetNextAlias()
    Private aRotina   := MenuDef()
    //Tamanho da janela
    Private aTamanho := MsAdvSize()
    Private nJanLarg := 1300//aTamanho[5]
    Private nJanAltu := 500//aTamanho[6]

    //Opções no Outras Ações
    aAdd(aOutrasAc, {'BMP', {|| fMarkTod()}, '* (Des) Marcar todos registros'})

    //Adiciona as colunas que serão criadas na temporária
    aAdd(aCampos, { 'FLAG_OK',    'L'  , 1,                    0}) //Flag para marcação
    aAdd(aCampos, { 'X_SITINS',   'C', 1,  0}) //Produto
    aAdd(aCampos, { 'D1_COD',     'C', TamSX3('D1_COD')[1], 0}) //Tipo
    aAdd(aCampos, { 'B1_DESC',    'C', TamSX3('B1_DESC')[1],   0}) //Unid. Med.
    aAdd(aCampos, { 'D1_QUANT',   'N', TamSX3('D1_QUANT')[1], 0}) //Descrição
    aAdd(aCampos, { 'A5_EMBAL',   'N', TamSX3('A5_EMBAL')[1], 0}) //Descrição
    aAdd(aCampos, { 'xVolume',    'C', 10, 0}) //Descrição
    aAdd(aCampos, { 'RECNUM',     'N', 16,                   0}) //RecNo da SB1

    //Cria a tabela temporária
    oTempTable:= FWTemporaryTable():New(cAliasTmp)
    oTempTable:SetFields( aCampos )
    oTempTable:Create()

    //Popula a tabela temporária
    Processa({|| fPopula(cFil, cNF, cSerie, cFornece, cLoja)}, 'Processando...')

    //Adiciona as colunas que serão exibidas no browse
    aColunas := fCriaCols()

    //Criando a janela
    oDlgBrow := TDialog():New(0, 0, nJanAltu, nJanLarg, 'Marcar itens do Documento de entrada', , , , , , /*nCorFundo*/, , , .T.)
    //Dados

    oFWBrowse := FWBrowse():New()
    oFWBrowse:DisableFilter()
    oFWBrowse:DisableConfig()
    oFWBrowse:DisableReport()
    oFWBrowse:DisableSeek()
    oFWBrowse:DisableSaveConfig()
    oFWBrowse:SetFontBrowse(oFontGrid)
    oFWBrowse:SetAlias(cAliasTmp)
    oFWBrowse:SetDataTable()
    oFWBrowse:SetEditCell(.T., {|| .T.})
    oFWBrowse:lHeaderClick := .F.
    oFWBrowse:AddMarkColumns(;
        {|| Iif((cAliasTmp)->FLAG_OK, 'LBOK', 'LBNO') },;      //Ícones
        {|| (cAliasTmp)->FLAG_OK := ! (cAliasTmp)->FLAG_OK};   //ao dar duplo clique
        )

    //Define as colunas, vincula ao painel e exibe
    oFWBrowse:SetColumns(aColunas)
    oFWBrowse:SetOwner(oDlgBrow)
    oFWBrowse:Activate()

    oDlgBrow:Activate(, , , .T., , , bBlocoIni)

    //Se usuário clicou no botão confirmar
    If lOk
        fConfirmou()
    EndIf

    //Deleta a temporária e desativa a tela de marcação
    oTempTable:Delete()
    oFWBrowse:DeActivate()

    RestArea(aArea)
Return

Static Function MenuDef()
    Local aRotina := {}

    //Criação das opções
    ADD OPTION aRotina TITLE 'Continuar'  ACTION 'fConfirmou()'     OPERATION 2 ACCESS 0
Return aRotina

Static Function fMarkTod()
    //Percorre todos os registros
    DbSelectArea(cAliasTmp)
    (cAliasTmp)->(DbGoTop())
    While ! (cAliasTmp)->(EoF())
        //Atualiza o registro atual
        RecLock(cAliasTmp, .F.)
        (cAliasTmp)->FLAG_OK := ! (cAliasTmp)->FLAG_OK
        (cAliasTmp)->(MsUnlock())

        (cAliasTmp)->(DbSkip())
    EndDo

    //Volta pro topo, e atualiza a tela
    (cAliasTmp)->(DbGoTop())
    oFWBrowse:Refresh()
Return


Static Function fPopula(cFil, cNF, cSerie, cFornece, cLoja)
    Local cQryDados := ''
    Local nTotal := 0
    Local nAtual := 0

    //Monta a consulta

    //Seleciona dados do documento de entrada
    cQryDados := " SELECT "                                                              + CRLF
    cQryDados += "     D1_COD COD, "                                                     + CRLF
    cQryDados += "     B1_DESC, "                                                        + CRLF
    cQryDados += "     SUM(D1_QUANT)D1_QUANT, MAX(SD1.R_E_C_N_O_ )AS SD1REC "            + CRLF
    cQryDados += " FROM "                                                                + CRLF
    cQryDados += "     " + RetSQLName('SD1') + " SD1 "                                   + CRLF
    cQryDados += "     INNER JOIN  " + RetSQLName('SB1') + "  SB1 ON D1_COD = B1_COD   " + CRLF
    cQryDados += " WHERE "                                                               + CRLF
    cQryDados += "      SD1.D_E_L_E_T_ = ' ' "                                           + CRLF
    cQryDados += "     AND SB1.D_E_L_E_T_ = ' ' "                                        + CRLF
    cQryDados += "     AND SB1.B1_TIPO      = 'MP' "                                     + CRLF
    cQryDados += "     AND SD1.D1_ZLTDLP     = ' ' "                                      + CRLF
    cQryDados += "     AND D1_FILIAL        = '" + cFilAnt + "' "                           + CRLF
    cQryDados += "     AND D1_DOC           = '" + cNF + "' "                            + CRLF
    cQryDados += "     AND D1_SERIE         = '" + cSerie + "' "                         + CRLF
    cQryDados += "     AND D1_FORNECE       = '" + cFornece + "' "                       + CRLF
    cQryDados += "     AND D1_LOJA          = '" + cLoja + "' "                          + CRLF
    cQryDados +=" GROUP BY D1_COD,B1_DESC "
    cQryDados += " ORDER BY COD "                                                        + CRLF

    PLSQuery(cQryDados, 'QRYDADTMP')

    //Definindo o tamanho da régua
    DbSelectArea('QRYDADTMP')
    Count to nTotal
    ProcRegua(nTotal)
    QRYDADTMP->(DbGoTop())

    //Enquanto houver registros, adiciona na temporária
    While ! QRYDADTMP->(EoF())
        nAtual++
        IncProc('Analisando registro ' + cValToChar(nAtual) + ' de ' + cValToChar(nTotal) + '...')

        nQtdEmb := QRYDADTMP->D1_QUANT
        DbSelectArea("SBZ")
        SBZ->(DbSetOrder(1))
        if   SBZ->(DbSeek(xFilial('SBZ')+QRYDADTMP->COD))

            nQtdEmb :=SBZ->BZ_QE

        endif

        DbSelectArea("SA5")
        SA5->(DbSetOrder(1))
        IF SA5->(DbSeek(xfilial("SA5")+cFornece+cLoja+QRYDADTMP->COD))

            IF SA5->A5_EMBAL >0
                nQtdEmb :=SA5->A5_EMBAL
            endif
        endif
        //
        RecLock(cAliasTmp, .T.)
        (cAliasTmp)->FLAG_OK := .F.
        (cAliasTmp)->X_SITINS := M->X_SITINS
        (cAliasTmp)->D1_COD := QRYDADTMP->COD
        (cAliasTmp)->B1_DESC := QRYDADTMP->B1_DESC
        (cAliasTmp)->D1_QUANT := QRYDADTMP->D1_QUANT
        (cAliasTmp)->A5_EMBAL := nQtdEmb
        //(cAliasTmp)->xVolume := cValtoChar(QRYDADTMP->D1_QUANT)+"/"+ cValtoChar(SA5->A5_EMBAL)
        (cAliasTmp)->xVolume := cValtoChar(QRYDADTMP->D1_QUANT)+"/"+ cValtoChar(nQtdEmb)
        (cAliasTmp)->RECNUM := QRYDADTMP->SD1REC
        (cAliasTmp)->(MsUnlock())

        QRYDADTMP->(DbSkip())
    EndDo
    QRYDADTMP->(DbCloseArea())
    (cAliasTmp)->(DbGoTop())
Return


Static Function fCriaCols()
    Local nAtual       := 0
    Local aColunas := {}
    Local aEstrut  := {}
    Local oColumn

    //Adicionando campos que serão mostrados na tela
    //[1] - Campo da Temporaria
    //[2] - Titulo
    //[3] - Tipo
    //[4] - Tamanho
    //[5] - Decimais
    //[6] - Máscara
    //[7] - Editável? .T. = sim, .F. = não
    aAdd(aEstrut, { 'X_SITINS',  'Situação Inspeção',    'C', 1,  0, '',     .T., {"1=Aprovado", "2=Rejeitado", "3=Liberado Condicional"}})
    aAdd(aEstrut, { 'D1_COD',    'Código',       'C', TamSX3('D1_COD')[1], 0, '',     .F., Nil})
    aAdd(aEstrut, { 'B1_DESC',   'Descrição Prod', 'C', TamSX3('B1_DESC')[1],   0, '',     .F., Nil})
    aAdd(aEstrut, { 'D1_QUANT',  'Quantidade',  'C', TamSX3('D1_QUANT')[1], 0, '',     .F., Nil})
    aAdd(aEstrut, { 'A5_EMBAL',   'Qtd. Volume', 'C', TamSX3('A5_EMBAL')[1],   0, '',     .F., Nil})
    aAdd(aEstrut, { 'xVolume',   'Volume',  'C', 10, 0, '',     .F., Nil})

    //Percorrendo todos os campos da estrutura
    For nAtual := 1 To Len(aEstrut)
        //Cria a coluna
        oColumn := FWBrwColumn():New()
        oColumn:SetData(&('{|| ' + cAliasTmp + '->' + aEstrut[nAtual][1] +'}'))
        oColumn:SetTitle(aEstrut[nAtual][2])
        oColumn:SetType(aEstrut[nAtual][3])
        oColumn:SetSize(aEstrut[nAtual][4])
        oColumn:SetDecimal(aEstrut[nAtual][5])
        oColumn:SetPicture(aEstrut[nAtual][6])
        nAling := 2
        oColumn:SetAlign(nAling)

        //Se for ser possível ter o duplo clique
        If aEstrut[nAtual][7]
            oColumn:SetEdit(.T.)
            oColumn:SetReadVar(aEstrut[nAtual][1])
            //oColumn:SetValid({|| fSuaValid()})
        EndIf

        If ! Empty(aEstrut[nAtual][8])
            oColumn:SetOptions(aEstrut[nAtual][8])
        EndIf

        //Adiciona a coluna
        aAdd(aColunas, oColumn)
    Next
Return aColunas

Static Function fConfirmou()
    Processa({|| fProcessa()}, 'Processando...')
Return

Static Function fProcessa()
    Local aArea     := FWGetArea()
    Local nAtual    := 0
    Local nTotal    := 0
    Local nTotMarc := 0

    //Define o tamanho da régua
    DbSelectArea(cAliasTmp)
    (cAliasTmp)->(DbGoTop())
    Count To nTotal
    ProcRegua(nTotal)

    //Percorrendo os registros
    (cAliasTmp)->(DbGoTop())
    While ! (cAliasTmp)->(EoF())

        nAtual++
        IncProc('Analisando registro ' + cValToChar(nAtual) + ' de ' + cValToChar(nTotal) + '...')

        //Caso esteja marcado
        If (cAliasTmp)->FLAG_OK

            nTotMarc++
            aadd(aRet, {(cAliasTmp)->X_SITINS, (cAliasTmp)->D1_COD,(cAliasTmp)->B1_DESC, (cAliasTmp)->D1_QUANT, (cAliasTmp)->A5_EMBAL})

        EndIf

        (cAliasTmp)->(DbSkip())

    EndDo

    FWRestArea(aArea)
Return
