User Function A650CCF()
	Local cRet := SPACE(1)
	Local aArea:= GetArea()
	Local aAreaSB1:=SB1->(GetArea())

	If (SB1->(DBSEEK(xFILIAL("SB1")+ParamIxb[1])))
		If SB1->B1_TPMAT = "2"
			cRet := "C"
		EndIf
	EndIf

	RestArea(aAreaSB1)
	RestArea(aArea)

Return cRet
