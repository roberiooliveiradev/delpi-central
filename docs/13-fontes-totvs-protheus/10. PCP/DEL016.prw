Static Function Geracao()

//ฺฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฟ
//ณ Cria o arquivo texto                                                ณ
//ภฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤู

If Empty(dDatade) .or. Empty(dDataate) .or. Empty(cSacram)
	MsgStop("Por Favor Preencha todos os campos da Tela","Aten็ใo")
	Return(nil)
EndIf

If dDataate < dDatade .or. (cSacram # "S" .and. cSacram # "N")
	MsgStop("Por Favor Informe os dados corretamente","Aten็ใo")
	Return(nil)
Endif

Processa({|| RunCont() },"Processando...")
Return

