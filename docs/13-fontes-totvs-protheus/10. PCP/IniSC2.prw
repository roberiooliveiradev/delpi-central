User Function IniSC2()

Local cNum := Space(TamSx3('C2_NUM')[1])

If	Select('TSC2') <> 0
	TSC2->(DbCloseArea())
EndIf

BeginSql Alias 'TSC2'
	%NoParser%
	SELECT MAX(C2_NUM) AS C2_NUM 
	FROM %Table:SC2%
	WHERE C2_FILIAL = %xFilial:SC2%
	AND %NotDel%
EndSql

If	!TSC2->(Eof())
    cNum := Soma1(TSC2->C2_NUM)
Else
	cNum := GetNumSC2()
EndIf

Return cNum