	***********************
User Function MA260D3()
	*************
	dbSelectArea("SB1")
	If Left(SB1->B1_COD,1) == '9'
		Msgbox('Favor verificar saldo de materias primas ou dos empenhos.')
	EndIf
	nOrder:=IndexOrd()
	nRecno:=Recno()
	iF 	Alltrim(CLOCDEST) == '50'
		u_DLP200B(cCodOrig)
	EndIf
	dbSelectArea("SB1")
	dbSetOrder(nOrder)
	dbGoTo(nRecno)
	Return()

	***********************
User Function DLP200C(cProduto)
	*************
	nQtdComp := 0
	DbSelectArea("SB1")
	DbSetOrder(1)
	If DbSeek(xFilial("SB1")+cProduto)
		nQtd := SB2->B2_QATU
		DbSelectArea("SB2")
		If DbSeek(xFilial("SB2")+SB1->B1_COD+'99')
			nQtdComp := SB2->B2_QEMP + SB1->B1_ESTSEG - (SB2->B2_QATU + nQtd)
		EndIf
		// Excluir com o que está em aberto a comprar...
		DbSelectArea("SC1")
		DbSetorder(5)
		DbSeek(xFilial("SC1")+Space(6)+SB1->B1_COD, .T.)
		While !Eof() .AND. xFilial("SC1")+Space(6)+SB1->B1_COD == SC1->C1_FILIAL+SC1->C1_COTACAO+SC1->C1_PRODUTO
			nQtdComp -= SC1->C1_QUANT
			DbSkip()
		EndDo
		// Excluir com o aberto do SC7
		DbSelectArea("SC7")
		DbSetOrder(15)
		DbSeek(xFilial("SC7")+" "+SB1->B1_COD, .T.)
		While !Eof() .AND. xFilial("SC7")+" "+SB1->B1_COD == SC7->C7_FILIAL+SC7->C7_ENCER+SC7->C7_PRODUTO
			nQtdComp -= (SC7->C7_QUANT - SC7->C7_QUJE)
			DbSkip()
		EndDo
		// Excluir com o aberto do SC8
		DbSelectArea("SC8")
		DbSetOrder(6)
		DbSeek(xFilial("SC8")+Space(6)+SB1->B1_COD, .T.)
		While !Eof() .AND. xFilial("SC8")+Space(6)+SB1->B1_COD == SC8->C8_FILIAL+SC8->C8_NUMPED+SC8->C8_PRODUTO
			nQtdComp -= nQteSc8
			DbSkip()
		EndDo
		lGerar := (nQtdComp > 0)
		If lGerar
			If (SB1->B1_LE > 0) .AND. (nQtdComp % SB1->B1_LE > 0)
				nQtdComp := (Int(nQtdComp / SB1->B1_LE) + 1) * SB1->B1_LE
			EndIf
			If (SB1->B1_LM > 0) .AND. (nQtdComp < SB1->B1_LM)
				nQtdComp := SB1->B1_LM
			EndIf
		EndIf
	EndIf
	Return(nQtdComp)


	***************************************************
User Function SD3250I()
	***************************************************
	Local nQtd, nQtdComprar, lGerar


	DbSelectArea("SD4")
	DbSetOrder(2)
	DbSeek(xFilial("SD4") + SC2->C2_NUM+SC2->C2_ITEM+SC2->C2_SEQUEN, .T.)
	While !Eof() .AND. RTrim(SD4->D4_FILIAL+SD4->D4_OP) == xFilial("SD4")+SC2->C2_NUM+SC2->C2_ITEM+SC2->C2_SEQUEN
		If SD4->D4_LOCAL != '01'
			DbSkip()
			Loop
		EndIf
		DbSelectArea("SB2")
		DbSetOrder(1)
		If DbSeek(xFilial("SB2")+SD4->D4_COD+SD4->D4_LOCAL)
			// Se o estoque, junto com tudo que tem a comprar, está abaixo do estoque seguro...
			nQtdComprar := u_DLP200C(SD4->D4_COD)
			If nQtdComprar > 0
				RecLock("SC1", .T.)
				SC1->C1_FILIAL   := xFilial("SC1")
				SC1->C1_NUM      := GetSXENum("SC1", "C1_NUM")
				SC1->C1_ITEM     := "01"
				SC1->C1_PRODUTO  := SD4->D4_COD
				SC1->C1_UM       := SB1->B1_UM
				SC1->C1_QUANT    := nQtdComprar
				SC1->C1_DATPRF   := Datavalida(dDataBase + SB1->B1_PE)
				SC1->C1_LOCAL    := "01" // SD4->D4_LOCAL
				SC1->C1_OBS      := "Solicitacao Gerada Automaticamente"
				SC1->C1_CC       := SB1->B1_CC
				SC1->C1_CONTA    := SB1->B1_CONTA
				SC1->C1_EMISSAO  := dDataBase
				SC1->C1_DESCRI   := Left(SB1->B1_DESC, 30)
				SC1->C1_SOLICIT  := SubStr(cUsuario, 7, 15)
				SC1->C1_IMPORT   := "N"
				SC1->C1_CODCOMP  := "001"
				SC1->C1_CLASS    := "1"
				SC1->C1_USER     := "000000"
				MsUnlock("SC1")
				ConfirmSX8()
				dbSelectArea("SB2")
				DbSetOrder(1)
				iF (DbSeek(xFilial("SB2")+SC1->C1_PRODUTO+SC1->C1_LOCAL))
					RecLock("SB2",.F.)
					SB2->B2_SALPEDI += SC1->C1_QUANT
					MsUnlock("SB2")
				EndIf
			EndIf
		EndIf
		DbSelectArea("SD4")
		DbSkip()
	EndDo

	// TSC - Diego Kerstner: 18/10/2018: Adicionado condição para só chamar a DLP033 quando for a sequencia 001
	// TSC - Gabriel Araujo: 24/01/2019: Retirado conforme solicitação da Joici
	//	If SC2->C2_SEQUEN = "001"
	//		U_DLP033()
	//	EndIF


	Return Nil


	**********************************************************
User Function fDifTempo(dFDtIni,sFTeIni,dFDtFin,sFTeFin)
	***************
	If dFDtIni>=dFDtFin .And. Left(sFTeIni,2)+Right(sFTeIni,2)>Left(sFTeFin,2)+Right(sFTeFin,2)
		Msgbox("Tempo Inicial Menor Que Final")
		Return("000:00")
	EndIf
	nDias := IIf(Stod(dFDtFin) > sTod(dFDtIni),Stod(dFDtFin) - sTod(dFDtIni),0)
	nNroHoras := nDias * 24
	If Left(sFTeIni,2)+Right(sFTeIni,2)>Left(sFTeFin,2)+Right(sFTeFin,2)
		nNroHoras := nNroHoras - 24
	EndIf
	nDifHr := 0
	If Left(sFTeIni,2)<>Left(sFTeFin,2)
		nDifHr := 24-Val(Left(sFTeIni,2))+Val(Left(sFTeFin,2))
		nDifHr := IIf(nDifHr>24,nDifHr-24,nDifHr)
	EndIf
	nNroHoras := nNroHoras + nDifHr
	nMinutos := 0
	If Right(sFTeIni,2)>Right(sFTeFin,2)
		nMinutos := (Val(Right(sFTeFin,2)) + 60) - Val(Right(sFTeIni,2))
		nNroHoras := nNroHoras - 1
	Else
		nMinutos := Val(Right(sFTeFin,2))  - Val(Right(sFTeIni,2))
	EndIf
	sTemRet := StrZero(nNroHoras,3)+":"+StrZero(nMinutos,2)
	Return(sTemRet)




	************************
User Function DLP200D()

	Local aArea		:= GetArea()
	Local aAreaSB1	:= SB1->(GetArea())
	Local tVolta   	:= .T.
	Local sProduto	:= GdFieldGet('C6_PRODUTO',n)
	Local nQtdVen	:= GdFieldGet('C6_QTDVEN',n)

	If M->C5_TIPO =='N'

		dbSelectArea("SB1")
		dbSetorder(1)
		If (dbSeek(xFilial("SB1")+sProduto))
			If SB1->B1_QE > 0
				nCalc := Round(nQtdVen/SB1->B1_QE,0)
				If	(nCalc*SB1->B1_QE)<>nQtdVen
					tVolta := .F.
					Msgbox('Quantidade tem que ser múltiplo da embalagem = '+transf(SB1->B1_QE,"@E 999999"))
				EndIf
			EndIf
		EndIf
	EndIf

	RestArea(aAreaSB1)
	RestArea(aArea)

	Return(tVolta)


