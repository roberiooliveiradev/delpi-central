			dc1_datprf := dDataLea
		EndIf
		RecLock('SC7',.F.)
		SC7->C7_FILENT := '01'
		SC7->C7_TRANSP := sA2_TRANSP
		SC7->C7_OBS    := sA4_NOME
		SC7->C7_DATPRF := Datavalida(dc1_datprf)
		MsUnlock('SC7')
	EndIf
	RestArea(aArea)
Return


