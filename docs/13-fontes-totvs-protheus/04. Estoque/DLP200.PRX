		If xFilial("SA5")+SC7->C7_FORNECE+SC7->C7_LOJA+SC7->C7_PRODUTO == SA5->A5_FILIAL + SA5->A5_FORNECE + SA5->A5_LOJA + SA5->A5_PRODUTO
