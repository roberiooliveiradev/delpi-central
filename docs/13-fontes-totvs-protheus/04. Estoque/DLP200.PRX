					MsUnlock("SB2")
				EndIf
				RecLock("SC7",.F.)
				SC7->C7_QUANT    := SC8->C8_QUANT
				SC7->C7_QTSEGUM  := SC8->C8_QTSEGUM
				SC7->C7_TOTAL    := SC8->C8_QUANT * SC7->C7_PRECO
				MsUnlock("SC7")
			EndIf
		EndIf

		dc1_datprf := dDataBase
