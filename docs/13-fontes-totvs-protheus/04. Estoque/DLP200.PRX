User Function DLP200x()
	Local cNumped := ""
	Local cSql := ""
	Local cEol := chr(10)

	cSql :="SELECT MAX(A.C7_NUM) C7_NUM                   " + cEol
	cSql +="FROM dbo." + RETSQLNAME("SC7") + " A (NOLOCK) " + cEol
	cSql +="WHERE LEN(C7_NUM) = 6                        " + cEol
	cSql +="      AND A.C7_FILIAL = " + ValTosql(xFilial("SC7"))

	If Select("TRB004") <> 0
		dbSelectArea("TRB004")
		dbCloseArea()
	EndIf

	TCQUERY cSql NEW ALIAS "TRB004"

	IF  TRB004->(!EOF())
		cNPedT1 :=  TRB004->C7_NUM
	ENDIF
	cNumped :=  SOMA1(cNPedT1)

Return cNumped

User Function DLP200F()

	Local cSql := ""
	Local cEol := chr(10)
	/*	sCodFor := space(6)
	dbSelectArea("SA2")
	dbSetorder(1)
	dbSeek(xFilial("SA2")+'0ZZZZZ',.T.)
	DbSkip(-1)
	nCodFor := val(SA2->A2_COD)+1
	sCodFor := StrZero(nCodFor,6) */

	cSql :="SELECT MAX(A.A2_COD) A2_COD " + cEol
	cSql +="FROM dbo." + RETSQLNAME("SA2") + " A (NOLOCK)  " + cEol
	cSql +="WHERE LEN(A2_COD) = 6   AND A2_YFGEN !='S' AND D_E_L_E_T_ = ' '   " + cEol
	cSql +="      AND  A.A2_COD NOT IN ( 'UNIAO ', 'MUNIC ', 'INPS  ', 'ESTADO', 'DPRF  ' ,'VIAGEM')"

	conout(cSql)

	If Select("TRB004") <> 0
		dbSelectArea("TRB004")
		dbCloseArea()
	EndIf

	TCQUERY cSql NEW ALIAS "TRB004"

	IF  TRB004->(!EOF())
		sCodFor :=  SOMA1(TRB004->A2_COD)
	ENDIF
Return(sCodFor)
