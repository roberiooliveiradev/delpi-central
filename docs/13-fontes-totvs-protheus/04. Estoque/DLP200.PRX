			If SC8->C8_QUANT <> SC7->C7_QUANT
				dbSelectArea("SB2")
				dbSetOrder(1)
				iF (dbSeek(xFilial("SB2")+SC7->C7_PRODUTO+SC7->C7_LOCAL))
