		EndIF
		dbSelectArea("SA5")
		dbSetorder(1)
		dbSeek(xFilial("SA5")+SC7->C7_FORNECE+SC7->C7_LOJA+SC7->C7_PRODUTO,.T.)
		If xFilial("SA5")+SC7->C7_FORNECE+SC7->C7_LOJA+SC7->C7_PRODUTO == SA5->A5_FILIAL + SA5->A5_FORNECE + SA5->A5_LOJA + SA5->A5_PRODUTO
			nA5_LEADT := SA5->A5_LEADT
		EndIf
		sA2_TRANSP := ''
		sA4_NOME   := ''
		dbSelectArea("SA2")
		dbSetOrder(1)
		iF (dbSeek(xFilial("SA2")+SC7->C7_FORNECE+SC7->C7_LOJA))
			sA2_TRANSP := SA2->A2_TRANSP
			DbSelectArea("SA4")
			DbSetOrder(1)
			DbGotop()
			If (DbSeek(xFilial("SA4")+sA2_TRANSP))
				sA4_NOME   := SA4->A4_NOME
			EndIF
		EndIf
		dbSelectArea('SC7')
		dDataLea := dDataBase + nA5_LEADT
