	**********************
User Function MA650GRPV()
	************
	If (SC6->C6_ENTREG - SC5->C5_EMISSAO) >=3
		DbSelectArea("SB1")
		DbSetOrder(1)
		iF (DbSeek(xFilial("SB1")+SC2->C2_PRODUTO)) .And. SC2->C2_SEQUEN>'001'

			nDias := 5
			//		If SB1->B1_TIPO=='PI'
			//			nDias := 4
			//		EndIf
			dData :=  SC6->C6_ENTREG - nDias
			// Não pode ter entrega para data anterior a data base!
			If dData < dDataBase
				dData := dDataBase
			EndIf
			dbSelectArea("SC2")
			RecLock("SC2",.F.)
			SC2->C2_DATPRF :=  Datavalida(dData)
			MsUnlock("SC2")

		EndIF
	EndIf
	iF dTos(SC2->C2_DATPRI) < dTos(dDataBase)
		RecLock("SC2",.F.)
		SC2->C2_DATPRI :=  Datavalida(dDataBase)
		MsUnlock("SC2")
	EndIf
Return NIL

	**********************
User Function MTA650A()
	************
	DbSelectArea("SD4")
	DbSetOrder(2)
	DbSeek(xFilial("SD4")+SC2->C2_NUM+SC2->C2_ITEM+SC2->C2_SEQUEN,.T.)
	While !Eof() .And. Alltrim(xFilial("SD4")+SC2->C2_NUM+SC2->C2_ITEM+SC2->C2_SEQUEN) == Alltrim(SD4->D4_FILIAL+SD4->D4_OP)
		RecLock("SD4",.F.)
		SD4->D4_DATA :=  SC2->C2_DATPRI
		MsUnlock("SD4")
		DbSkip()
	EndDo
Return NIL




