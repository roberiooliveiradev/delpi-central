	************************
User Function DLP200B(sProduto)
	*************
	aItem := {}
	nItem := 0


	dbSelectArea("SB1")
	dbSetorder(1)
	dbSeek(xFilial("SB1")+sProduto,.T.)
	If sProduto == SB1->B1_COD  .And. SB1->B1_ESTSEG > 0 .And. SB1->B1_TIPO<>'PA'
		dbSelectArea("SB2")
		DbSetOrder(1)
		DbSeek(xFilial("SB2")+SB1->B1_COD+SB1->B1_LOCPAD,.T.)
		iF xFilial("SB2")+SB1->B1_COD+SB1->B1_LOCPAD==SB2->B2_FILIAL+SB2->B2_COD+SB2->B2_LOCAL .And. SB1->B1_ESTSEG > SB2->B2_QATU
			nQatu := SB2->B2_QATU
			dbSelectArea("SB2")
			DbSetOrder(1)
			iF (DbSeek(xFilial("SB2")+SB1->B1_COD+"99"))
				nQatu += SB2->B2_QATU
			EndIf
			nEstSeg := SB1->B1_ESTSEG - nQatu
			nQteSc1 := 0
			dbSelectArea("SC1")
			dbSetorder(5)
			dbSeek(xFilial("SC1")+Space(6)+SB1->B1_COD,.T.)
			While xFilial("SC1")+Space(6)+SB1->B1_COD == SC1->C1_FILIAL + SC1->C1_COTACAO + SC1->C1_PRODUTO .And. !Eof()
				nQteSc1 := nQteSc1 + SC1->C1_QUANT
				DbSkip()
			EndDo
			nQteSc8 := 0
			dbSelectArea("SC8")
			dbSetorder(6)
			dbSeek(xFilial("SC8")+Space(6)+SB1->B1_COD,.T.)
			While xFilial("SC8")+Space(6)+SB1->B1_COD == SC8->C8_FILIAL + SC8->C8_NUMPED + SC8->C8_PRODUTO .And. !Eof()
				nQteSc8 := nQteSc8 + SC8->C8_QUANT
				DbSkip()
			EndDo
			nQteSc7 := 0
			dbSelectArea("SC7")
			dbSetorder(15)
			dbSeek(xFilial("SC7")+' '+SB1->B1_COD,.T.)
			While xFilial("SC7")+' '+SB1->B1_COD == SC7->C7_FILIAL + SC7->C7_ENCER + SC7->C7_PRODUTO  .And. !Eof()
				nQteSc7 := nQteSc7 + (SC7->C7_QUANT-SC7->C7_QUJE)
				DbSkip()
			EndDo
			If nQteSc1+nQteSc7+nQteSc8<nEstSeg
				nQteDif := nEstSeg - (nQteSc1+nQteSc7+nQteSc8)
				nItem := nItem + 1
				Aadd(aItem, { StrZero(nItem,2),SB1->B1_COD,SB1->B1_UM,nQteDif,dDataBase,SB1->B1_LOCPAD,"Solicitacao Gerada Automaticamente",;
					SB1->B1_CC,SB1->B1_CONTA ,dDataBase+SB1->B1_PE,Left(SB1->B1_DESC,30),Subs(cUsuario,7,15),'N','001','1','000000'})
			EndIf
		EndIf
	EndIf
	If Len(aItem) > 0
		tContinua := .T.
		While tContinua
			sNumSol := GetSxeNum("SC1", "C1_NUM")
			ConfirmSX8()
			dbSelectArea("SC1")
			dbSetorder(1)
			iF !(dbSeek(xFilial("SC1")+sNumSol))
				tContinua := .F.
			EndIf
		EndDo
		For X := 1 To Len(aItem)
			dbSelectArea("SC1")
			RecLock("SC1",.T.)
			SC1->C1_FILIAL   := xFilial("SC1")
			SC1->C1_NUM      := sNumSol
			SC1->C1_ITEM     := aItem[X,1]
			SC1->C1_PRODUTO  := aItem[X,2]
			SC1->C1_UM       := aItem[X,3]
			SC1->C1_QUANT    := aItem[X,4]
			SC1->C1_DATPRF   := aItem[X,5]
			SC1->C1_LOCAL    := '01' // aItem[X,6]
			SC1->C1_OBS      := "Solicitacao Gerada Automaticamente"
			SC1->C1_CC       := aItem[X,8]
			SC1->C1_CONTA    := aItem[X,9]
			SC1->C1_EMISSAO  := aItem[X,10]
			SC1->C1_DESCRI   := aItem[X,11]
			SC1->C1_SOLICIT  := AllTrim(aItem[X,12])
			SC1->C1_IMPORT   := aItem[X,13]
			SC1->C1_CODCOMP  := aItem[X,14]
			SC1->C1_CLASS    := aItem[X,15]
			SC1->C1_USER     := aItem[X,16]
			MsUnlock("SC1")
			dbSelectArea("SB2")
			DbSetOrder(1)
			iF (DbSeek(xFilial("SB2")+SC1->C1_PRODUTO+SC1->C1_LOCAL))
				RecLock("SB2",.F.)
				SB2->B2_SALPEDI += SC1->C1_QUANT
				MsUnlock("SB2")
			EndIf
		Next
	Endif
Return


	************************
User Function DLP200A()
	*************
	sDoc := SD3->D3_DOC
	sTm  := SD3->D3_TM
	sCC  := SD3->D3_CC
	aItem := {}
	nItem := 0
	If sTm > "499" //.And. sTm <> "502" .And. sTm <> "503"
		dbSelectArea("SD3")
		dbSetorder(2)
		dbSeek(xFilial("SD3")+sDoc,.T.)
		While xFilial("SD3")+sDoc == SD3->D3_FILIAL + SD3->D3_DOC
			If SD3->D3_LOCAL=='01'
				U_DLP200B(SD3->D3_COD)
			EndIf
			DbSelectArea("SD3")
			DbSkip()
		EndDo
	EndIf
Return Nil


