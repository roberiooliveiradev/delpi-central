	************************
User Function DESAT001() // MT170FIM()   // Fim do processo de compras automaticas
	************************
	aScs := PARAMIXB[1]
	nX   := 0
	cOldAlias:=Alias()
	For nX := 1 To Len(aScs)
		DbSelectArea("SC1")
		If DbSeek(xFilial("SC1") + aScs[nX, 2]) .AND. SC1->C1_LOCAL == "99"
			dbSelectArea("SB2")
			DbSetOrder(1)
			iF (DbSeek(xFilial("SB2")+SC1->C1_PRODUTO+SC1->C1_LOCAL))
				RecLock("SB2",.F.)
				SB2->B2_SALPEDI -= SC1->C1_QUANT
				MsUnlock("SB2")
			EndIf
			RecLock("SC1", .F.)
			DbDelete()
			MsUnlock("SC1")
		Endif
	Next
	dbSelectArea(cOldAlias)
	Return Nil


	************************
User Function DESAT002() // MT170SLD() // para cada almox. ele vem aqui a diz o saldo que encontrou, posso alterar e recalculoar
	************************
	nQuant  := PARAMIXB[1]
	cProd   := PARAMIXB[2]
	cLocal  := PARAMIXB[3]
	cOldAlias:=Alias()
	If cLocal == "01"
		DbSelectArea("SB2")
		DbSetOrder(1)
		If DbSeek(xFilial("SB2") + cProd + "99")
			nQuant += SB2->B2_QATU - SB2->B2_QEMP
		EndIf
	EndIf
	dbSelectArea(cOldAlias)
	Return (nQuant)




	***************************************************
User Function MTA130C8()  // apos importacao de itens do pedidos de compra
	***************************************************
	sFornece :=  SC8->C8_FORNECE
	sLoja    :=  SC8->C8_LOJA
	sProduto :=  SC8->C8_PRODUTO
	stipconv := ''
	nConv    := 0
	dbSelectArea("SB1")
	dbSetorder(1)
	If (dbSeek(xFilial("SB1")+SC8->C8_PRODUTO))
		stipconv := SB1->B1_TIPCONV
		nConv    := SB1->B1_CONV
	EndIf

	dbSelectArea("SA5")
	dbSetorder(1)
	dbSeek(xFilial("SA5")+sFornece+sLoja+sProduto,.T.)
	If Alltrim(xFilial("SA5")+sFornece+sLoja+sProduto) == Alltrim(SA5->A5_FILIAL + SA5->A5_FORNECE + SA5->A5_LOJA + SA5->A5_PRODUTO)
		nQtde := SC8->C8_QUANT
		nQtdeSegun := 0
		nQtdeEmb := SA5->A5_EMBAL
		If  SA5->A5_QTDMN > nQtde
			nQtde := SA5->A5_QTDMN
		EndIf
		If  nQtdeEmb <> nQtde
			If  nQtdeEmb >= nQtde
				nQtde := nQtdeEmb
			ElseIF nQtdeEmb>0
				nQtde1 := nQtdeEmb
				While nQtde1 < nQtde
					nQtde1 := nQtde1 + nQtdeEmb
				EndDo
				nQtde := nQtde1
			EndIf
		EndIf
		If stipconv == 'M'
			nQtdeSegun := nQtde * nConv
		ElseIf stipconv == 'D'
			nQtdeSegun := nQtde / nConv
		EndIf
		If nQtde <> SC8->C8_QUANT
			RecLock("SC8",.F.)
			SC8->C8_QUANT    := nQtde
			SC8->C8_QTSEGUM  := nQtdeSegun
			SC8->C8_TOTAL    := nQtde * SC8->C8_PRECO
			MsUnlock("SC8")
		EndIf
	EndIf
	Return()

	***********************
User Function MA261D3()
	*************
	dbSelectArea("SB1")
	DbSetOrder(1)
	DbSeek(xFilial("SB1") + aCols[n,1] ,.t.)
	If Left(SB1->B1_COD,1) == '9'
		Msgbox('Favor verificar saldo de materias primas ou dos empenhos.')
	EndIf
