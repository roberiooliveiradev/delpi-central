# Public runtime placeholders only. Do not put secrets here.
SERVICE_NAME=delia-api
SERVICE_VERSION=0.0.1
DELIA_ENV=development
LOG_LEVEL=INFO
DELIA_DEBUG=false
DELIA_API_HOST=0.0.0.0
DELIA_API_PORT=8000

# JWT validation (shared delpi_auth.jwt_validator — fail-closed)
KEYCLOAK_ISSUER=https://keycloak.example/auth/realms/delpi
KEYCLOAK_AUDIENCE=delpi-central
# Optional explicit JWKS; otherwise discovery via KEYCLOAK_URL/REALM
# KEYCLOAK_JWKS_URL=
# KEYCLOAK_URL=http://keycloak:8080/auth
# KEYCLOAK_REALM=delpi
# JWT_ALGORITHMS=RS256

# Core effective platform access (GET /me). No service-account substitution.
CORE_API_URL=http://core-api:8000
# DELPI_AUTH_CORE_API_URL=http://core-api:8000
DELIA_CORE_TIMEOUT_SECONDS=5.0

# §6.130 provider-neutral orchestration — governed OpenAPI sources.
# api-delpi source activates only with all three set; GET-only
# invocation, undeclared operations fail closed.
# DELIA_OPENAPI_DELPI_ENABLED=true
# DELIA_OPENAPI_DELPI_BASE_URL=http://api-delpi:8000
# DELIA_OPENAPI_DELPI_DECLARATIONS_PATH=/app/config/openapi_declarations.delpi.json
# DELIA_OPENAPI_TIMEOUT_SECONDS=15
