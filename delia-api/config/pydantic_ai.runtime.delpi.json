{
  "resource_id": "delia.pydantic_ai.runtime",
  "kind": "pydantic_ai_runtime",
  "schema_version": 1,
  "owner": "delia-api",
  "default_profile": "local_ollama",
  "profiles": {
    "local_ollama": {
      "model": {
        "provider": "openai_compatible",
        "model_name": "qwen3:8b"
      },
      "generation": {
        "max_output_tokens": null
      },
      "agent": {
        "request_limit": 12,
        "tool_calls_limit": 8,
        "retries": 2,
        "llm_call_max_attempts": 3
      },
      "context": {
        "effective_context_window_tokens": 16384,
        "prior_turns_limit": 4
      },
      "budgets": {
        "provider_call_timeout_seconds": 90.0,
        "model_stage_timeout_seconds": 120.0,
        "interaction_call_timeout_seconds": 30.0,
        "turn_budget_seconds": 300.0,
        "interaction_total_budget_seconds": 300.0,
        "max_governed_attempts": 2
      },
      "tool_results": {
        "max_projection_chars": 6000
      },
      "observability": {
        "record_model_id": true,
        "record_usage": true,
        "record_config_fingerprint": true
      }
    },
    "openrouter_kimi": {
