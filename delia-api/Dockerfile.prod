# delia-api — PROD
# Platform Flask convention: gunicorn (same class as supplies-api).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY delia-api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY shared /shared
RUN pip install --no-cache-dir -e "/shared[flask]"

COPY delia-api /app

ENV SERVICE_NAME=delia-api
ENV DELIA_ENV=production
ENV DELIA_DEBUG=false
ENV DELIA_API_HOST=0.0.0.0
ENV DELIA_API_PORT=8000
ENV FLASK_APP=app.main:app

EXPOSE 8000

CMD ["sh", "-c", "find /app -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true; exec gunicorn -b 0.0.0.0:8000 --workers 2 --threads 4 --timeout 60 app.main:app"]
