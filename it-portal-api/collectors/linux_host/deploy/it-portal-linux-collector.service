[Unit]
Description=Portal de TI — coletor Linux de inventário automático (E4.S1)
Documentation=file:///opt/delpi/it-portal-collector/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=delpi-collector
Group=delpi-collector
# Sem elevação; Docker só se o operador conceder grupo docker em decisão separada.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Env obrigatório: sem o arquivo o systemd falha de forma explícita (sem "-").
EnvironmentFile=/etc/delpi/it-portal-linux-collector.env
Environment=PYTHONPATH=/opt/delpi/it-portal-collector
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/delpi/it-portal-collector
# Código/venv root-owned: o serviço só grava no state dir.
ReadWritePaths=/var/lib/it-portal-collector
ReadOnlyPaths=/opt/delpi/it-portal-collector
# Timeout limitado para diagnóstico + token + POST.
TimeoutStartSec=120
# flock evita overlap se o timer disparar com execução anterior ainda ativa.
ExecStart=/usr/bin/flock -n /var/lib/it-portal-collector/collector.lock \
  /opt/delpi/it-portal-collector/bin/run-collector submit
Nice=10
# Sucesso esperado 0; flock -n retorna 1 quando o lock está ocupado (overlap).
SuccessExitStatus=0

[Install]
# Serviço oneshot acionado pelo timer. Não habilitar diretamente em produção
# sem o runbook; o timer é a unidade de ativação.
