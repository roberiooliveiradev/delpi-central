[Unit]
Description=Portal de TI — agendamento horário do coletor Linux (E4.S1)
Documentation=file:///opt/delpi/it-portal-collector/README.md
# Sem Requires= no serviço oneshot: o timer dispara só no calendário (OnCalendar).

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=5m
Unit=it-portal-linux-collector.service

[Install]
WantedBy=timers.target
