[Unit]
Description=Portal de TI — agendamento horário do coletor Linux (E4.S1)
Requires=it-portal-linux-collector.service
Documentation=file:///opt/delpi/it-portal-collector/README.md

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=5m
Unit=it-portal-linux-collector.service

[Install]
WantedBy=timers.target
