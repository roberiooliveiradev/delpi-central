# Copiar para /etc/delpi/it-portal-linux-collector.env (root:delpi-collector, 0640).
# NÃO versionar o arquivo real com segredos.

# Ingestão via gateway local do srv-api (evita Cloudflare na borda pública).
IT_PORTAL_COLLECTOR_BASE_URL=http://127.0.0.1/apps/it-portal-api

# UUID do cadastro srv-api no Portal de TI (não inventar hostname paralelo).
IT_PORTAL_COLLECTOR_SERVER_ID=459fd1b8-643f-493d-9911-0ff7aaf91424

# Token Keycloak — sempre HTTPS. Não usar nome Docker "keycloak" no host.
S2S_TOKEN_URL=https://minhadelpi.com.br/auth/realms/delpi/protocol/openid-connect/token
S2S_CLIENT_ID=it-portal-host-collector
S2S_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
S2S_SCOPE=it-portal.observations.ingest

# Opcional: só se o gateway local exigir Host virtual. Vazio = sem override.
# IT_PORTAL_COLLECTOR_HTTP_HOST=minhadelpi.com.br
