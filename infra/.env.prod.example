# =============================================================================
# DELPI CENTRAL — produção
# =============================================================================
# Uso:
#   cp infra/.env.prod.example infra/.env
#   docker compose -f infra/docker-compose.yml build
#   docker compose -f infra/docker-compose.yml up -d
#
# Troque todos os CHANGE_ME. Não commitar o .env real.
# Build Docling na imagem prod: INSTALL_VISION_EXTRAS=true no build (ver README-ambiente).
# =============================================================================

# --- Geral ---
# URL HTTPS pública do gateway (issuer JWT e redirects)
PUBLIC_BASE_URL=https://CHANGE_ME.dominio.com.br
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
# Obrigatório em produção: sem este valor as APIs tratam o ambiente como
# desenvolvimento e incluem http://localhost nas origens CORS permitidas.
API_DELPI_ENV=production
API_DELPI_PORT=8000

# --- Keycloak ---
KEYCLOAK_REALM=delpi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_strong
# KC24 hostname v1 (contrato vigente de produção): KC_HOSTNAME é só o
# host público; o issuer https://<host>/auth/realms/delpi é composto por
# KC_HOSTNAME + KC_HTTP_RELATIVE_PATH. Strict HTTPS força https no issuer.
KC_HOSTNAME=CHANGE_ME.dominio.com.br
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_HTTPS=true
KC_HTTP_RELATIVE_PATH=/auth
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
# DÉLIA MCP delegated exchange (KC24 legacy V1 — feature Preview):
# ambas obrigatórias; admin-fine-grained-authz expõe os endpoints
# management/permissions usados pelo provisionador.
# KC_FEATURES=token-exchange,admin-fine-grained-authz

# --- Postgres Core ---
POSTGRES_CORE_DB=delpi_core
POSTGRES_CORE_USER=delpi
POSTGRES_CORE_PASSWORD=CHANGE_ME_core_db_strong

# --- Postgres Keycloak ---
POSTGRES_KC_DB=keycloak
POSTGRES_KC_USER=keycloak
POSTGRES_KC_PASSWORD=CHANGE_ME_kc_db_strong

# --- Core API ---
DB_HOST=postgres-core
DB_PORT=5432
DB_NAME=delpi_core
DB_USER=delpi
DB_PASSWORD=CHANGE_ME_core_db_strong
SECRET_KEY=CHANGE_ME_flask_secret_production_min_32_chars
INITIAL_SUPERADMIN_EMAIL=admin@empresa.com.br
INITIAL_SUPERADMIN_NAME=Administrador
CORE_API_INTEGRATIONS_SERVICE_TOKEN=CHANGE_ME_optional_service_token

KEYCLOAK_ADMIN_CLIENT_ID=delpi-core-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_kc_client_secret
KEYCLOAK_ADMIN_REALM=delpi
KEYCLOAK_ADMIN_URL=http://keycloak:8080

KEYCLOAK_AUDIENCE=delpi-central
KEYCLOAK_ISSUER=${PUBLIC_BASE_URL}/auth/realms/${KEYCLOAK_REALM}
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
JWT_ALGORITHMS=RS256

# --- Portal (build-time; rebuild portal após mudar) ---
VITE_KC_URL=${PUBLIC_BASE_URL}/auth
VITE_KC_REALM=delpi
VITE_KC_CLIENT_ID=delpi-central
VITE_KC_REDIRECT_URI=${PUBLIC_BASE_URL}/

# --- Postgres Plugins ---
PLUGINS_DB_HOST=postgres-plugins
PLUGINS_DB_PORT=5432
PLUGINS_DB_NAME=plugins_hub
PLUGINS_DB_USER=plugins_user
PLUGINS_DB_PASSWORD=CHANGE_ME_plugins_db_strong
PLUGINS_DB_CONNECT_TIMEOUT=5
PLUGINS_DB_SSLMODE=prefer
# Pool por processo — somatório ≪ max_connections do postgres-plugins (~100).
# api-delpi default 10; commercial / transformometro / SI / maintenance default 5.
PLUGINS_DB_POOL_MAX_SIZE=10
PLUGINS_DB_POOL_ACQUIRE_TIMEOUT=30
# PLUGINS_DB_APPLICATION_NAME=api-delpi-plugins

# Migrations no boot (produção) — api-delpi (quality, scheduling, …) e strategic-indicators-api
RUN_PLUGINS_MIGRATIONS_ON_STARTUP=true
SI_RUN_MIGRATIONS_ON_STARTUP=true

# --- Build imagem minha-delpi-ai-api (argumento Docker, não runtime) ---
# false = só requirements.txt + Tesseract (recomendado)
# true  = + requirements-vision.txt (Docling) — imagem muito maior
INSTALL_VISION_EXTRAS=false

# ============================
# IA — Minha DELPI Chat (Ollama, CPU sem GPU)
# ============================
# Servidor típico: 15 GB RAM · 4 vCPU · sem GPU
#
# Após alterar OLLAMA_MODEL ou variáveis CHAT_*:
#   docker exec delpi-ollama ollama pull qwen2.5:3b
#   docker exec delpi-ollama ollama pull bge-m3
#   cd ~/projetos/delpi-central
#   docker compose -f infra/docker-compose.yml --env-file infra/.env --profile optional-heavy up -d --force-recreate ollama searxng minha-delpi-ai-api
#
# Conferir no container:
#   docker exec delpi-minha-delpi-ai-api printenv | grep -E '^(CHAT_WEB_SEARCH_ENABLED|CHAT_TOOL_ROUTER|CHAT_RAG_HYBRID|OLLAMA_MODEL)='
#
# Nota: no servidor o arquivo é infra/.env (não existe .env.prod).
# Valores abaixo ligam todas as ferramentas do chat; para economizar CPU/RAM,
# desligue só o que não usar (ex.: CHAT_AGENTIC_LOOP_ENABLED=false).

# --- Provider ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# --- Modelo de chat (CPU: 3b equilíbrio; 7b só com RAM sobrando) ---
# Modelos Ollama necessários:
#   ollama pull qwen2.5:1.5b && ollama pull qwen2.5:3b && ollama pull bge-m3
#   ollama pull qwen2.5vl:7b   # visão (fallback VLM em documentos)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
# Janela de contexto default do daemon Ollama (modelos sem num_ctx baked
# no Modelfile). PARIDADE RECOMENDADA: context.effective_context_window_tokens
# em delia-api/config/pydantic_ai.runtime.delpi.json deve igualar o ctx efetivo
# do modelo DÉLIA (esta var ou num_ctx do modelo).
OLLAMA_CONTEXT_LENGTH=4096

# --- Geração ---
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1536
# Perfil opcional (sobrescreve tokens/ctx se LLM_MAX_TOKENS e OLLAMA_NUM_CTX não estiverem fixos):
# CHAT_LLM_LATENCY_PROFILE=operational_cpu

# --- Modos no composer (rápida / normal / pensador) — GET /chat/response-modes ---
CHAT_RESPONSE_MODES_ENABLED=true
CHAT_RESPONSE_MODE_FAST_MODEL=qwen2.5:1.5b
CHAT_RESPONSE_MODE_FAST_MAX_TOKENS=384
CHAT_RESPONSE_MODE_FAST_NUM_CTX=1536
CHAT_RESPONSE_MODE_THINKER_MAX_TOKENS=1536
CHAT_RESPONSE_MODE_THINKER_NUM_CTX=4096
# CHAT_RESPONSE_MODE_THINKER_MODEL=qwen2.5:7b

# --- Embeddings (RAG) ---
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120

# --- RAG (calibração CPU operacional — ver docs/roadmap/rag-context-min-score-calibracao.md) ---
# 0.40 reduz ruído sem esvaziar contexto em perguntas meta; ajuste via admin ragContextMinScore.
RAG_CONTEXT_MIN_SCORE=0.40
RAG_IDENTITY_QUESTION_MIN_SCORE=0.22
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_CHARS=12000
# Híbrido/rerank ligados por padrão (compose alinhado). Para economizar CPU: false.
CHAT_RAG_HYBRID_ENABLED=true
CHAT_RAG_PREFER_KEYWORD_SEARCH=true
CHAT_RAG_RERANK_ENABLED=true
CHAT_RAG_FTS_ENABLED=true
CHAT_HISTORY_SUMMARY_ENABLED=true
EXTERNAL_ACTION_SEMANTIC_RANK_ENABLED=true

# --- Visão / OCR (Dockerfile.prod + Tesseract + VLM Ollama) ---
# auto = texto nativo + Tesseract; se fraco, usa qwen2.5vl:7b (AUTO_VLM_FALLBACK)
# ollama_vlm = sempre VLM (mais lento; use só se priorizar qualidade em todo PDF)
CHAT_DOCUMENT_VISION_ENABLED=true
CHAT_DOCUMENT_VISION_BACKEND=auto
CHAT_DOCUMENT_VISION_AUTO_VLM_FALLBACK=true
CHAT_DOCUMENT_VISION_AUTO_WITH_DRAWING=true
CHAT_DOCUMENT_VISION_MAX_PAGES=10
CHAT_DOCUMENT_VISION_DPI=200
CHAT_DOCUMENT_VISION_MIN_LEGIBLE_CHARS=40
CHAT_DOCUMENT_VISION_TIMEOUT_SECONDS=120
CHAT_DOCUMENT_VISION_MAX_CHARS=8000
CHAT_DOCUMENT_VISION_STAMP_CROP_ENABLED=true
CHAT_DOCUMENT_VISION_TESSERACT_LANG=por+eng
CHAT_DOCUMENT_VISION_OLLAMA_MODEL=qwen2.5vl:7b
CHAT_DOCUMENT_VISION_OLLAMA_BASE_URL=
CHAT_DOCUMENT_VISION_PADDLE_USE_GPU=false

# --- Anexos ---
# Pasta no host (fora do repositório) — volumes em docker-compose.yml
DELPI_DATA_HOST_DIR=${HOME}/.delpi
CHAT_ATTACHMENT_STORAGE_PATH=/data/delpi/chat-attachments
CHAT_SOURCE_STORAGE_PATH=/data/delpi/chat-sources
CHAT_ATTACHMENT_IMAGE_OCR_ENABLED=true
CHAT_ATTACHMENT_IMAGE_OCR_MAX_CHARS=4000

# --- Corretor composer (Playbook 14) ---
CHAT_TYPING_CORRECTION_ENABLED=true
CHAT_TYPING_CORRECTION_FUZZY_ENABLED=true

# --- LanguageTool — preflight na skill «corrija este texto» ---
# Consumo EXCLUSIVO da minha-delpi-ai-api (Chat AI); nenhum outro serviço usa.
# Serviço roda no profile `optional-heavy` — exige `--profile optional-heavy`
# no up/recreate. Requer ~2,5 GB RAM adicionais. Se desligado, a correção
# textual continua só com LLM.
CHAT_TEXT_CORRECTION_SPELL_CHECK_ENABLED=true
CHAT_LANGUAGETOOL_BASE_URL=http://languagetool:8010
CHAT_LANGUAGETOOL_TIMEOUT_SECONDS=4
CHAT_LANGUAGETOOL_LANGUAGE=pt-BR

# --- UX / latência ---
CHAT_PERSIST_BEFORE_PLAYBACK=true
CHAT_SESSION_TITLE_LLM_ENABLED=true
CHAT_FAST_PATH_ENABLED=true
CHAT_FAST_PATH_MAX_CHARS=48
CHAT_OPERATIONAL_FAST_PATH_ENABLED=true
CHAT_EXTERNAL_ACTION_DIRECT_RESPONSE_ENABLED=true
CHAT_DIRECT_RESPONSE_STREAM_CHUNK_CHARS=4
CHAT_DIRECT_RESPONSE_STREAM_DELAY_MS=0
CHAT_ASSISTANT_IDENTITY_DIRECT_ENABLED=true
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_MULTI_ACTION_ENABLED=true
CHAT_PREFER_API_EXTERNA_PROVIDER=true
# Dialeto SQL padrão (Protheus/TOTVS → sqlserver)
CHAT_DEFAULT_SQL_DIALECT=sqlserver
CHAT_DEFAULT_SQL_AUTHORING_SKILL=true
CHAT_DEFAULT_COMPANY_KNOWLEDGE_SKILL=true

# --- Ferramentas do pipeline ---
CHAT_TOOL_ROUTER_ENABLED=true
CHAT_AGENTIC_LOOP_ENABLED=true
CHAT_AGENTIC_LOOP_MAX_STEPS=2
CHAT_AGENTIC_CATALOG_MAX_ACTIONS=12
CHAT_PAGINATION_AUTO_FETCH_ENABLED=true
# Piloto LLM nativo
CHAT_NATIVE_TOOL_CALLING_ENABLED=true

# --- Pesquisa web (SearXNG) — consumo EXCLUSIVO da minha-delpi-ai-api ---
# SearXNG roda no profile `optional-heavy`; provider auto resolve
# tavily → serper → bing → searxng → duckduckgo, então o SearXNG interno só
# é chamado sem chaves externas configuradas ou com PROVIDER=searxng.
CHAT_WEB_SEARCH_ENABLED=true
CHAT_WEB_SEARCH_PROVIDER=auto
CHAT_WEB_SEARCH_MAX_RESULTS=5
CHAT_WEB_SEARCH_TIMEOUT_SECONDS=12
CHAT_WEB_SEARCH_RETRY_EN=true
CHAT_WEB_SEARCH_DIRECT_RESPONSE_ENABLED=true
CHAT_WEB_SEARCH_SYNTHESIS_ENABLED=true
CHAT_WEB_SEARCH_SYNTHESIS_MIN_RESULTS=2
CHAT_WEB_SEARCH_SEARXNG_BASE_URL=http://searxng:8080
CHAT_WEB_SEARCH_SEARXNG_LANGUAGE=pt-BR
CHAT_WEB_SEARCH_SEARXNG_CATEGORIES=general
# Opcional (se não usar SearXNG interno):
CHAT_WEB_SEARCH_TAVILY_API_KEY=
CHAT_WEB_SEARCH_SERPER_API_KEY=
CHAT_WEB_SEARCH_BING_API_KEY=
# URL pública do próprio serviço searxng (só é lida quando ele sobe).
SEARXNG_BASE_URL=http://localhost:8088/

# --- Humanização de colunas (R16) ---
CHAT_PRESENTATION_COLUMN_LABEL_DISCOVERY_ENABLED=true
CHAT_PRESENTATION_COLUMN_LABEL_WEB_SEARCH_ENABLED=true
CHAT_PRESENTATION_COLUMN_LABEL_WEB_MAX_QUERIES=2

# --- Aprendizagem contínua (Minha DELPI AI API) — ligado por padrão no Docker ---
CHAT_LEARNING_ENABLED=true
CHAT_LEARNING_APPLY_VOCABULARY=true
CHAT_LEARNING_CAPTURE_FROM_FEEDBACK=true
CHAT_LEARNING_CAPTURE_FROM_TURN=true
CHAT_LEARNING_AUTO_APPROVE_ENABLED=true
CHAT_LEARNING_AUTO_APPROVE_MIN_CONFIDENCE=0.95
CHAT_LEARNING_VOCABULARY_MAX_RULES=500
CHAT_USER_MEMORY_ENABLED=true
CHAT_USER_MEMORY_CAPTURE=true
CHAT_USER_MEMORY_APPLY=true
CHAT_USER_MEMORY_MAX_ITEMS=20
CHAT_USER_MEMORY_RAG_INDEX=true
CHAT_LEARNING_GLOSSARY_RETRIEVAL=true
CHAT_LEARNING_GLOSSARY_CAPTURE=true
CHAT_LEARNING_TERM_CONFIRMATION_ENABLED=true
# Pesquisa web de significado: custo/latência — defina false se não usar
CHAT_LEARNING_GLOSSARY_WEB_MEANING=true
CHAT_LEARNING_GLOSSARY_MAX_TERMS=300
CHAT_LEARNING_GLOSSARY_RAG_INDEX=true
CHAT_LEARNING_EVALUATION_ENABLED=true
CHAT_LEARNING_EVALUATION_BLOCK_PROMOTION=true
CHAT_LEARNING_EVALUATION_CAPTURE_FROM_FEEDBACK=true
CHAT_LEARNING_FINE_TUNING_ENABLED=true
CHAT_LEARNING_FINE_TUNING_CAPTURE_POSITIVE_FEEDBACK=true
CHAT_LEARNING_FINE_TUNING_BASE_MODEL=qwen2.5:3b
CHAT_LEARNING_FINE_TUNING_OLLAMA_CREATE_ENABLED=true

# vLLM — não usar neste host (sem GPU)
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# VLLM_API_KEY=CHANGE_ME_vllm_api_key
# VLLM_TIMEOUT_SECONDS=300

# --- API DELPI (TOTVS) ---
TOTVS_DB_HOST=CHANGE_ME_sql_server_host
TOTVS_DB_PORT=1433
TOTVS_DB_USER=CHANGE_ME
TOTVS_DB_PASSWORD=CHANGE_ME
TOTVS_DB_DATABASE=DELPI

# --- Intranet / Protheus REST (read-only) ---
# Protheus USR/PSW come from PARAMETROS_MINHADELPI — do NOT put them here.
# Host/user/password fall back to TOTVS_DB_* / DB_* when unset.
INTRANET_DB_DATABASE=IntranetDelpiDev
INTRANET_PARAMS_TABLE=PARAMETROS_MINHADELPI
INTRANET_PARAMS_KEY_COLUMN=PARAMETRO
INTRANET_PARAMS_VALUE_COLUMN=CONTEUDO
INTRANET_PARAMS_AMBIENTE=1
PROTHEUS_REST_TIMEOUT_SECONDS=30
# Expected write target for this runtime — productive REST (base DELPI).
# Writes fail closed if PARAMETROS resolves to any other URL.
# Origin only: PARAMETROS_CONTEUDO is varchar(30), so URL_REST@1 holds
# http://192.168.1.231:8061 (25c) and the /restall prefix lives in PATH_*.
PROTHEUS_REST_EXPECTED_BASE_URL=http://192.168.1.231:8061
# Supplier write gates — keep false until TOTVS homologation + PO release.
# See api-delpi/docs/integrations/protheus-rest-supplier-write-handoff.md
PROTHEUS_SUPPLIER_CREATE_ENABLED=false
PROTHEUS_SUPPLIER_UPDATE_ENABLED=false

# --- Planilhas Google ---
GOOGLE_SHEETS_TIMEOUT=10
FINANCIAL_EBITDA_SHEET_ID=
FINANCIAL_EBITDA_SHEET_GID=
FINANCIAL_FIXED_COST_SHEET_ID=
FINANCIAL_FIXED_COST_SHEET_GID=
FINANCIAL_RECEIVABLES_SHEET_ID=
FINANCIAL_RECEIVABLES_SHEET_GID=

# Portal Financeiro — NF-e de entrada no Questor Zen (token só no backend)
FIN_QUESTOR_BASE_URL=https://alliance.app.questorpublico.com.br
FIN_QUESTOR_API_TOKEN=
FIN_QUESTOR_COMPANY_01_ID=5a85a32c4b541917008b2977
FIN_QUESTOR_COMPANY_02_ID=5a85a32c4b541917008b2979
FIN_QUESTOR_TIMEOUT_SECONDS=30
FIN_QUESTOR_DANFE_MAX_BYTES=10485760

# --- Redis (recomendado em prod para presença/uso) ---
REDIS_URL=
# Senha do delpi-redis (requirepass). Obrigatória se o serviço delpi-redis subir.
DELPI_REDIS_PASSWORD=CHANGE_ME

# --- Microsoft Graph — Canal de Denúncia (api-delpi) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_SENDER=canal-denuncia@delpi.com.br
GRAPH_MAIL_RECIPIENT=ouvidoria@delpi.com.br
# Delpi Reports — Graph dedicado (não reutilizar canal-denúncia)
GRAPH_REPORTS_TENANT_ID=
GRAPH_REPORTS_CLIENT_ID=
GRAPH_REPORTS_CLIENT_SECRET=
GRAPH_REPORTS_MAIL_SENDER=minhadelpi@delpi.com.br
REPORTS_MAIL_BATCH_SIZE=40
REPORTS_RUN_ARTIFACTS_DIR=/app/data/reports-runs
GRAPH_HTTP_TIMEOUT_SECONDS=15

# --- Transformômetro + Chat Minha Delpi — Kimi / OpenRouter ---
# Doc atas: transformometro-api/docs/meeting-minutes-kimi.md
# Doc chat: minha-delpi-ai-api/docs/operations/tutorial-conectar-llm-externo.md § Kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://openrouter.ai/api/v1
KIMI_MODEL=moonshotai/kimi-k3
# KIMI_TIMEOUT_SECONDS=180
#
# DÉLIA API — provider real openai_compatible (vocabulário próprio DELIA_LLM_*).
# O runtime da DÉLIA consome SOMENTE DELIA_LLM_*; compose não referencia KIMI_*.
# No .env de produção, materialize os valores ou use aliases dotenv, ex.:
# DELIA_LLM_BASE_URL=${KIMI_BASE_URL} (o segredo continua só na fonte KIMI_*).
# sem chave = endpoint /interaction/turns falha fechado 503:
# DELIA_LLM_BASE_URL=
# DELIA_LLM_API_KEY=
# Janela de entrada efetiva que o runtime realmente honra (tokens) — valor
# medido do deployment (ctx efetivo do Ollama/limite do provider), nunca a
# capacidade nominal do modelo. Deve igualar OLLAMA_CONTEXT_LENGTH do
# daemon (default 4096) ou o num_ctx baked no Modelfile do modelo — os
# dois vivem em envs distintos; divergência declarada>efetiva reabre o
# truncamento silencioso. Vazio = pre-call budget desativado.
#
# DÉLIA MCP federation — identidade delegada por usuário (PROD).
# Modelo: Portal subject token -> troca de token via cliente confidencial
# `delia-api` -> token resource-bound por especialista (mcp:tools).
# Pré-requisito: provisionador infra/scripts/keycloak-prod-delia-mcp-provision.sh
# executado contra Keycloak 24 (estratégia KC24_LEGACY; ver runbook).
# O segredo NUNCA entra neste arquivo exemplo; em produção ele é instalado
# pelo provisionador (--install-secret-to) ou manualmente no .env real.
# DELIA_TOKEN_EXCHANGE_URL — default derivado de KEYCLOAK_URL+REALM; override só
#   se o endpoint de token divergir:
# DELIA_TOKEN_EXCHANGE_URL=
DELIA_EXCHANGE_CLIENT_ID=delia-api
DELIA_EXCHANGE_CLIENT_SECRET=CHANGE_ME_OR_SECRET_STORE
# DELIA_EXCHANGE_TIMEOUT_SECONDS=10
# DELIA_MCP_DELEGATED_TOKEN_TTL_SECONDS=120
# Especialistas aprovados (defaults do compose já apontam interno):
# DELIA_MCP_DAVI_BASE_URL=
# DELIA_MCP_TEO_BASE_URL=
# DELIA_MCP_VISTA_BASE_URL=
# Host header override para FastMCP transport security (DNS-rebinding):
# os specialists aceitam apenas hosts de PUBLIC_BASE_URL; os hostnames
# docker internos NAO sao permitidos. PROD (R3): host publico fixo.
DELIA_MCP_DAVI_HOST_HEADER=minhadelpi.com.br
DELIA_MCP_TEO_HOST_HEADER=minhadelpi.com.br
DELIA_MCP_VISTA_HOST_HEADER=minhadelpi.com.br
DELIA_MCP_DAVI_ENABLED=true
DELIA_MCP_TEO_ENABLED=true
DELIA_MCP_VISTA_ENABLED=true
# C4 bounded read switches — OFF por default; habilitar somente após o
# smoke de token exchange + tools/list do runbook. Cada flag liga
# exatamente a sua tupla autorizada; PREPARE/ACT permanecem bloqueados.
DELIA_C4_DAVI_PRODUCT_READ_ENABLED=false
DELIA_C4_TEO_DASHBOARD_ANALYZE_ENABLED=false
# LEGADO REMOVIDO: DELIA_MCP_DAVI_USER_TOKEN / _TEO_ / _VISTA_ foram
# SUPERSEDED — o runtime ignora essas variáveis; não reintroduzir.
#
# CRI — Conversational Response Intelligence (docs CRI 73–87).
# Comportamento conversacional desejado em produção: ON por padrão.
# Vazio/ausente = OFF fail-closed (baseline); "true" = CRI ativo quando
# os recursos governados carregam (instructions v2, presentation v3);
# recursos ausentes/inválidos degradam para baseline — nunca altera
# fatos, seleção, autorização nem orçamento de turno.
# Rollback operacional: remover/valor vazio + recreate do serviço.
# Gate de ativação: ver relatório 87 da trilha C3/CRI.
DELIA_RESPONSE_INTELLIGENCE_ENABLED=true
#
# Chat IA — mesmo token/base/modelo das atas (sem duplicar LLM_TEXT_*):
# LLM_PROVIDER=openai_compatible
# (opcional) override só se o chat precisar de outro endpoint/modelo:
# LLM_TEXT_BASE_URL=
# LLM_TEXT_MODEL=
# LLM_TEXT_API_KEY=
# LLM_TEXT_TIMEOUT_SECONDS=180
# Com openai_compatible, modos usam KIMI_MODEL + CLOUD_* / generationLimitsCloud.
# Defaults Compose: Rápida 2048 · Normal 4096 · Pensador 8192.
# NÃO confie em CHAT_RESPONSE_MODE_*_MAX_TOKENS (Compose Ollama 256) — são ignorados.
# MAX_CONTEXT_CHARS=24000

# --- Desenhos PDF do FILESERVER (cockpit do operador — production-control-api) ---
# Montar o share no host antes (CIFS/SMB) e apontar aqui; o container recebe /drawing-pdfs read-only.
PC_DRAWING_PDF_HOST_PATH=/mnt/fileserver/desenhos
PC_DRAWING_PDF_LIBRARY_DIR=/drawing-pdfs

# MES Fase 1 — parada automatica por ausencia de golpes (0 = desabilitado)
PC_MES_AUTO_DOWNTIME_SECONDS=120
# MES Fase 2.7 — threshold dinamico por ciclo congelado (somente posto manual
# com tempo padrao complete; qualquer outro caso usa o threshold acima).
# Manter false em producao ate validacao controlada em um CT.
PC_MES_DYNAMIC_AUTO_DOWNTIME_ENABLED=false
# Piso do threshold dinamico (default: igual ao legado — nunca reduz sozinho)
PC_MES_AUTO_DOWNTIME_MIN_SECONDS=120
# Multiplicador do ciclo padrao para posto manual (ceil)
PC_MES_AUTO_DOWNTIME_MANUAL_CYCLE_MULTIPLIER=3
# MES autonomo por CT (PC-MES-CT-AUTONOMOUS-DOWNTIME) — detecta producao/
# parada em CT sensorizado MESMO sem OP aberta. Threshold = o de cima
# (PC_MES_AUTO_DOWNTIME_SECONDS). Ativo por padrao em todos os postos
# com vinculo pulse_counter; para homologar por CT, troque * por lista
# "CT-35,CT-41". Sem baseline de pulsos, nenhuma parada e inventada.
PC_MES_CT_AUTONOMOUS_ENABLED=true
PC_MES_CT_AUTONOMOUS_WORK_CENTERS=*

# Gestão de Paradas — Etapa 6 (insights + alertas gerenciais).
# Alertas DESLIGADOS por padrão: habilitar somente após aprovar os
# parâmetros industriais (RQ-6.6/AC). Sem parâmetro = regra inativa.
PC_MES_DOWNTIME_ALERTS_ENABLED=false
PC_MES_DOWNTIME_ALERT_INTERVAL_SECONDS=300
PC_MES_DOWNTIME_EFFECTIVENESS_WINDOW_DAYS=30
PC_MES_DOWNTIME_TELEMETRY_STALE_MINUTES=30
# Parâmetros aprovados pelo processo industrial (exemplos):
# PC_MES_DOWNTIME_CRITICAL_OPEN_SECONDS=7200
# PC_MES_DOWNTIME_CRITICAL_RECURRENCE_OCCURRENCES=3
# PC_MES_DOWNTIME_UNCLASSIFIED_ALERT_THRESHOLD=5
# PC_MES_DOWNTIME_OVERDUE_ACTION_DAYS=7

