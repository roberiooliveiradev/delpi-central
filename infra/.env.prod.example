# --- S2S individual (Keycloak Client Credentials) -----------------------
# Identidade técnica exclusiva por serviço; substitui gradualmente o token
# interno compartilhado. Contrato: docs/11-padroes-de-desenvolvimento/
#   padrao-autenticacao-s2s-individual.md + ADR-010 (supplies/adr).
# Solicitante (ex.: supplies-api):
# S2S_TOKEN_URL=https://<keycloak>/realms/delpi/protocol/openid-connect/token
# S2S_CLIENT_ID=supplies-api
# S2S_CLIENT_SECRET=<secret do cliente confidencial no Keycloak>
# Escopo vazio quando os scopes requeridos são atribuídos como default
# client scope no Keycloak (ver infra/scripts/keycloak_s2s_supplies_scope.py);
# use S2S_SCOPE apenas para scopes optional não-default.
# S2S_SCOPE=
# S2S_TIMEOUT_SECONDS=10
# Worker gunicorn do supplies-api deve exceder DELPI_API_TIMEOUT (default 60):
# GUNICORN_TIMEOUT_SECONDS=90
# Verificador (ex.: api-delpi):
# S2S_AUDIENCE=api-delpi
# S2S_ALLOWED_CLIENTS=supplies-api

