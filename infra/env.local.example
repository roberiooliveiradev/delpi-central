# Copie para infra/.env.local (não versionado):
#   cp infra/env.local.example infra/.env.local
#
# Depois ajuste usuário/senha do Portal dev e obtenha token:
#   export TOKEN="$(bash infra/scripts/get-dev-token.sh)"

DEV_BASE_URL=http://localhost
DEV_KC_REALM=delpi
DEV_KC_CLIENT_ID=delpi-central

DEV_PORTAL_USERNAME=ti_delpi
DEV_PORTAL_PASSWORD=CHANGE_ME

# Biblioteca PDF de desenhos (FILESERVER) — api-delpi dev
# WSL: monte X: antes — ex.: sudo mkdir -p /mnt/x && sudo mount -t drvfs X: /mnt/x
# Windows (Docker Desktop): use o caminho WSL equivalente ou //host.mnt/...
DRAWING_PDF_FILESERVER_HOST_PATH=/mnt/x/DESENHOS DELPI EM PDF

# Anexos de chat / fontes de projeto — pasta no host (fora do repositório)
DELPI_DATA_HOST_DIR=${HOME}/.delpi
CHAT_ATTACHMENT_STORAGE_PATH=/data/delpi/chat-attachments
CHAT_SOURCE_STORAGE_PATH=/data/delpi/chat-sources
