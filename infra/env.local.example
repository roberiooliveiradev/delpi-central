# Copie para infra/.env.local (não versionado):
#   cp infra/env.local.example infra/.env.local
#
# Depois ajuste usuário/senha do Portal dev e obtenha token:
#   export TOKEN="$(bash infra/scripts/get-dev-token.sh)"

DEV_BASE_URL=http://localhost
DEV_KC_REALM=delpi
DEV_KC_CLIENT_ID=delpi-central

DEV_PORTAL_USERNAME=ti_delpi
DEV_PORTAL_PASSWORD=CHANGE_ME

# Biblioteca PDF de desenhos (FILESERVER) — api-delpi dev
# WSL: monte X: antes — ex.: sudo mkdir -p /mnt/x && sudo mount -t drvfs X: /mnt/x
# Windows (Docker Desktop): use o caminho WSL equivalente ou //host.mnt/...
DRAWING_PDF_FILESERVER_HOST_PATH=/mnt/x/DESENHOS DELPI EM PDF

# Anexos de chat / fontes de projeto — pasta no host (fora do repositório)
DELPI_DATA_HOST_DIR=${HOME}/.delpi
CHAT_ATTACHMENT_STORAGE_PATH=/data/delpi/chat-attachments
CHAT_SOURCE_STORAGE_PATH=/data/delpi/chat-sources

# Evidências PAC + anexos NC Auditoria 5S (api-delpi) — montados em docker-compose
# Produção (srv-api): DELPI_DATA_HOST_DIR=/var/lib/delpi (criar com sudo mkdir -p)
PAC_EVIDENCE_UPLOAD_DIR=/app/data/pac-evidences
KAIZEN_EVIDENCE_UPLOAD_DIR=/app/data/kaizen-evidences
GUIAS_PROCEDIMENTOS_UPLOAD_DIR=/app/data/guias-procedimentos
TM_REVISION_EVIDENCE_UPLOAD_DIR=/app/data/revisao-evidencias
TM_PROCESSO_ARQUIVO_UPLOAD_DIR=/app/data/processo-arquivos
TM_BACKUP_PACKAGE_MAX_BYTES=524288000
AUDIT_5S_NC_UPLOAD_DIR=/app/data/audit-5s-nc
AUDIT_5S_RESPONSE_UPLOAD_DIR=/app/data/audit-5s-responses
# Notificações in-app ao designar responsável da NC (sino do portal)
AUDIT_5S_NOTIFICATIONS_ENABLED=true
SCHEDULING_NOTIFICATIONS_ENABLED=true
SCHEDULING_APPROVAL_TTL_HOURS=24
# Etiquetas da Qualidade (api-delpi) — QR persistentes das inspeções
QUALITY_LABELS_QR_DIR=/app/data/quality-labels/qr
# Etiquetas da Qualidade — assinatura do inspetor (PNG) e certificados (PDF)
QUALITY_LABELS_SIGNATURE_DIR=/app/data/quality-labels/signatures
QUALITY_LABELS_CERTIFICATE_DIR=/app/data/quality-labels/certificates

# Customer Experience (visitantes) — foto + QR persistentes (customer-experience-api)
CX_RUN_MIGRATIONS_ON_STARTUP=true
CUSTOMER_EXPERIENCE_PHOTO_UPLOAD_DIR=/app/data/customer-experience/photos
TV_DASHBOARD_MEDIA_UPLOAD_DIR=/app/data/tv-dashboard/media
TV_DATA_ROUTES_PATH=/app/data/tv-dashboard/catalog/tv_data_routes.json
TV_OPENAPI_SYNC_ON_STARTUP=true
# api-delpi → notifica chat/TV no startup (requer API_DELPI_INTERNAL_SERVICE_TOKEN)
# Por padrão atualiza os schemas OpenAPI (actions) + embeddings no chat e catálogo TV.
OPENAPI_CONSUMER_NOTIFY_ON_STARTUP=true
OPENAPI_CONSUMER_CHAT_SKIP_EMBEDDINGS=false
TV_DASHBOARD_NOTIFICATIONS_ENABLED=true
CUSTOMER_EXPERIENCE_QR_DIR=/app/data/customer-experience/qr
# Imagens de layout dos formulários (fundo, ícones por página)
CUSTOMER_EXPERIENCE_FORM_IMAGE_UPLOAD_DIR=/app/data/customer-experience/form-images
# URL pública base usada no QR (produção: https://minhadelpi.com.br)
PUBLIC_BASE_URL=http://localhost
