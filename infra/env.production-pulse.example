PRODUCTION_PULSE_API_ROOT_PATH=/apps/production-pulse-api
PRODUCTION_PULSE_RUN_MIGRATIONS_ON_STARTUP=true

# Dev (network_mode: host) — porta no host; gateway nginx.dev.conf usa 8025
PRODUCTION_PULSE_API_PORT=8025

# Scheduler / online-offline (ADR-002)
PP_POLL_MAX_CONCURRENT=10
PP_ONLINE_GRACE_MIN_SECONDS=60
PP_ONLINE_GRACE_MAX_SECONDS=600
PP_ONLINE_GRACE_MULTIPLIER=2

# Host network (dev): Postgres plugins exposto em localhost:5433
# PRODUCTION_PULSE_PLUGINS_DB_HOST=127.0.0.1
# PRODUCTION_PULSE_PLUGINS_DB_PORT=5433
# PRODUCTION_PULSE_CORE_API_URL=http://127.0.0.1:80/core-api

# Gateway local (host network) → api-delpi via nginx
# PRODUCTION_PULSE_DELPI_API_URL=http://127.0.0.1/apps/api-delpi
# PP_WORK_CENTER_CACHE_TTL_SECONDS=300
