CIPA_API_ROOT_PATH=/apps/cipa-api
CIPA_RUN_MIGRATIONS_ON_STARTUP=true
CIPA_SIGNATURE_UPLOAD_DIR=/app/data/cipa/signatures
CIPA_ATTACHMENT_UPLOAD_DIR=/app/data/cipa/attachments
CIPA_PDF_UPLOAD_DIR=/app/data/cipa/pdfs
CIPA_SIPAT_QR_DIR=/app/data/cipa/sipat-qr
CIPA_PUBLIC_SIPAT_PATH=/p/cipa/sipat
CIPA_PORTAL_NOTIFICATIONS_ENABLED=true
CIPA_MAIL_ENABLED=true
CIPA_ATA_SIGN_INVITE_TTL_DAYS=30
CIPA_PUBLIC_SIGN_PATH=/p/cipa/sign
# S2S Core — directory (e-mail dos signatários) + notificações do portal
# Deve ser o mesmo valor de CORE_API_INTEGRATIONS_SERVICE_TOKEN do core-api
# CORE_API_INTEGRATIONS_SERVICE_TOKEN=
# Message Trace — requer permissão Azure ExchangeMessageTrace.Read.All no app Graph
CIPA_SIGN_INVITE_MAIL_TRACE_ENABLED=false
CIPA_SIGN_INVITE_MAIL_TRACE_INTERVAL_MINUTES=15
CIPA_SIGN_INVITE_MAIL_TRACE_BATCH_LIMIT=50
PUBLIC_BASE_URL=http://localhost
# Outlook/Graph — reutiliza Delpi Reports; override opcional CIPA_GRAPH_*
# GRAPH_REPORTS_TENANT_ID=
# GRAPH_REPORTS_CLIENT_ID=
# GRAPH_REPORTS_CLIENT_SECRET=
# GRAPH_REPORTS_MAIL_SENDER=minhadelpi@delpi.com.br
# GRAPH_HTTP_TIMEOUT_SECONDS=15
