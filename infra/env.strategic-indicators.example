# Strategic Indicators API — variáveis opcionais (copiar trechos para infra/.env)
# O docker-compose já define padrões via ${VAR:-default}; sobrescreva aqui se necessário.

SI_SNAPSHOT_CACHE_TTL_SECONDS=600
SI_WARMUP_ON_STARTUP=true
SI_WARMUP_TRENDS_MONTHS=6
TOTVS_POOL_ENABLED=true
TOTVS_POOL_MAX_SIZE=8
SI_PERIOD_SCORES_ENABLED=true
