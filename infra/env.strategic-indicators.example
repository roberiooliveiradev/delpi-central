# Strategic Indicators API — variáveis opcionais (copiar trechos para infra/.env)
# O docker-compose já define padrões via ${VAR:-default}; sobrescreva aqui se necessário.

SI_SNAPSHOT_CACHE_TTL_SECONDS=300
SI_WARMUP_ON_STARTUP=false
SI_WARMUP_TRENDS_MONTHS=6
TOTVS_POOL_ENABLED=true
TOTVS_POOL_MAX_SIZE=8
SI_PERIOD_SCORES_ENABLED=true
SI_PERIOD_SCORES_REFRESH_ENABLED=true
SI_PERIOD_SCORES_REFRESH_INTERVAL_SECONDS=300
SI_PERIOD_SCORES_REFRESH_TRENDS_MONTHS=3
SI_PERIOD_SCORES_REFRESH_PER_DEPARTMENT=true
SI_PERIOD_SCORES_REFRESH_INCLUDE_PREVIOUS=true
# Vazio = consolidado + filiais 01 e 02 (padrão). Ex.: "01,02" só filiais.
SI_PERIOD_SCORES_REFRESH_BRANCHES=
SI_CALCULATION_SNAPSHOTS_ENABLED=true
SI_PERSIST_CALCULATION_SNAPSHOTS_ON_READ=false
SI_RUN_MIGRATIONS_ON_STARTUP=true
