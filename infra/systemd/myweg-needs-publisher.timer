[Unit]
Description=Timer MyWEG Necessidades — publica pendências às 06:00/15/30/45 America/Sao_Paulo
Documentation=file:docs/12-roadmap-e-evolucao/production-control/MYWEG-NEEDS-LINUX-PUBLISHER.md

[Timer]
# Origem MyWEG agenda envio às 05:00 America/Sao_Paulo.
# Quatro tentativas matinais explícitas no fuso SP (host srv-api usa Etc/UTC).
OnCalendar=*-*-* 06:00:00 America/Sao_Paulo
OnCalendar=*-*-* 06:15:00 America/Sao_Paulo
OnCalendar=*-*-* 06:30:00 America/Sao_Paulo
OnCalendar=*-*-* 06:45:00 America/Sao_Paulo
# Persistent=true: após reinício, systemd pode disparar catch-up fora da janela
# matinal (recuperação excepcional; não é o horário nominal do agendamento).
Persistent=true
RandomizedDelaySec=0
AccuracySec=1min
Unit=myweg-needs-publisher.service

[Install]
WantedBy=timers.target
