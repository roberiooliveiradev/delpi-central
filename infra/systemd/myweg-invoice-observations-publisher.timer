[Unit]
Description=Timer MyWEG NF Emitidas — publica pendências fiscais às 06:50 America/Sao_Paulo
Documentation=file:///home/operador/projetos/delpi-central/docs/12-roadmap-e-evolucao/production-control/MYWEG-INVOICE-OBSERVATIONS-E4.md

[Timer]
# Uma execução diária às 06:50 SP, após a janela matinal de necessidades (06:00–06:45).
# Persistent=false: se o host estiver desligado às 06:50, não há catch-up no mesmo dia;
# pendências permanecem para a próxima execução agendada.
OnCalendar=*-*-* 06:50:00 America/Sao_Paulo
Persistent=false
RandomizedDelaySec=0
AccuracySec=1s
Unit=myweg-invoice-observations-publisher.service

[Install]
WantedBy=timers.target
