use_default_settings: true

general:
  debug: false
  instance_name: "DELPI SearXNG"

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "pt-BR"
  formats:
    - html
    - json

server:
  bind_address: "0.0.0.0"
  port: 8080
  secret_key: "delpi-dev-searxng-secret-change-me"
  limiter: false
  image_proxy: false
