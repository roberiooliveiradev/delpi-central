# =============================================================================
# NOTA: variáveis compartilhadas (DBs, Keycloak, chat, plugins) estão nas fontes
# canônicas: infra/.env.dev.example e infra/.env.prod.example. Este arquivo é
# apenas o overlay HML consumido por scripts/hml-compose.sh.
# =============================================================================
# Homologação delpi-hml — placeholders. Não é segredo e não é produção.
#
# No checkout /home/operador/projetos-teste/delpi-central:
#   cp infra/env.hml.example infra/.env.hml
#   editar somente infra/.env.hml (gitignored)
#
# Não copiar infra/.env, infra/.env.prod nem credenciais do checkout de produção.
# O Compose de homologação força TOTVS, schedulers, e-mail, Protheus, Portal RH
# e notificações externas a permanecerem desligados, mesmo se este arquivo mudar.

COMPOSE_PROJECT_NAME=delpi-hml

TZ=America/Sao_Paulo
LOG_LEVEL=INFO
API_DELPI_ENV=homologation
API_DELPI_PORT=8000

# --- Entrada HTTP na LAN (fase atual) ---
# Sobrescrever em .env.hml conforme o inventário da VM. Não usar o domínio
# de produção nem fixar estes valores em código de aplicação.
# Exemplo validado em srv-api: host 192.168.1.237, porta 18080 livre.
DELPI_HML_BIND_ADDR=192.168.1.237
DELPI_HML_PUBLIC_HOST=192.168.1.237
DELPI_HML_PUBLIC_PORT=18080
DELPI_HML_PUBLIC_ORIGIN=http://192.168.1.237:18080
PUBLIC_BASE_URL=http://192.168.1.237:18080
DELPI_HML_DATA_HOST_DIR=./hml-data
#
# --- HTTPS interno (NÃO ativado; requer autorização explícita) ---
# Motivo: keycloak-js PKCE S256 exige crypto.subtle → Secure Context.
# HTTP em IP privado (ex. 192.168.1.237) NÃO é Secure Context nos Chromium.
# Quando autorizado:
#   DELPI_HML_TLS_PORT=18443
#   DELPI_HML_PUBLIC_ORIGIN=https://192.168.1.237:18443
#   PUBLIC_BASE_URL=https://192.168.1.237:18443
#   KEYCLOAK_ISSUER=https://192.168.1.237:18443/auth/realms/delpi
#   VITE_KC_URL=https://192.168.1.237:18443/auth
#   VITE_KC_REDIRECT_URI=https://192.168.1.237:18443/
#   KC_HOSTNAME_PORT=18443
#   KC_HOSTNAME_STRICT_HTTPS=true
# Certs: infra/scripts/hml-tls-prepare.sh → infra/hml-certs/ (fora do Git).

# --- Keycloak de homologação (realm vazio até bootstrap HML) ---
# Imagem alinhada à produção: quay.io/keycloak/keycloak:24.0
# Digest produtivo observado: sha256:f8ade94c1d0ad2f2fa7734a455fee5392764f402c43ca35e9af6bf63a2541dc9
# Banco, admin, clients e sessões são exclusivos de HML.
KEYCLOAK_REALM=delpi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_hml_keycloak_admin
KC_HOSTNAME=192.168.1.237
KC_HOSTNAME_PORT=18080
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_RELATIVE_PATH=/auth
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_FEATURES=token-exchange,admin-fine-grained-authz
KEYCLOAK_ADMIN_CLIENT_ID=delpi-core-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_hml_kc_client_secret
KEYCLOAK_ADMIN_REALM=delpi
# URL interna entre containers (não é o issuer do navegador).
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_AUDIENCE=delpi-central
# Issuer público = origem HTTP da homologação (gateway futuro em :18080/auth).
KEYCLOAK_ISSUER=http://192.168.1.237:18080/auth/realms/delpi
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/delpi/protocol/openid-connect/certs
JWT_ALGORITHMS=RS256

VITE_KC_URL=http://192.168.1.237:18080/auth
VITE_KC_REALM=delpi
VITE_KC_CLIENT_ID=delpi-central
VITE_KC_REDIRECT_URI=http://192.168.1.237:18080/
# Sem front-channel logout para filhos produtivos no bundle HML.
VITE_FRONT_CHANNEL_LOGOUT_URLS=__none__

# Usuário de teste HML (somente bootstrap; sem privilégios admin).
HML_TEST_USERNAME=hml-tester
HML_TEST_PASSWORD=CHANGE_ME_hml_test_user

# --- PostgreSQL exclusivo de homologação (nomes de serviço na rede delpi-hml) ---
POSTGRES_CORE_DB=delpi_core
POSTGRES_CORE_USER=delpi
POSTGRES_CORE_PASSWORD=CHANGE_ME_hml_core_db
DB_HOST=postgres-core
DB_PORT=5432
DB_NAME=delpi_core
DB_USER=delpi
DB_PASSWORD=CHANGE_ME_hml_core_db
SECRET_KEY=CHANGE_ME_hml_flask_secret_min_32_chars
INITIAL_SUPERADMIN_EMAIL=admin@hml.invalid
INITIAL_SUPERADMIN_NAME=Administrador Homologacao

POSTGRES_KC_DB=keycloak
POSTGRES_KC_USER=keycloak
POSTGRES_KC_PASSWORD=CHANGE_ME_hml_kc_db

PLUGINS_DB_HOST=postgres-plugins
PLUGINS_DB_PORT=5432
PLUGINS_DB_NAME=plugins_hub
PLUGINS_DB_USER=plugins_user
PLUGINS_DB_PASSWORD=CHANGE_ME_hml_plugins_db
PLUGINS_DB_CONNECT_TIMEOUT=5
PLUGINS_DB_SSLMODE=prefer

DELPI_REDIS_PASSWORD=CHANGE_ME_hml_redis
REDIS_URL=redis://:CHANGE_ME_hml_redis@delpi-redis:6379/0

API_DELPI_JWT_SECRET=CHANGE_ME_hml_jwt_secret_min_32_chars
API_DELPI_INTERNAL_SERVICE_TOKEN=CHANGE_ME_hml_internal_token
CORE_API_INTEGRATIONS_SERVICE_TOKEN=CHANGE_ME_hml_core_integrations_token

# Sentinela. O Compose substitui estes valores por totvs-disabled.hml.invalid.
TOTVS_DB_HOST=totvs-disabled.hml.invalid
TOTVS_DB_PORT=1433
TOTVS_DB_USER=hml_disabled
TOTVS_DB_PASSWORD=hml_disabled
TOTVS_DB_DATABASE=DISABLED

PORTAL_RH_DB_HOST=
PORTAL_RH_DB_PORT=
PORTAL_RH_DB_NAME=
PORTAL_RH_DB_USER=
PORTAL_RH_DB_PASSWORD=
PORTAL_RH_DB_CONNECT_TIMEOUT=2
PORTAL_RH_DB_SSLMODE=prefer

# Integrações externas desligadas. O Compose também fixa false/vazio.
NOTIFICATIONS_DISPATCH_SCHEDULER_ENABLED=false
CORE_NOTIFICATION_MAIL_ENABLED=false
OPENAPI_CONSUMER_NOTIFY_ENABLED=false
OPENAPI_CONSUMER_NOTIFY_ON_STARTUP=false
PROTHEUS_SUPPLIER_CREATE_ENABLED=false
PROTHEUS_SUPPLIER_UPDATE_ENABLED=false
PC_MES_CT_AUTONOMOUS_ENABLED=false
PC_MES_DOWNTIME_ALERTS_ENABLED=false
# Migrations de apps ficam desligadas até etapa autorizada (bancos vazios/init only).
PC_RUN_MIGRATIONS_ON_STARTUP=false
RUN_PLUGINS_MIGRATIONS_ON_STARTUP=false
