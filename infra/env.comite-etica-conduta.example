# Variáveis do serviço comite-etica-conduta-api (referência / append em .env)

CEC_API_ROOT_PATH=/apps/comite-etica-conduta-api
CEC_RUN_MIGRATIONS_ON_STARTUP=true
CEC_PORTAL_NOTIFICATIONS_ENABLED=true
CEC_MAIL_ENABLED=true
CEC_SIGNATURE_UPLOAD_DIR=/app/data/comite-etica-conduta/signatures
CEC_ATTACHMENT_UPLOAD_DIR=/app/data/comite-etica-conduta/attachments
CEC_PDF_UPLOAD_DIR=/app/data/comite-etica-conduta/pdfs
CEC_SIGNATURE_MAX_BYTES=3145728
CEC_ATTACHMENT_MAX_BYTES=15728640

# Core S2S (mesmo padrão CIPA/LNF)
CORE_API_URL=http://core-api:8000
CORE_API_SERVICE_TOKEN=

# Outlook/Graph — reutiliza Delpi Reports; override opcional CEC_GRAPH_*
# GRAPH_REPORTS_TENANT_ID=
# GRAPH_REPORTS_CLIENT_ID=
# GRAPH_REPORTS_CLIENT_SECRET=
# GRAPH_REPORTS_MAIL_SENDER=minhadelpi@delpi.com.br
