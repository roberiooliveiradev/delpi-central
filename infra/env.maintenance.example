# Manutenção API — variáveis opcionais (copiar trechos para infra/.env)
# O docker-compose definirá padrões via ${VAR:-default} quando o serviço existir.

MAINT_API_ROOT_PATH=/apps/maintenance-api
MAINT_RUN_MIGRATIONS_ON_STARTUP=true

# Integração TOTVS (via api-delpi — não SQL Server direto)
DELPI_API_URL=http://delpi-api-delpi:8000
DELPI_API_TIMEOUT=30

# Postgres plugins (compartilhado com outros módulos)
# PLUGINS_DB_HOST=postgres-plugins
# PLUGINS_DB_PORT=5432
# PLUGINS_DB_NAME=delpi_plugins
# PLUGINS_DB_USER=
# PLUGINS_DB_PASSWORD=
