S2S_TOKEN_URL=http://keycloak:8080/realms/delpi/protocol/openid-connect/token

# --- Core ---
CORE_API_EFFECTIVE_ACCESS_SERVICE_TOKEN=CHANGE_ME
CORE_API_SERVICE_TOKEN=
CORE_API_URL=http://core-api:8000
CORE_USER_AVATAR_UPLOAD_DIR=/app/data/core-user-avatars

# --- Delia ---
DELIA_C4_DAVI_PRODUCT_READ_ENABLED=false
