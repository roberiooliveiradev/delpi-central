# =============================================================================
# DELPI CENTRAL — desenvolvimento local
# =============================================================================
# Uso:
#   cp infra/.env.dev.example infra/.env
#   docker compose -f infra/docker-compose.dev.yml --profile chat up -d
#
# Compose lê infra/.env automaticamente (-f infra/docker-compose.dev.yml).
# Docling já vem na imagem dev (Dockerfile.dev).
# =============================================================================

# --- Geral ---
# URL pública vista pelo browser (gateway nginx :80)
# Se o Cursor/Windows ocupar a porta 80: GATEWAY_HOST_PORT=9080 e
# PUBLIC_BASE_URL=http://localhost:9080
PUBLIC_BASE_URL=http://localhost
# GATEWAY_HOST_PORT=80
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# --- Keycloak (identidade) ---
KEYCLOAK_REALM=delpi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin
KC_HOSTNAME=localhost
KC_HTTP_RELATIVE_PATH=/auth
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
# Local = HTTP. Deixe KC_PROXY_HEADERS vazio: xforwarded + Keycloak 26 força cookie Secure
# e quebra OAuth em http://localhost (browser descarta cookie).
KC_PROXY=none
KC_PROXY_HEADERS=

# --- Postgres Core (ERP central) ---
POSTGRES_CORE_DB=delpi_core
POSTGRES_CORE_USER=delpi
POSTGRES_CORE_PASSWORD=CHANGE_ME_core_db

# --- Postgres Keycloak ---
POSTGRES_KC_DB=keycloak
POSTGRES_KC_USER=keycloak
POSTGRES_KC_PASSWORD=CHANGE_ME_kc_db

# --- Core API ---
DB_HOST=postgres-core
DB_PORT=5432
DB_NAME=delpi_core
DB_USER=delpi
DB_PASSWORD=CHANGE_ME_core_db
# Must match POSTGRES_CORE_PASSWORD (same DB user). Special chars are OK after quote_plus in core-api.
SECRET_KEY=CHANGE_ME_flask_secret_min_32_chars
INITIAL_SUPERADMIN_EMAIL=admin@example.com
INITIAL_SUPERADMIN_NAME=Admin Dev
CORE_API_INTEGRATIONS_SERVICE_TOKEN=

# Cliente admin Keycloak (Core API provisiona usuários)
KEYCLOAK_ADMIN_CLIENT_ID=delpi-core-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_kc_client_secret
KEYCLOAK_ADMIN_REALM=delpi
KEYCLOAK_ADMIN_URL=http://keycloak:8080

# JWT — issuer público (browser); JWKS interno (rede Docker)
KEYCLOAK_AUDIENCE=delpi-central
KEYCLOAK_ISSUER=${PUBLIC_BASE_URL}/auth/realms/${KEYCLOAK_REALM}
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
JWT_ALGORITHMS=RS256

# --- Portal (build-time Vite) ---
VITE_KC_URL=${PUBLIC_BASE_URL}/auth
VITE_KC_REALM=delpi
VITE_KC_CLIENT_ID=delpi-central
VITE_KC_REDIRECT_URI=${PUBLIC_BASE_URL}/

# --- Postgres Plugins (chat, conhecimento, plugins) ---
PLUGINS_DB_HOST=postgres-plugins
PLUGINS_DB_PORT=5432
PLUGINS_DB_NAME=plugins_hub
PLUGINS_DB_USER=plugins_user
PLUGINS_DB_PASSWORD=CHANGE_ME_plugins_db
PLUGINS_DB_CONNECT_TIMEOUT=5
PLUGINS_DB_SSLMODE=prefer
# Pool por processo (api-delpi default 10; commercial/TM/SI/maintenance default 5).
# Somatório dos pools dos apps ≪ max_connections do postgres-plugins (~100).
PLUGINS_DB_POOL_MAX_SIZE=10
PLUGINS_DB_POOL_ACQUIRE_TIMEOUT=30
# application_name no PG (diagnóstico em pg_stat_activity)
# PLUGINS_DB_APPLICATION_NAME=api-delpi-plugins
RUN_PLUGINS_MIGRATIONS_ON_STARTUP=true

# --- BPMN Modeler API — usa plugins_hub compartilhado (schema bpmn_modeler) ---
# Reaproveita PLUGINS_DB_* acima; migrations rodam no startup da API.
BPMN_RUN_MIGRATIONS_ON_STARTUP=true

# --- Minha DELPI AI API — LLM ---
# Provider: ollama | vllm (prod costuma ollama; dev igual)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=768
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
# Janela de contexto default do daemon Ollama (modelos sem num_ctx baked).
# Paridade recomendada com context.effective_context_window_tokens em delia-api/config/pydantic_ai.runtime.delpi.json quando DÉLIA ativa.
OLLAMA_CONTEXT_LENGTH=4096

CHAT_RESPONSE_MODES_ENABLED=true
CHAT_RESPONSE_MODE_FAST_MODEL=qwen2.5:1.5b
CHAT_RESPONSE_MODE_FAST_MAX_TOKENS=384
CHAT_RESPONSE_MODE_FAST_NUM_CTX=1536
CHAT_RESPONSE_MODE_THINKER_MAX_TOKENS=1536
CHAT_RESPONSE_MODE_THINKER_NUM_CTX=4096

# --- Minha DELPI AI API — embeddings / RAG ---
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARS=9000
RAG_CONTEXT_MIN_SCORE=0.35
RAG_IDENTITY_QUESTION_MIN_SCORE=0.22
CHAT_RAG_HYBRID_ENABLED=true
CHAT_RAG_PREFER_KEYWORD_SEARCH=true
CHAT_RAG_RERANK_ENABLED=true
CHAT_RAG_FTS_ENABLED=true
CHAT_HISTORY_SUMMARY_ENABLED=true
EXTERNAL_ACTION_SEMANTIC_RANK_ENABLED=true

# --- Minha DELPI AI API — visão / OCR (Onda 13) ---
# Imagem dev: Tesseract via Dockerfile.dev. Docling só com profile vision.
CHAT_DOCUMENT_VISION_ENABLED=true
CHAT_DOCUMENT_VISION_BACKEND=auto
CHAT_DOCUMENT_VISION_AUTO_VLM_FALLBACK=true
CHAT_DOCUMENT_VISION_AUTO_WITH_DRAWING=true
CHAT_DOCUMENT_VISION_MAX_PAGES=10
CHAT_DOCUMENT_VISION_DPI=200
CHAT_DOCUMENT_VISION_MIN_LEGIBLE_CHARS=40
CHAT_DOCUMENT_VISION_TIMEOUT_SECONDS=120
CHAT_DOCUMENT_VISION_MAX_CHARS=8000
CHAT_DOCUMENT_VISION_STAMP_CROP_ENABLED=true
CHAT_DOCUMENT_VISION_TESSERACT_LANG=por+eng
# VLM local (backend ollama_vlm); vazio = usa OLLAMA_BASE_URL
CHAT_DOCUMENT_VISION_OLLAMA_MODEL=qwen2.5vl:7b
CHAT_DOCUMENT_VISION_OLLAMA_BASE_URL=
CHAT_DOCUMENT_VISION_PADDLE_USE_GPU=false

# --- Minha DELPI AI API — anexos e chat ---
# Pasta no host (fora do repositório) montada nos volumes do compose
DELPI_DATA_HOST_DIR=${HOME}/.delpi
CHAT_ATTACHMENT_STORAGE_PATH=/data/delpi/chat-attachments
CHAT_SOURCE_STORAGE_PATH=/data/delpi/chat-sources
CHAT_ATTACHMENT_IMAGE_OCR_ENABLED=true
CHAT_ATTACHMENT_IMAGE_OCR_MAX_CHARS=4000
CHAT_FAST_PATH_ENABLED=true
CHAT_FAST_PATH_MAX_CHARS=48
CHAT_TOOL_ROUTER_ENABLED=true
CHAT_AGENTIC_LOOP_ENABLED=true
CHAT_AGENTIC_LOOP_MAX_STEPS=2
CHAT_AGENTIC_CATALOG_MAX_ACTIONS=12
CHAT_MULTI_ACTION_ENABLED=true
CHAT_PAGINATION_AUTO_FETCH_ENABLED=true
CHAT_DEFAULT_SQL_AUTHORING_SKILL=true
CHAT_DEFAULT_COMPANY_KNOWLEDGE_SKILL=true
CHAT_DEFAULT_SQL_DIALECT=sqlserver
# Piloto LLM nativo
CHAT_NATIVE_TOOL_CALLING_ENABLED=true
CHAT_ASSISTANT_IDENTITY_DIRECT_ENABLED=true
CHAT_OPERATIONAL_FAST_PATH_ENABLED=true
CHAT_EXTERNAL_ACTION_DIRECT_RESPONSE_ENABLED=true
CHAT_PREFER_API_EXTERNA_PROVIDER=true
CHAT_SESSION_TITLE_LLM_ENABLED=true
CHAT_HISTORY_MAX_MESSAGES=12
# --- Pesquisa web + correção textual (consumo EXCLUSIVO da minha-delpi-ai-api) ---
# Os serviços searxng e languagetool NÃO têm outro consumidor: só o Chat AI
# (minha-delpi-ai-api) fala com eles. Nenhum plugin, gateway ou delia-api usa.
# Ambos rodam no profile `optional-heavy` — não sobem no `up -d` comum.
# Para usar em dev: ligue as flags abaixo E suba com `--profile optional-heavy`.
# Provider auto = tavily → serper → bing → searxng → duckduckgo (searxng só
# entra sem chaves externas ou com CHAT_WEB_SEARCH_PROVIDER=searxng).
CHAT_WEB_SEARCH_ENABLED=false
CHAT_WEB_SEARCH_PROVIDER=auto
CHAT_WEB_SEARCH_MAX_RESULTS=5
CHAT_WEB_SEARCH_TIMEOUT_SECONDS=8
CHAT_WEB_SEARCH_SEARXNG_BASE_URL=http://searxng:8080
CHAT_WEB_SEARCH_SEARXNG_LANGUAGE=pt-BR
CHAT_WEB_SEARCH_TAVILY_API_KEY=
CHAT_WEB_SEARCH_SERPER_API_KEY=
CHAT_WEB_SEARCH_BING_API_KEY=

# R16 — rótulos de coluna: catálogo JSON primeiro; LLM/web só se true (prod)
CHAT_PRESENTATION_COLUMN_LABEL_DISCOVERY_ENABLED=true
CHAT_PRESENTATION_COLUMN_LABEL_WEB_SEARCH_ENABLED=false
CHAT_PRESENTATION_COLUMN_LABEL_WEB_MAX_QUERIES=2

# URL pública do próprio serviço searxng (só é lida quando ele sobe).
SEARXNG_BASE_URL=http://localhost:8088/

# LanguageTool — preflight na skill de correção textual (só minha-delpi-ai-api).
# ~2,5 GB RAM; desligado, a correção textual continua funcionando só com LLM.
CHAT_TEXT_CORRECTION_SPELL_CHECK_ENABLED=false
CHAT_LANGUAGETOOL_BASE_URL=http://languagetool:8010
CHAT_LANGUAGETOOL_TIMEOUT_SECONDS=4
CHAT_LANGUAGETOOL_LANGUAGE=pt-BR

# --- Aprendizagem contínua (Minha DELPI AI API) — ligado por padrão no Docker ---
# Defina false em qualquer flag para desligar só aquele comportamento.
CHAT_LEARNING_ENABLED=true
CHAT_TYPING_CORRECTION_ENABLED=true
CHAT_TYPING_CORRECTION_FUZZY_ENABLED=true
CHAT_LEARNING_APPLY_VOCABULARY=true
CHAT_LEARNING_CAPTURE_FROM_FEEDBACK=true
CHAT_LEARNING_CAPTURE_FROM_TURN=true
CHAT_LEARNING_AUTO_APPROVE_ENABLED=true
CHAT_LEARNING_AUTO_APPROVE_MIN_CONFIDENCE=0.95
CHAT_LEARNING_VOCABULARY_MAX_RULES=500
CHAT_USER_MEMORY_ENABLED=true
CHAT_USER_MEMORY_CAPTURE=true
CHAT_USER_MEMORY_APPLY=true
CHAT_USER_MEMORY_MAX_ITEMS=20
CHAT_USER_MEMORY_RAG_INDEX=true
CHAT_LEARNING_GLOSSARY_RETRIEVAL=true
CHAT_LEARNING_GLOSSARY_CAPTURE=true
CHAT_LEARNING_TERM_CONFIRMATION_ENABLED=true
CHAT_LEARNING_GLOSSARY_WEB_MEANING=true
CHAT_LEARNING_GLOSSARY_MAX_TERMS=300
CHAT_LEARNING_GLOSSARY_RAG_INDEX=true
CHAT_LEARNING_EVALUATION_ENABLED=true
CHAT_LEARNING_EVALUATION_BLOCK_PROMOTION=true
CHAT_LEARNING_EVALUATION_CAPTURE_FROM_FEEDBACK=true
CHAT_LEARNING_FINE_TUNING_ENABLED=true
CHAT_LEARNING_FINE_TUNING_CAPTURE_POSITIVE_FEEDBACK=true
CHAT_LEARNING_FINE_TUNING_BASE_MODEL=qwen2.5:3b
CHAT_LEARNING_FINE_TUNING_OLLAMA_CREATE_ENABLED=true

# --- API DELPI (TOTVS / legado) ---
TOTVS_DB_HOST=CHANGE_ME_sql_server_host
TOTVS_DB_PORT=1433
TOTVS_DB_USER=CHANGE_ME
TOTVS_DB_PASSWORD=CHANGE_ME
TOTVS_DB_DATABASE=DELPI

# --- Intranet / Protheus REST (read-only) ---
# Protheus USR/PSW come from PARAMETROS_MINHADELPI — do NOT put them here.
# Host/user/password fall back to TOTVS_DB_* / DB_* when unset.
INTRANET_DB_DATABASE=IntranetDelpiDev
INTRANET_PARAMS_TABLE=PARAMETROS_MINHADELPI
INTRANET_PARAMS_KEY_COLUMN=PARAMETRO
INTRANET_PARAMS_VALUE_COLUMN=CONTEUDO
INTRANET_PARAMS_AMBIENTE=2
PROTHEUS_REST_TIMEOUT_SECONDS=30
# Expected write target for this runtime — homologation REST (DELPI_TST01).
# Writes fail closed if PARAMETROS resolves to any other URL.
PROTHEUS_REST_EXPECTED_BASE_URL=http://192.168.1.233:8701/rest

API_DELPI_PORT=8000
API_DELPI_ENV=development
API_DELPI_JWT_SECRET=CHANGE_ME_api_delpi_jwt_secret

# --- Portal RH (PostgreSQL; opcional — indicadores/RH) ---
PORTAL_RH_DB_HOST=
PORTAL_RH_DB_PORT=5432
PORTAL_RH_DB_NAME=portal_rh
PORTAL_RH_DB_USER=
PORTAL_RH_DB_PASSWORD=
PORTAL_RH_DB_CONNECT_TIMEOUT=5
PORTAL_RH_DB_SSLMODE=prefer

# Portal RH API — diretório oficial de colaboradores (S2S; C2).
# Production Control resolve matrícula → identidade. NUNCA acessa o DB acima.
PORTAL_RH_API_URL=
PORTAL_RH_API_SERVICE_TOKEN=
PORTAL_RH_API_TIMEOUT=5

# Biblioteca PDF de desenhos (FILESERVER) — mount do api-delpi em dev
# WSL: sudo mkdir -p /mnt/x && sudo mount -t drvfs X: /mnt/x
DRAWING_PDF_FILESERVER_HOST_PATH=/mnt/x/DESENHOS DELPI EM PDF

# Mesma pasta no production-control-api (cockpit do operador serve o PDF sem passar pela api-delpi)
PC_DRAWING_PDF_HOST_PATH=/mnt/x/DESENHOS DELPI EM PDF

# MES Fase 1 — parada automatica por ausencia de golpes (0 = desabilitado)
PC_MES_AUTO_DOWNTIME_SECONDS=120
# MES Fase 2.7 — threshold dinamico por ciclo congelado (somente posto manual
# com tempo padrao complete; qualquer outro caso usa o threshold acima).
# Default false — habilitar somente apos validacao em CT controlado.
PC_MES_DYNAMIC_AUTO_DOWNTIME_ENABLED=false
# Piso do threshold dinamico (default: igual ao legado — nunca reduz sozinho)
PC_MES_AUTO_DOWNTIME_MIN_SECONDS=120
# Multiplicador do ciclo padrao para posto manual (ceil)
PC_MES_AUTO_DOWNTIME_MANUAL_CYCLE_MULTIPLIER=3
# MES autonomo por CT (PC-MES-CT-AUTONOMOUS-DOWNTIME) — detecta producao/
# parada em CT sensorizado mesmo sem OP. * = todos os sensorizados.
PC_MES_CT_AUTONOMOUS_ENABLED=true
PC_MES_CT_AUTONOMOUS_WORK_CENTERS=*

# Gestão de Paradas — Etapa 6 (insights + alertas gerenciais).
# Criticidade/eficácia dos insights:
PC_MES_DOWNTIME_EFFECTIVENESS_WINDOW_DAYS=30
PC_MES_DOWNTIME_TELEMETRY_STALE_MINUTES=30
# PC_MES_DOWNTIME_CRITICAL_OPEN_SECONDS=7200
# PC_MES_DOWNTIME_CRITICAL_RECURRENCE_OCCURRENCES=3
# Alertas Minha DELPI — desligado por padrão; cada regra exige o
# parâmetro correspondente (sem parâmetro = regra inativa):
PC_MES_DOWNTIME_ALERTS_ENABLED=false
PC_MES_DOWNTIME_ALERT_INTERVAL_SECONDS=300
# PC_MES_DOWNTIME_UNCLASSIFIED_ALERT_THRESHOLD=5
# PC_MES_DOWNTIME_OVERDUE_ACTION_DAYS=7

# Delpi MES API — BFF gerencial stateless
DELPI_MES_API_ROOT_PATH=/apps/delpi-mes-api
PRODUCTION_CONTROL_API_URL=http://production-control-api:8000
PRODUCTION_CONTROL_API_TIMEOUT=5
REQUESTS_API_URL=http://requests-api:8000
REQUESTS_API_TIMEOUT=5

# --- Planilhas Google (plugins que consomem) ---
GOOGLE_SHEETS_TIMEOUT=10
# Preencher IDs/GIDs conforme plugins habilitados no ambiente
# Portal Financeiro / dashboard-financial — EBITDA, custo fixo e PMR
FINANCIAL_EBITDA_SHEET_ID=
FINANCIAL_EBITDA_SHEET_GID=
FINANCIAL_FIXED_COST_SHEET_ID=
FINANCIAL_FIXED_COST_SHEET_GID=
FINANCIAL_RECEIVABLES_SHEET_ID=
FINANCIAL_RECEIVABLES_SHEET_GID=

# Portal Financeiro — NF-e de entrada no Questor Zen (token só no backend)
FIN_QUESTOR_BASE_URL=https://alliance.app.questorpublico.com.br
FIN_QUESTOR_API_TOKEN=
FIN_QUESTOR_COMPANY_01_ID=5a85a32c4b541917008b2977
FIN_QUESTOR_COMPANY_02_ID=5a85a32c4b541917008b2979
FIN_QUESTOR_TIMEOUT_SECONDS=30
FIN_QUESTOR_DANFE_MAX_BYTES=10485760

# --- Redis (opcional; cache LMP/estoque e telemetria SQL do console) ---
REDIS_URL=
QUERY_CACHE_BACKEND=memory
QUERY_CACHE_TTL_SECONDS=300
SQL_TELEMETRY_BACKEND=memory
SQL_TELEMETRY_MAX_ENTRIES=800

# --- Alertas do console API DELPI (Fase 5) ---
CONSOLE_ALERT_WEBHOOK_URL=
CONSOLE_ALERT_WEBHOOK_ENABLED=true
CONSOLE_ALERT_PORTAL_ENABLED=true
CONSOLE_ALERT_P95_THRESHOLD_MS=3000
CONSOLE_ALERT_SLOW_SQL_THRESHOLD_MS=2500
CONSOLE_ALERT_POOL_SATURATION_PCT=90

# Auditoria 5S — notificações in-app (responsável NC → sino do portal)
AUDIT_5S_NOTIFICATIONS_ENABLED=true
SCHEDULING_NOTIFICATIONS_ENABLED=true

# Microsoft Graph — Canal de Denúncia (api-delpi; sem valores reais no repositório)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_SENDER=canal-denuncia@delpi.com.br
GRAPH_MAIL_RECIPIENT=ouvidoria@delpi.com.br
# Delpi Reports — Graph dedicado (não reutilizar canal-denúncia)
GRAPH_REPORTS_TENANT_ID=
GRAPH_REPORTS_CLIENT_ID=
GRAPH_REPORTS_CLIENT_SECRET=
GRAPH_REPORTS_MAIL_SENDER=minhadelpi@delpi.com.br
REPORTS_MAIL_BATCH_SIZE=40
REPORTS_RUN_ARTIFACTS_DIR=/app/data/reports-runs
GRAPH_HTTP_TIMEOUT_SECONDS=15
SCHEDULING_APPROVAL_TTL_HOURS=24

# --- Transformômetro + Chat Minha Delpi — Kimi / OpenRouter ---
# Doc atas: transformometro-api/docs/meeting-minutes-kimi.md
# Doc chat: minha-delpi-ai-api/docs/operations/tutorial-conectar-llm-externo.md § Kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://openrouter.ai/api/v1
KIMI_MODEL=moonshotai/kimi-k3
# KIMI_TIMEOUT_SECONDS=180
#
# DÉLIA API — provider real openai_compatible (vocabulário próprio DELIA_LLM_*).
# Política aprovada (local-llm-testing-policy-ollama-2026-10-22.md): fora de
# produção o ÚNICO provider permitido é o Ollama local. Endpoints externos são
# recusados na composição (fail-closed) e nos runners de teste — sem fallback
# pago. Endpoint externo só é permitido com DELIA_ENV=production.
# Ollama (profile optional-heavy): requer valor de API key não-vazio, o bearer
# é ignorado pelo runtime local.
DELIA_LLM_BASE_URL=http://ollama:11434/v1
DELIA_LLM_API_KEY=ollama-local
# Janela de entrada efetiva do runtime em tokens (≠ capacidade nominal do
# modelo). DEVE igualar o ctx efetivo que o daemon honra: o default do
# Ollama é OLLAMA_CONTEXT_LENGTH (4096 se ausente) ou num_ctx baked no
# Modelfile do modelo. Declarar mais do que o runtime honra reabre o
# truncamento silencioso. Vazio = sem enforcement.
#
# Chat IA — mesmo token das atas:
# LLM_PROVIDER=openai_compatible
# LLM_TEXT_* opcional (herda KIMI_* quando vazio)
# Visão de documentos — mesma Kimi (herda KIMI_* se VISION_LLM_* vazio):
# VISION_LLM_PROVIDER=openai_compatible
#
# Caps de geração com openai_compatible: NÃO use CHAT_RESPONSE_MODE_*_MAX_TOKENS
# (só Ollama). Defaults Compose/JSON: Rápida 2048 · Normal 4096 · Pensador 8192.
# MAX_CONTEXT_CHARS=24000
# LLM_MAX_TOKENS só importa se CHAT_RESPONSE_MODES_ENABLED=false (status/fallback).

# TÉO — hosts autorizados p/ download de fileParams do ChatGPT
# (openai/fileParams; allowlist estrita — NUNCA wildcard Azure/cloud).
# Host observado no aceite R4.2-C1: oaisdmntprbrazilsouth (Azure signed URL).
OPENAI_FILE_DOWNLOAD_HOSTS=files.oaiusercontent.com,oaiusercontent.com,oaisdmntprbrazilsouth.blob.core.windows.net,oaisdmntprsouthcentralus.blob.core.windows.net

# --- S2S individual (Keycloak Client Credentials) -----------------------
# Identidade técnica exclusiva por serviço; substitui gradualmente o token
# interno compartilhado. Contrato: docs/11-padroes-de-desenvolvimento/
#   padrao-autenticacao-s2s-individual.md + ADR-010 (supplies/adr).
# Solicitante (ex.: supplies-api):
# S2S_TOKEN_URL=http://keycloak:8080/realms/delpi/protocol/openid-connect/token
# S2S_CLIENT_ID=supplies-api
# S2S_CLIENT_SECRET=<secret do cliente confidencial no Keycloak>
# Escopo vazio quando os scopes requeridos são atribuídos como default
# client scope no Keycloak (ver infra/scripts/keycloak_s2s_supplies_scope.py).
# S2S_SCOPE=
# S2S_TIMEOUT_SECONDS=10
# Verificador (ex.: api-delpi):
# S2S_AUDIENCE=api-delpi
# S2S_ALLOWED_CLIENTS=supplies-api

# =============================================================================
# SEÇÕES CONSOLIDADAS — absorvidas de env.local.example e env.<plugin>.example
# (arquivos legados viraram ponteiros; esta é a fonte canônica).
# Valores secretos ficam como CHANGE_ME — nunca copiar segredos para o repo.
# =============================================================================

