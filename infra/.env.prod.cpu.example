# =============================================================================
# DELPI CENTRAL — infra/.env (PRODUÇÃO CPU, ex.: srv-api 4 vCPU · ~15 GB RAM)
# =============================================================================
# Copie só o bloco «IA — Minha DELPI Chat» para o infra/.env do servidor.
#
# Regra: docker-compose.yml prod já injeta defaults (RAG híbrido, web search,
# skills SQL/company-knowledge, typing correction, paginação, aprendizagem…).
# Liste aqui APENAS tuning deste host e overrides explícitos (geralmente false).
#
# Referência completa (tudo ligado): infra/.env.prod.example
# Após editar: docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --force-recreate minha-delpi-ai-api
# =============================================================================

# ============================
# IA — Minha DELPI Chat (Ollama, CPU sem GPU)
# srv-api: ~15 GB RAM · 4 vCPU
# ============================

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m

LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1536
# CHAT_LLM_LATENCY_PROFILE=operational_cpu

# Pensador no 3b (mesmo OLLAMA_MODEL); NÃO usar 7b neste host
CHAT_RESPONSE_MODE_THINKER_MODEL=qwen2.5:3b

EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120

RAG_CONTEXT_MIN_SCORE=0.35
RAG_IDENTITY_QUESTION_MIN_SCORE=0.22
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_CHARS=12000

# --- UX / latência (overrides; compose default PERSIST=true, TITLE=true) ---
CHAT_PERSIST_BEFORE_PLAYBACK=false
CHAT_SESSION_TITLE_LLM_ENABLED=false
CHAT_FAST_PATH_MAX_CHARS=48
CHAT_DIRECT_RESPONSE_STREAM_CHUNK_CHARS=4
CHAT_DIRECT_RESPONSE_STREAM_DELAY_MS=0
CHAT_HISTORY_MAX_MESSAGES=12

# --- Pipeline operacional (CPU: sem LLM/embed extra na seleção de rotas) ---
EXTERNAL_ACTION_SEMANTIC_RANK_ENABLED=false
CHAT_TOOL_ROUTER_ENABLED=false
CHAT_AGENTIC_LOOP_ENABLED=false
CHAT_NATIVE_TOOL_CALLING_ENABLED=false

# --- Humanização tabular (R16): só vocabulário JSON, sem LLM/web por coluna ---
CHAT_PRESENTATION_COLUMN_LABEL_DISCOVERY_ENABLED=false
CHAT_PRESENTATION_COLUMN_LABEL_WEB_SEARCH_ENABLED=false
CHAT_PRESENTATION_COLUMN_LABEL_WEB_MAX_QUERIES=0

# --- LanguageTool (~2,5 GB RAM extra; serviço languagetool no compose prod) ---
# Compose default true — desligue neste host se não subir languagetool ou RAM apertada.
CHAT_TEXT_CORRECTION_SPELL_CHECK_ENABLED=false

# --- Web search (timeout > default compose 8s; demais flags via compose) ---
CHAT_WEB_SEARCH_TIMEOUT_SECONDS=12
CHAT_WEB_SEARCH_TAVILY_API_KEY=
CHAT_WEB_SEARCH_SERPER_API_KEY=
CHAT_WEB_SEARCH_BING_API_KEY=
# Só se acessar SearXNG pelo host (a API usa CHAT_WEB_SEARCH_SEARXNG_BASE_URL do compose):
SEARXNG_BASE_URL=http://localhost:8088/
