{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@delpi/tv-dashboard-presentation": ["../plugins/tv-dashboard-presentation/src/index.ts"],
      "@delpi/plugin-ui": ["../plugins/plugin-ui/src/index.ts"],
      "@delpi/plugin-ui/index": ["../plugins/plugin-ui/src/index.ts"],
      "@delpi/plugin-ui/styles": ["../plugins/plugin-ui/src/styles.css"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
