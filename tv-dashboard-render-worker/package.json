{
  "name": "@delpi/tv-dashboard-render-worker",
  "private": true,
  "version": "0.1.0",
  "description": "Bounded TV canonical render execution host — paints shared presentation stage in Chromium and returns canonical_stage PNG.",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:page": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "lucide-react": "^0.576.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "1.62.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
