{
  "schemaVersion": "1.0.0",
  "id": "api-delpi",
  "name": "API DELPI TOTVS",
  "description": "API corporativa de integrações DELPI",
  "icon": "server",
  "version": "1.0.4",
  "type": "backend-only",
  "basePath": "/apps/api-delpi",
  "entry": null,
  "permissions": [
    {
      "code": "api-delpi.access",
      "name": "api-delpi.access",
      "description": "Permite acesso à API DELPI",
      "module": "api-delpi"
    },
    {
      "code": "api-delpi.data",
      "name": "api-delpi.data",
      "description": "Executa SELECT somente leitura no Protheus via POST /data/sql",
      "module": "api-delpi"
    },
    {
      "code": "api-delpi.integrations.protheus.read",
      "name": "api-delpi.integrations.protheus.read",
      "description": "Leitura da integração REST Protheus (status e consulta de fornecedor)",
      "module": "api-delpi"
    },
    {
      "code": "api-delpi.integrations.protheus.suppliers.create",
      "name": "api-delpi.integrations.protheus.suppliers.create",
      "description": "Criação de fornecedor via REST Protheus (POST; feature-gated)",
      "module": "api-delpi"
    },
    {
      "code": "api-delpi.integrations.protheus.suppliers.update",
      "name": "api-delpi.integrations.protheus.suppliers.update",
      "description": "Alteração de fornecedor via REST Protheus (PUT; feature-gated)",
      "module": "api-delpi"
    }
  ],
  "routes": [],
  "backend": {
    "audience": "delpi-central",
    "baseUrl": "/apps/api-delpi",
    "issuer": "http://localhost/auth/realms/delpi",
    "required": true,
    "requiredPermissionsHeader": "x-user-permissions",
    "serviceName": "api-delpi",
    "validateJwt": true
  },
  "lifecycle": {
    "allowHotReload": false,
    "allowVersionUpgrade": true,
    "autoCreateRoutes": false,
    "autoRegisterPermissions": true
  },
  "security": {
    "requireHttps": true
  },
  "observability": {
    "healthEndpoint": "/health",
    "logFormat": "json"
  }
}