{
  "schemaVersion": "2.0.0",
  "id": "crm",
  "name": "CRM DELPI",
  "version": "2.1.0",
  "type": "microfrontend",
  "basePath": "/crm",
  "entry": "/apps/crm/remoteEntry.js",
  "permissions": [
    {
      "code": "crm.access",
      "description": "Permite acessar CRM",
      "module": "crm"
    },
    {
      "code": "crm.leads.read",
      "description": "Visualizar leads",
      "module": "crm"
    }
  ],
  "routes": [
    {
      "path": "/crm",
      "label": "Dashboard",
      "permission": "crm.access"
    },
    {
      "path": "/crm/leads",
      "label": "Leads",
      "permission": "crm.leads.read"
    }
  ]
}