    {
      "key": "add_kpi_from_route",
      "op": "upsert_data_source",
      "isComposite": true,
      "whenToUse": "Adicionar um KPI no slide a partir de uma rota allowlisted (fonte + kpi_view + bind).",
      "contentMarkers": [
        "kpi",
        "indicador",
        "adicione um kpi",
        "adicionar um kpi",
        "adicionar kpi",
        "crie um kpi",
        "criar um kpi"
      ],
      "excludeMarkers": ["script m", "power query", "gráfico", "grafico", "tabela"],
      "actionTermSet": "create",
      "payloadTemplates": [
        {
          "op": "upsert_data_source",
          "operationId": "{{operationId}}",
          "params": {},
          "blockId": "{{newDataSourceId}}",
          "displayMode": "kpi",
          "label": "{{routeLabel}}"
        },
        {
          "op": "upsert_block",
          "block": {
            "id": "{{newVisualId}}",
            "type": "kpi_view",
            "frame": { "x": 10, "y": 28, "w": 28, "h": 22 },
            "style": { "zIndex": 2 }
          }
        },
        {
          "op": "bind_visual",
          "visualId": "{{newVisualId}}",
          "dataSourceId": "{{newDataSourceId}}"
        }
      ],
      "inputSchema": {
        "type": "object",
        "required": ["op", "operationId"],
        "properties": {
          "op": { "const": "upsert_data_source" },
          "operationId": { "type": "string" },
          "blockId": { "type": "string" },
          "params": { "type": "object" },
          "label": { "type": "string" },
          "displayMode": { "type": "string" }
        }
      },
      "sideEffectHints": ["replaceNativeConfig"],
      "requiresSlide": true,
      "requiresPlaylist": true
    },
