        "operationId": "{{operationId}}",
        "params": {},
        "blockId": "{{selectedBlockId}}"
      },
      "inputSchema": {
        "type": "object",
        "required": ["op", "operationId"],
        "properties": {
          "op": { "const": "upsert_data_source" },
          "operationId": { "type": "string" },
          "blockId": { "type": "string" },
          "params": { "type": "object" },
          "label": { "type": "string" },
          "displayMode": { "type": "string" },
          "dataTransform": { "type": "object" }
        }
      },
      "sideEffectHints": ["replaceNativeConfig"],
      "requiresSlide": true,
      "requiresPlaylist": true
    },
