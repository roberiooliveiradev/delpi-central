      "textRoles": ["display", "title", "sectionTitle"]
    },
    "text": {
      "componentType": "text",
      "purpose": ["caption", "body"],
      "recommendedFor": ["supporting copy"],
      "avoidFor": ["primary metric"],
      "textRoles": ["body", "caption", "label"]
    },
    "shape": {
      "componentType": "shape",
      "purpose": ["surface"],
      "recommendedFor": ["card", "callout", "accentStrip"],
