    "THEME_LIGHT": {
      "label": "Tema claro",
      "themeKey": "light",
      "description": "Fundo claro TV.",
      "markers": ["tema claro", "fundo claro", "theme light", "visual limpo"],
      "ops": [
        {
          "op": "patch_native_config",
          "patch": {
            "background": { "type": "color", "value": "#f8fafc" }
          }
        }
      ]
