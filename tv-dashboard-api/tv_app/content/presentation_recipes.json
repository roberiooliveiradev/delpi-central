{
  "version": "2026.09.22.1",
  "fontFamilyAllowlist": [
    "Inter, system-ui, sans-serif",
    "system-ui, sans-serif",
    "Georgia, serif"
  ],
  "colorRamps": {
    "delpi_navy": ["#05070a", "#0d2840", "#089bdb"],
    "midnight": ["#0f172a", "#1e293b", "#38bdf8"],
    "factory": ["#111827", "#334155", "#f59e0b"],
    "light_kiosk": ["#f8fafc", "#e2e8f0", "#0f172a"],
    "contrast_tv": ["#020617", "#ffffff", "#22c55e"]
  },
  "recipes": {
    "TV_KPI_HERO": {
      "label": "KPI hero TV",
      "themeKey": "delpi",
      "description": "Fundo escuro DELPI + título + um KPI grande.",
      "markers": [
        "kpi hero",
        "kpi grande",
        "indicador em destaque",
        "painel kpi",
        "slide kpi"
      ],
      "ops": [
        {
          "op": "patch_native_config",
          "patch": {
            "background": {
              "type": "gradient",
              "from": "#05070a",
              "to": "#0d2840",
              "angle": 180
            }
          }
        },
        {
          "op": "upsert_block",
          "block": {
            "type": "heading",
            "frame": { "x": 4, "y": 6, "w": 92, "h": 12 },
            "style": {
              "fontSize": 40,
              "fontWeight": "bold",
              "color": "#ffffff",
              "fontFamily": "Inter, system-ui, sans-serif",
              "textAlign": "left"
            }
          }
        },
        {
          "op": "upsert_block",
          "block": {
            "type": "kpi_view",
            "frame": { "x": 8, "y": 24, "w": 84, "h": 52 },
            "style": {
              "color": "#ffffff",
              "fontFamily": "Inter, system-ui, sans-serif"
            }
          }
        }
      ]
    },
    "TV_KPI_PLUS_CHART": {
      "label": "KPI + gráfico TV",
      "themeKey": "midnight",
      "description": "KPI à esquerda e chart à direita em fundo meia-noite.",
      "markers": [
        "kpi e gráfico",
        "kpi e grafico",
        "indicador com série",
