        },
        {
          "op": "upsert_block",
          "block": {
            "type": "heading",
            "frame": { "x": 4, "y": 4, "w": 92, "h": 10 },
            "style": {
              "fontSize": 32,
              "fontWeight": "bold",
              "color": "#f8fafc",
              "fontFamily": "Inter, system-ui, sans-serif"
            }
          }
        },
        {
          "op": "upsert_block",
          "block": {
            "type": "kpi_view",
            "frame": { "x": 4, "y": 18, "w": 30, "h": 70 },
            "style": { "color": "#f8fafc", "fontFamily": "Inter, system-ui, sans-serif" }
          }
        },
        {
          "op": "upsert_block",
          "block": {
            "type": "chart_view",
            "chartType": "line",
            "frame": { "x": 38, "y": 18, "w": 58, "h": 70 },
            "style": { "color": "#f8fafc", "fontFamily": "Inter, system-ui, sans-serif" }
          }
        }
      ]
    },
    "TV_TABLE_FOCUS": {
      "label": "Tabela foco TV",
      "themeKey": "factory",
      "description": "Tabela dominante com título curto.",
      "markers": [
        "tabela em destaque",
        "foco tabela",
        "slide tabela",
        "table focus"
      ],
      "ops": [
        {
          "op": "patch_native_config",
          "patch": {
            "background": {
              "type": "gradient",
              "from": "#1e293b",
              "to": "#334155",
              "angle": 135
