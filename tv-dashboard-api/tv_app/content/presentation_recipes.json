  "recipes": {
    "TV_KPI_HERO": {
      "label": "KPI hero TV Delpi",
      "themeKey": "delpi",
      "description": "Fundo Delpi + título + KPI card navy proporcional.",
      "markers": [
        "kpi hero",
        "kpi grande",
        "indicador em destaque",
        "painel kpi",
        "slide kpi"
      ],
      "ops": [
        {
          "op": "patch_native_config",
          "patch": {
            "background": {
              "type": "gradient",
              "from": "#05070a",
              "to": "#0d2840",
              "angle": 180
            }
          }
        },
        {
          "op": "upsert_block",
          "block": {
            "type": "heading",
            "frame": { "x": 6, "y": 6, "w": 88, "h": 12 },
            "style": {
              "fontSize": 40,
              "fontWeight": "bold",
              "color": "#ffffff",
              "fontFamily": "Inter, system-ui, sans-serif",
              "textAlign": "left"
            }
          }
        },
        {
          "op": "upsert_block",
          "block": {
            "type": "kpi_view",
            "frame": { "x": 18, "y": 22, "w": 36, "h": 42 },
            "style": {
              "color": "#ffffff",
              "fontFamily": "Inter, system-ui, sans-serif",
              "backgroundColor": "#0d2840",
              "zIndex": 2
            },
            "kpiParts": {
              "card": {
                "style": {
                  "fill": "#0d2840",
                  "backgroundColor": "#0d2840",
                  "borderRadius": 16
                }
              },
              "title": {
                "style": { "fontSize": 28, "color": "#e2e8f0", "fontWeight": "600" }
              },
              "value": {
                "style": { "fontSize": 80, "color": "#ffffff", "fontWeight": "bold" }
              },
              "icon": {
                "style": { "iconSize": 48, "color": "#089bdb" }
              }
            }
          }
        }
      ]
    },
