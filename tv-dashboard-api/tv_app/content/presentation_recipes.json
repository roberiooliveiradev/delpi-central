              "fontSize": 28,
              "fontWeight": "bold",
              "color": "#f1f5f9",
              "fontFamily": "Inter, system-ui, sans-serif"
            }
          }
        },
        {
          "op": "upsert_block",
          "block": {
            "type": "table_view",
