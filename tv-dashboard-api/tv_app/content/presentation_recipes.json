    "safeMargin": 3,
    "gutter": 2,
    "maxPrimarySignalsPerSlide": 4,
    "typeScale": {
      "display": 48,
      "title": 32,
      "body": 22,
      "caption": 16
    },
    "kpiValueScale": {
      "hero": 80,
      "row": 56,
      "grid": 44
    },
    "minContrastPairs": [
      {
        "fg": "#ffffff",
        "bg": "#05070a"
      },
      {
        "fg": "#ffffff",
        "bg": "#0d2840"
      },
      {
