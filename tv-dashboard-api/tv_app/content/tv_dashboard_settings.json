{
  "externalUrl": {
    "allowLocalhost": true,
    "allowedHostSuffixes": [
      "powerbi.com",
      "app.powerbi.com",
      "sharepoint.com",
      "lookerstudio.google.com",
      "tableau.com",
      "public.tableau.com",
      "metabase.com",
      "grafana.net",
      "grafana.com"
    ],
    "rejectionMessage": "Domínio não permitido. Use Power BI, Tableau ou outro host autorizado."
  },
  "nativeDataCache": {
    "ttlSeconds": 120
  },
  "mQuery": {
    "enabled": false,
    "writeV2Enabled": false,
    "advancedEditorEnabled": false,
    "profilingEnabled": false,
    "profile": "m-delpi-v1",
    "defaultCulture": "pt-BR",
    "maxScriptBytes": 65536,
    "maxSteps": 100,
    "maxAstNodes": 5000,
    "maxExpressionDepth": 40,
    "maxPreviewRows": 200,
    "maxPreviewColumns": 200,
    "maxPreviewCells": 40000,
    "maxJoinInputRows": 5000,
    "executionTimeoutMs": 2000,
    "diagnosticSampleLimit": 20
  },
  "tableIncrementalPageSize": 30,
  "comunicadoDataBlocks": {
    "maxPerSlide": 6
  },
  "presentationHeartbeat": {
    "intervalSec": 60
  },
  "presentationRealtime": {
    "wsReconnectSec": 5,
    "wsPingSec": 30
  },
  "branchPolicy": {
    "allowedBranches": [],
    "canonicalParamAliases": [
      "branch",
      "branch_code",
      "filial",
      "filial_id"
    ],
    "compatibilityFallbackForUncuratedRoutes": true,
    "rejectionMessage": "Filial não autorizada para Painéis TV."
  },
  "mediaUpload": {
    "maxImageBytes": 10485760,
    "maxVideoBytes": 104857600,
    "maxFontBytes": 5242880,
    "imageMimeExtensions": {
      "image/jpeg": ".jpg",
      "image/jpg": ".jpg",
      "image/png": ".png",
      "image/webp": ".webp",
      "image/gif": ".gif"
    },
    "videoMimeExtensions": {
      "video/mp4": ".mp4",
      "video/webm": ".webm"
    },
    "fontMimeExtensions": {
      "font/woff2": ".woff2",
      "font/ttf": ".ttf",
      "font/otf": ".otf",
      "application/font-woff2": ".woff2",
      "application/x-font-ttf": ".ttf"
    }
  }
}
