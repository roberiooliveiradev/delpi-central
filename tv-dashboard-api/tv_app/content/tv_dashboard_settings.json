{
  "externalUrl": {
    "allowLocalhost": true,
    "allowedHostSuffixes": [
      "powerbi.com",
      "app.powerbi.com",
      "sharepoint.com",
      "lookerstudio.google.com",
      "tableau.com",
      "public.tableau.com",
      "metabase.com",
      "grafana.net",
      "grafana.com"
    ],
    "rejectionMessage": "Domínio não permitido. Use Power BI, Tableau ou outro host autorizado."
  },
  "nativeDataCache": {
    "ttlSeconds": 120
  },
  "tableIncrementalPageSize": 30,
  "comunicadoDataBlocks": {
    "maxPerSlide": 6
  },
  "presentationHeartbeat": {
    "intervalSec": 60
  },
  "presentationRealtime": {
    "wsReconnectSec": 5,
    "wsPingSec": 30
  },
  "branchPolicy": {
    "allowedBranches": [],
    "rejectionMessage": "Filial não autorizada para Painéis TV."
  },
  "mediaUpload": {
    "maxImageBytes": 10485760,
    "maxVideoBytes": 104857600,
    "maxFontBytes": 5242880,
    "imageMimeExtensions": {
      "image/jpeg": ".jpg",
      "image/jpg": ".jpg",
      "image/png": ".png",
      "image/webp": ".webp",
      "image/gif": ".gif"
    },
    "videoMimeExtensions": {
      "video/mp4": ".mp4",
      "video/webm": ".webm"
    },
    "fontMimeExtensions": {
      "font/woff2": ".woff2",
      "font/ttf": ".ttf",
      "font/otf": ".otf",
      "application/font-woff2": ".woff2",
      "application/x-font-ttf": ".ttf"
    }
  }
}
