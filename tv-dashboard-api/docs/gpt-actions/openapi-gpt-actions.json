        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ops"
                ],
                "properties": {
                  "target": {
                    "type": "object"
                  },
                  "ops": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "catalogVersion": {
                    "type": "string"
                  }
