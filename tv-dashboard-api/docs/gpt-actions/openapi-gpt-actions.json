{
  "openapi": "3.1.1",
  "info": {
    "title": "TV Dashboard Custom GPT Actions",
    "version": "1.0.0",
    "description": "Compact OAuth façade over tv-dashboard-api. Owner of catalog and writes remains TV. Eight Actions; openapi.json is import-only and not listed here."
