FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY delpi-mes-api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY shared /shared
RUN pip install --no-cache-dir -e "/shared[fastapi]"

COPY delpi-mes-api /app

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "delpi_mes_app.main:app", "--host", "0.0.0.0", "--port", "8000", "--root-path", "/apps/delpi-mes-api", "--workers", "2"]
