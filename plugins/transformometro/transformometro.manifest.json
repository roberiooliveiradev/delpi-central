{
  "schemaVersion": "1.0.0",
  "id": "transformometro",
  "name": "Portal Transforma+",
  "description": "Experiência do Portal Transforma+ sobre o domínio Transformômetro — processos, indicadores, atas e configurações.",
  "icon": "gauge",
  "version": "0.5.4",
  "type": "microfrontend",
  "basePath": "/apps/transformometro",
  "entry": "/apps/transformometro/assets/remoteEntry.js",
  "permissions": [
    {
      "code": "transformometro.access",
      "name": "Acessar Portal Transforma+",
      "description": "Permite acessar e utilizar todas as funcionalidades normais do Portal Transforma+.",
      "module": "transformometro"
    },
    {
      "code": "transformometro.manage",
      "name": "Administrar Portal Transforma+",
      "description": "Permite acessar as funcionalidades administrativas do Portal Transforma+, como gestão de equipe, grupos e acessos.",
      "module": "transformometro"
    }
  ],
  "routes": [
    {
      "path": "/apps/transformometro",
      "label": "Portal Transforma+",
      "permission": "transformometro.access",
      "icon": "home",
      "entry": null,
      "order": 10,
      "showInMenu": true
    },
    {
      "path": "/apps/transformometro/dashboard",
      "label": "Visão geral",
      "permission": "transformometro.access",
      "icon": "layout-dashboard",
      "entry": null,
      "order": 20,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/processes",
      "label": "Meus processos",
      "permission": "transformometro.access",
      "icon": "list",
      "entry": null,
      "order": 22,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/settings",
      "label": "Configurações",
      "permission": "transformometro.access",
      "icon": "folder-tree",
      "entry": null,
      "order": 23,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/settings/units",
      "label": "Unidades",
      "permission": "transformometro.access",
      "icon": "folder-tree",
      "entry": null,
      "order": 24,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/settings/departments",
      "label": "Departamentos",
      "permission": "transformometro.access",
      "icon": "folder-tree",
      "entry": null,
      "order": 25,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/settings/shared-resources",
      "label": "Recursos compartilhados",
      "permission": "transformometro.access",
      "icon": "folder-tree",
      "entry": null,
      "order": 26,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/meeting-minutes",
      "label": "Atas",
      "permission": "transformometro.access",
      "icon": "file-text",
      "entry": null,
      "order": 30,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/my-signature",
      "label": "Minha assinatura",
      "permission": "transformometro.access",
      "icon": "pen-line",
      "entry": null,
      "order": 31,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/data",
      "label": "Exportar/Importar",
      "permission": "transformometro.access",
      "icon": "arrow-down-up",
      "entry": null,
      "order": 32,
      "showInMenu": false
    },
    {
      "path": "/apps/transformometro/administration",
      "label": "Administração",
      "permission": "transformometro.manage",
      "icon": "settings",
      "entry": null,
      "order": 40,
      "showInMenu": false
    }
  ],
  "backend": {
    "audience": "delpi-central",
    "baseUrl": "/apps/transformometro-api/transformometro",
    "issuer": "https://www.minhadelpi.com.br/auth",
    "required": true,
    "serviceName": "transformometro-api",
    "validateJwt": true
  },
  "ui": {
    "renderMode": "federated"
  }
}
