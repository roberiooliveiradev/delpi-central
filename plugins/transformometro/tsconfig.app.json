{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": [],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../plugin-ui/node_modules/@types/react"],
      "react-dom": ["../plugin-ui/node_modules/@types/react-dom"],
      "@delpi/plugin-ui": ["../plugin-ui/src/index.ts"],
      "@delpi/plugin-ui/index": ["../plugin-ui/src/index.ts"],
      "@delpi/plugin-ui/styles": ["../plugin-ui/src/styles.css"],
      "@delpi/transformometro-meeting-minutes-presentation": [
        "../transformometro-meeting-minutes-presentation/src/index.ts"
      ],
      "@delpi/bpmn-editor": ["../bpmn-editor/src/index.ts"],
      "@delpi/bpmn-editor/*": ["../bpmn-editor/src/*"]
    }
  },
  "include": ["src", "../bpmn-editor/src/**/*.d.ts"]
}
