{
  "schemaVersion": "1.0.0",
  "id": "controllership-finance",
  "name": "Portal Controladoria & Finanças",
  "description": "Portal de controladoria e finanças — Início, navegação e contexto operacional.",
  "icon": "landmark",
  "version": "0.1.5",
  "type": "microfrontend",
  "basePath": "/apps/controllership-finance",
  "entry": "/apps/controllership-finance/assets/remoteEntry.js",
  "permissions": [
    {
      "code": "controllership-finance.access",
      "name": "Acessar Portal Controladoria & Finanças",
      "description": "Acesso às funcionalidades do produto (Início e demais áreas conforme liberadas).",
      "module": "controllership-finance"
    },
    {
      "code": "controllership-finance.manage",
      "name": "Administrar Portal Controladoria & Finanças",
      "description": "Administração do produto (áreas de gestão conforme liberadas). Não implica acesso às demais rotas.",
      "module": "controllership-finance"
    },
    {
      "code": "controllership-finance.access.dre",
      "name": "Acessar Portal Controladoria & Finanças — DRE",
      "description": "Acesso à experiência da Contabilidade/DRE no Portal Controladoria & Finanças, incluindo página inicial, fechamentos recebidos, documentos disponibilizados, downloads autorizados e interações. Não concede acesso às funcionalidades internas de gestão e relatórios.",
      "module": "controllership-finance"
    }
  ],
  "routes": [
    {
      "path": "/apps/controllership-finance",
      "label": "Controladoria & Finanças",
      "permission": "controllership-finance.access",
      "icon": "landmark",
      "order": 30,
      "showInMenu": true
    },
    {
      "path": "/apps/controllership-finance/closing/financial-settlements",
      "label": "Baixas financeiras",
      "permission": "controllership-finance.access",
      "icon": "calendar-check",
      "order": 31,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/stock-inventory",
      "label": "Estoque histórico — P7",
      "permission": "controllership-finance.access",
      "icon": "boxes",
      "order": 32,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/checklist",
      "label": "Checklist da competência",
      "permission": "controllership-finance.access",
      "icon": "calendar-check",
      "order": 33,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/admin",
      "label": "Administração do checklist",
      "permission": "controllership-finance.manage",
      "icon": "settings",
      "order": 34,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/pendencies",
      "label": "Pendências do fechamento",
      "permission": "controllership-finance.access",
      "icon": "list-todo",
      "order": 35,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/packages",
      "label": "Pacotes e revisão",
      "permission": "controllership-finance.access",
      "icon": "package",
      "order": 36,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/cockpit",
      "label": "Cockpit do fechamento",
      "permission": "controllership-finance.access",
      "icon": "gauge",
      "order": 37,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/monthly-closing",
      "label": "Fechamento mensal",
      "permission": "controllership-finance.access",
      "icon": "calendar-check",
      "order": 38,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/clara-consent",
      "label": "Consentimento de ações da CLARA",
      "permission": "controllership-finance.access",
      "icon": "shield-check",
      "order": 39,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/closing/documents",
      "label": "Documentos recebidos",
      "permission": "controllership-finance.access.dre",
      "icon": "file-text",
      "order": 40,
      "showInMenu": false
    },
    {
      "path": "/apps/controllership-finance/home",
      "label": "Início",
      "permission": "controllership-finance.access.dre",
      "icon": "landmark",
      "order": 41,
      "showInMenu": true
    }
  ],
  "ui": {
    "renderMode": "federated"
  }
}
