{
  "name": "tv-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "bash ../../scripts/ci/typecheck_tv_dashboard.sh",
    "build": "npm run check:css-scope && npm run typecheck && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "check:circular": "madge --circular --extensions ts,tsx src",
    "check:css-scope": "python3 ../../scripts/ci/check_tv_dashboard_css_scope.py --check",
    "ci": "npm run check:circular && npm run check:css-scope && npm run lint && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.576.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.10.6",
    "madge": "^8.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
