  <bpmn:error id="ERR_P" name="ErroP"/>
  <bpmn:process id="P_PRES" name="G4 Preserve Activities" isExecutable="false">
    <bpmn:startEvent id="PS1"/>
    <bpmn:task id="T_NORM" name="Editavel"/>
    <bpmn:complexGateway id="CG1" name="Complex"/>
    <bpmn:transaction id="TR1" name="Transacao">
      <bpmn:startEvent id="TRS1"/>
      <bpmn:task id="TRT1" name="Trabalho"/>
      <bpmn:endEvent id="TR_CANCEL_END">
        <bpmn:cancelEventDefinition id="CXL_END"/>
      </bpmn:endEvent>
      <bpmn:endEvent id="TRE1"/>
      <bpmn:sequenceFlow id="TRF1" sourceRef="TRS1" targetRef="TRT1"/>
      <bpmn:sequenceFlow id="TRF2" sourceRef="TRT1" targetRef="TRE1"/>
    </bpmn:transaction>
    <bpmn:boundaryEvent id="BND_CANCEL" attachedToRef="TR1">
      <bpmn:cancelEventDefinition id="CXL_BND"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BND_COMP" attachedToRef="TR1">
      <bpmn:compensateEventDefinition id="CMP_BND"/>
    </bpmn:boundaryEvent>
    <bpmn:task id="T_COMP" name="Compensa" isForCompensation="true"/>
    <bpmn:adHocSubProcess id="AH1" name="AdHoc" ordering="Parallel" cancelRemainingInstances="true">
      <bpmn:task id="AHT1" name="Livre1"/>
      <bpmn:task id="AHT2" name="Livre2"/>
      <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">fim</bpmn:completionCondition>
    </bpmn:adHocSubProcess>
    <bpmn:subProcess id="ESP1" name="EventSub" triggeredByEvent="true">
      <bpmn:startEvent id="ESPS1" isInterrupting="true">
        <bpmn:errorEventDefinition id="ESP_ED" errorRef="ERR_P"/>
      </bpmn:startEvent>
      <bpmn:task id="ESPT1" name="Trata"/>
      <bpmn:endEvent id="ESPE1"/>
      <bpmn:sequenceFlow id="ESPF1" sourceRef="ESPS1" targetRef="ESPT1"/>
      <bpmn:sequenceFlow id="ESPF2" sourceRef="ESPT1" targetRef="ESPE1"/>
    </bpmn:subProcess>
    <bpmn:task id="T_MIP" name="MI Paralela">
      <bpmn:multiInstanceLoopCharacteristics id="MI_P" isSequential="false">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">4</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:task id="T_MIS" name="MI Sequencial">
      <bpmn:multiInstanceLoopCharacteristics id="MI_S" isSequential="true">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">ok</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:task id="T_LOOP" name="LoopPadrao">
      <bpmn:standardLoopCharacteristics id="SL_1" testBefore="false" loopMaximum="5"/>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="ITH_COMP" name="compensa">
      <bpmn:compensateEventDefinition id="CMP_T" waitForCompletion="true" activityRef="TRT1"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="PE1"/>
    <bpmn:sequenceFlow id="PF1" sourceRef="PS1" targetRef="T_NORM"/>
    <bpmn:sequenceFlow id="PF2" sourceRef="T_NORM" targetRef="CG1"/>
    <bpmn:sequenceFlow id="PF3" sourceRef="CG1" targetRef="TR1"/>
    <bpmn:sequenceFlow id="PF4" sourceRef="CG1" targetRef="AH1"/>
    <bpmn:sequenceFlow id="PF5" sourceRef="CG1" targetRef="T_MIP"/>
    <bpmn:sequenceFlow id="PF6" sourceRef="CG1" targetRef="T_MIS"/>
    <bpmn:sequenceFlow id="PF7" sourceRef="CG1" targetRef="T_LOOP"/>
    <bpmn:sequenceFlow id="PF8" sourceRef="TR1" targetRef="PE1"/>
    <bpmn:sequenceFlow id="PF9" sourceRef="BND_CANCEL" targetRef="PE1"/>
    <bpmn:association id="ASOC_COMP" sourceRef="BND_COMP" targetRef="T_COMP" associationDirection="One"/>
  </bpmn:process>
