<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_COL" targetNamespace="urn:delpi:g4" exporter="G4Fixture" exporterVersion="1.0">
  <bpmn:collaboration id="C_MAIN" name="G4 Collab">
    <bpmn:participant id="P1" name="Pool Um" processRef="PROC1"/>
