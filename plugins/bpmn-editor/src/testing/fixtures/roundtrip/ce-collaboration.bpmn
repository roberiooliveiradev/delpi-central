            <bpmn:flowNodeRef>S_INNER</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Lane B">
        <bpmn:flowNodeRef>E_INNER</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_INNER" name="go"/>
    <bpmn:task id="T_INNER" name="Produz"/>
    <bpmn:endEvent id="E_INNER" name="fim"/>
    <bpmn:sequenceFlow id="LF1" sourceRef="S_INNER" targetRef="T_INNER"/>
    <bpmn:sequenceFlow id="LF2" sourceRef="T_INNER" targetRef="E_INNER"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_COL">
    <bpmndi:BPMNPlane id="PL_COL" bpmnElement="C_MAIN">
