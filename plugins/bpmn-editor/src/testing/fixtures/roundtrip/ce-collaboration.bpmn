      <bpmndi:BPMNShape id="SH_S_INNER" bpmnElement="S_INNER"><dc:Bounds x="200" y="90" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_T_INNER" bpmnElement="T_INNER"><dc:Bounds x="300" y="190" width="100" height="80"/><bpmndi:BPMNLabel><dc:Bounds x="320" y="278" width="60" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_E_INNER" bpmnElement="E_INNER"><dc:Bounds x="500" y="300" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_P_BB" bpmnElement="P_BB" isExpanded="false"><dc:Bounds x="80" y="440" width="900" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ED_LF1" bpmnElement="LF1"><di:waypoint x="236" y="108"/><di:waypoint x="300" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_LF2" bpmnElement="LF2"><di:waypoint x="400" y="240"/><di:waypoint x="500" y="318"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF1" bpmnElement="MF1"><di:waypoint x="350" y="270"/><di:waypoint x="350" y="440"/><bpmndi:BPMNLabel><dc:Bounds x="330" y="340" width="46" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
