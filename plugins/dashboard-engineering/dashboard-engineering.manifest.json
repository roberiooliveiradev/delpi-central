{
  "schemaVersion": "1.0.0",
  "id": "dashboard-engineering",
  "name": "Dashboard Engenharia",
  "description": "Indicadores estratégicos de engenharia: LMPs no prazo (TOTVS) e TRANSFORMA+ DELPI (planilha)",
  "icon": "wrench-icon",
  "version": "0.2.0",
  "type": "microfrontend",

  "basePath": "/apps/dashboard-engineering",
  "entry": "/apps/dashboard-engineering/assets/remoteEntry.js",

  "permissions": [
    {
      "code": "dashboard-engineering.view",
      "name": "Acesso ao dashboard de engenharia",
      "description": "Permite visualizar LMPs no prazo e ganhos/processos do TRANSFORMA+ DELPI",
      "module": "dashboard-engineering"
    }
  ],

  "routes": [
    {
      "path": "/apps/dashboard-engineering",
      "label": "Dashboard Engenharia",
      "permission": "dashboard-engineering.view",
      "icon": "wrench-icon",
      "order": 27,
      "showInMenu": true
    },
    {
      "path": "/apps/dashboard-engineering/lmp",
      "label": "LMPs no prazo",
      "permission": "dashboard-engineering.view",
      "icon": "wrench-icon",
      "order": 28,
      "showInMenu": false
    },
    {
      "path": "/apps/dashboard-engineering/transforma",
      "label": "TRANSFORMA+",
      "permission": "dashboard-engineering.view",
      "icon": "wrench-icon",
      "order": 29,
      "showInMenu": false
    }
  ],

  "ui": {
    "renderMode": "federated"
  }
}
