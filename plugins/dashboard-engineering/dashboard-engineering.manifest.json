      "label": "Dashboard Engenharia",
      "permission": "dashboard-engineering.view",
      "icon": "wrench-icon",
      "order": 27,
      "showInMenu": true
    },
    {
      "path": "/apps/dashboard-engineering/processes",
      "label": "Processos Transforma+",
      "permission": "dashboard-engineering.view",
      "icon": "wrench-icon",
      "order": 28,
      "showInMenu": false
