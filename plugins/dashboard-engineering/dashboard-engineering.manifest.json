{
  "schemaVersion": "1.0.0",
  "id": "dashboard-engineering",
  "name": "Dashboard Engenharia",
  "description": "Painel TRANSFORMA+ DELPI (ganhos e processos de melhoria) via api-delpi",
  "icon": "wrench-icon",
  "version": "0.1.0",
  "type": "microfrontend",

  "basePath": "/apps/dashboard-engineering",
  "entry": "/apps/dashboard-engineering/assets/remoteEntry.js",

  "permissions": [
