{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@delpi/plugin-ui": ["./src/shims/plugin-ui.d.ts"],
      "@delpi/plugin-ui/index": ["./src/shims/plugin-ui.d.ts"],
      "@delpi/plugin-ui/styles": ["./src/shims/plugin-ui.d.ts"],
      "@delpi/plugin-ui/native-controls": ["../plugin-ui/src/native-controls.ts"],
      "@delpi/line-balance-studio/ui": ["../delpi-line-balance-studio/src/ui/studio.tsx"],
      "@delpi/line-balance-studio": ["../delpi-line-balance-studio/src/index.ts"]
    }
  },
  "include": ["src"]
}
