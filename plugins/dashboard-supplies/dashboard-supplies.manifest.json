      "path": "/apps/dashboard-supplies",
      "label": "Dashboard Suprimentos",
      "permission": "dashboard-supplies.view",
      "icon": "package-icon",
      "order": 17,
      "showInMenu": true
    }
  ],

  "ui": {
    "renderMode": "federated"
