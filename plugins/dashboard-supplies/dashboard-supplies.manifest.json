{
  "schemaVersion": "1.0.0",
  "id": "dashboard-supplies",
  "name": "Dashboard Suprimentos",
  "description": "Painel de suprimentos (CPV, OTD compras, estoque e giro IDD) via api-delpi",
  "icon": "package-icon",
  "version": "0.1.0",
  "type": "microfrontend",

  "basePath": "/apps/dashboard-supplies",
  "entry": "/apps/dashboard-supplies/assets/remoteEntry.js",

  "permissions": [
