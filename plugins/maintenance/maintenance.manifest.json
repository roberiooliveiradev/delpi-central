    },
    {
      "code": "maintenance.view.filial-01",
      "name": "Dados — Filial 01 (Matriz)",
      "description": "Escopo de leitura de dados operacionais da filial 01 na API.",
      "module": "maintenance"
    },
    {
      "code": "maintenance.view.filial-02",
      "name": "Dados — Filial 02 (ES)",
      "description": "Escopo de leitura de dados operacionais da filial 02 na API.",
      "module": "maintenance"
    },
    {
      "code": "maintenance.manage.filial-01",
      "name": "Gerenciar dados — Filial 01",
      "description": "Escopo de escrita operacional na filial 01 (com submódulo manage).",
      "module": "maintenance"
    },
    {
      "code": "maintenance.manage.filial-02",
