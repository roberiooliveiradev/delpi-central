{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@delpi/plugin-ui": ["../plugin-ui/src/index.ts"],
      "@delpi/plugin-ui/index": ["../plugin-ui/src/index.ts"],
      "@delpi/plugin-ui/styles": ["../plugin-ui/src/styles.css"]
    }
  },
  "include": ["src"]
}
