{
  "schemaVersion": "1.0.0",
  "id": "pedidos-venda-abertos",
  "name": "Portal do Vendedor",
  "description": "Portal comercial para acompanhamento da carteira de clientes e pedidos de venda em aberto.",
  "icon": "clipboard-list",
  "version": "1.2.0",
  "type": "microfrontend",

  "basePath": "/apps/pedidos-venda-abertos",
  "entry": "/apps/pedidos-venda-abertos/assets/remoteEntry.js",

  "permissions": [
    {
      "code": "pedidos-venda-abertos.access",
      "name": "Acessar Portal do Vendedor",
      "description": "Permite acessar o Portal do Vendedor com a própria carteira de clientes.",
      "module": "pedidos-venda-abertos"
    },
    {
      "code": "pedidos-venda-abertos.admin",
      "name": "Administrar Portal do Vendedor",
      "description": "Permite configurar vendedores/carteiras e acompanhar todas as carteiras.",
      "module": "pedidos-venda-abertos"
    }
  ],

  "routes": [
    {
      "path": "/apps/pedidos-venda-abertos",
      "label": "Portal do Vendedor",
      "permission": "pedidos-venda-abertos.access",
      "icon": "clipboard-list",
      "order": 14,
      "showInMenu": true
    },
    {
      "path": "/apps/pedidos-venda-abertos/clientes",
      "label": "Minha carteira",
      "permission": "pedidos-venda-abertos.access",
      "icon": "clipboard-list",
      "order": 15,
      "showInMenu": false
    },
    {
      "path": "/apps/pedidos-venda-abertos/configuracao",
      "label": "Configuração",
      "permission": "pedidos-venda-abertos.admin",
      "icon": "settings",
      "order": 16,
      "showInMenu": false
    }
  ],

  "ui": {
    "renderMode": "federated"
  }
}
