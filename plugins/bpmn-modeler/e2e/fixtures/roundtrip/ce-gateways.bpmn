      <bpmndi:BPMNShape id="SH_GEB" bpmnElement="GEB"><dc:Bounds x="840" y="133" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_ICE_MSG" bpmnElement="ICE_MSG"><dc:Bounds x="960" y="82" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_RT_GW" bpmnElement="RT_GW"><dc:Bounds x="930" y="200" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_E_GW" bpmnElement="E_GW"><dc:Bounds x="1100" y="140" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ED_F_S" bpmnElement="F_S"><di:waypoint x="76" y="158"/><di:waypoint x="140" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_XC" bpmnElement="F_XC"><di:waypoint x="165" y="133"/><di:waypoint x="260" y="100"/><bpmndi:BPMNLabel><dc:Bounds x="180" y="90" width="40" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_XD" bpmnElement="F_XD"><di:waypoint x="165" y="183"/><di:waypoint x="260" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_A" bpmnElement="F_A"><di:waypoint x="360" y="100"/><di:waypoint x="430" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_B" bpmnElement="F_B"><di:waypoint x="360" y="240"/><di:waypoint x="430" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_P1" bpmnElement="F_P1"><di:waypoint x="480" y="140"/><di:waypoint x="550" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_P2" bpmnElement="F_P2"><di:waypoint x="480" y="175"/><di:waypoint x="550" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_I1" bpmnElement="F_I1"><di:waypoint x="650" y="100"/><di:waypoint x="720" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_I2" bpmnElement="F_I2"><di:waypoint x="650" y="240"/><di:waypoint x="720" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_EB" bpmnElement="F_EB"><di:waypoint x="770" y="158"/><di:waypoint x="840" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_EB1" bpmnElement="F_EB1"><di:waypoint x="890" y="145"/><di:waypoint x="960" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_EB2" bpmnElement="F_EB2"><di:waypoint x="890" y="175"/><di:waypoint x="930" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_E1" bpmnElement="F_E1"><di:waypoint x="996" y="100"/><di:waypoint x="1100" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_F_E2" bpmnElement="F_E2"><di:waypoint x="1030" y="240"/><di:waypoint x="1110" y="175"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
