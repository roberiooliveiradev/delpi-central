{
  "$schema": "./shared-libraries.manifest.schema.json",
  "description": "Bibliotecas TypeScript em plugins/ consumidas por MFEs. plugin-ui: remote MF (delpi-plugin-ui); tv-dashboard-presentation: alias Vite + COPY/builder.",
  "requiredBuildContext": "../plugins",
  "sharedBuilderImage": "delpi-plugins-shared-builder:local",
  "sharedBuilderDockerfile": "docker/Dockerfile.shared-libs-builder",
  "libraries": [
    {
      "id": "plugin-ui",
      "directory": "plugin-ui",
      "packageName": "@delpi/plugin-ui",
      "consumptionMode": "federation-remote",
      "remoteEntry": "/apps/plugin-ui/assets/remoteEntry.js",
      "remoteMarkers": [
        "/apps/plugin-ui/assets/remoteEntry.js",
        "pluginUiRemote",
        "@delpi/plugin-ui",
        "PLUGIN_UI_REMOTE_ENTRY",
        "resolvePluginUiRemoteEntry"
      ],
      "markers": [
        "@delpi/plugin-ui",
        "plugin-ui/src/styles.css",
        "@delpi/plugin-ui/styles",
        "../plugin-ui/",
        "\"../plugin-ui"
      ]
    },
    {
      "id": "tv-dashboard-presentation",
      "directory": "tv-dashboard-presentation",
      "packageName": "@delpi/tv-dashboard-presentation",
      "consumptionMode": "bundled",
      "markers": [
        "@delpi/tv-dashboard-presentation",
        "tv-dashboard-presentation/",
        "../tv-dashboard-presentation/"
      ]
    }
  ]
}
