{
  "name": "minha-delpi-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:product-operational-content": "cp ../../minha-delpi-ai-api/app/content/pt-BR/assistant/product_operational_content.json src/content/product_operational_content.json",
    "sync:presentation-vocabulary": "cp ../../minha-delpi-ai-api/app/content/pt-BR/assistant/presentation_vocabulary.json src/content/presentation_vocabulary.json",
    "sync:message-composer-content": "cp ../../minha-delpi-ai-api/app/content/pt-BR/assistant/message_composer.json src/content/message_composer.json",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.576.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
