{
  "schemaVersion": "1.0.0",
  "id": "commercial",
  "name": "Portal Comercial",
  "description": "Portal comercial nativo: início, visão geral, minhas tarefas, pedidos, carteira e administração de carteiras.",
  "icon": "briefcase",
  "version": "0.3.1",
  "type": "microfrontend",
  "basePath": "/apps/commercial",
  "entry": "/apps/commercial/assets/remoteEntry.js",
  "permissions": [
    {
      "code": "commercial.accounts.view",
      "name": "Acessar Portal Comercial",
      "description": "Acesso ao Portal (pedidos, conta). Minha Carteira exige membership ou team/manage.",
      "module": "commercial"
    },
    {
      "code": "commercial.worklist.view",
      "name": "Ver Minhas tarefas / worklist",
      "description": "Acessar Minhas tarefas, worklist e listagem de tarefas do vendedor.",
      "module": "commercial"
    },
    {
      "code": "commercial.followups.manage",
      "name": "Gerir follow-ups próprios",
      "description": "Criar e concluir tarefas e registrar atividades comerciais próprias.",
      "module": "commercial"
    },
    {
      "code": "commercial.seller-portfolios.manage",
      "name": "Administrar carteiras comerciais",
      "description": "CRUD de carteiras, transferências e escopo irrestrito de pedidos/carteira.",
      "module": "commercial"
    },
    {
      "code": "commercial.audit.view",
      "name": "Ver auditoria comercial",
      "description": "Consultar trilha de auditoria do módulo quando exposta.",
      "module": "commercial"
    },
    {
      "code": "commercial.analytics.view",
      "name": "Ver Visão geral",
      "description": "Acesso à Visão geral e às análises de OTD e oportunidades OV.",
      "module": "commercial"
    },
    {
      "code": "commercial.proposals.view",
      "name": "Ver propostas documento",
      "description": "Listar e abrir propostas ADY.",
      "module": "commercial"
    },
    {
      "code": "commercial.proposals.export",
      "name": "Exportar PDF de proposta",
      "description": "Gerar PDF revisável de proposta ADY com overrides.",
      "module": "commercial"
    },
    {
      "code": "commercial.accounts.team.view",
      "name": "Ver carteira da equipe",
      "description": "Filtrar pedidos/carteira por vendedor e ver Gestão Equipe.",
      "module": "commercial"
    },
    {
      "code": "commercial.worklist.team.view",
      "name": "Ver worklist da equipe",
      "description": "Minhas tarefas com escopo equipe (scope=team).",
      "module": "commercial"
    }
  ],
  "routes": [
    {
      "path": "/apps/commercial",
      "label": "Portal Comercial",
      "permission": "commercial.accounts.view",
      "icon": "briefcase",
      "order": 13,
      "showInMenu": true
    },
    {
      "path": "/apps/commercial/overview",
      "label": "Visão geral",
      "permission": "commercial.analytics.view",
      "icon": "bar-chart-2",
      "order": 14,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/my-tasks",
      "label": "Minhas tarefas",
      "permission": "commercial.worklist.view",
      "icon": "calendar-check",
      "order": 15,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/my-day",
      "label": "Minhas tarefas",
      "permission": "commercial.worklist.view",
      "icon": "calendar-check",
      "order": 16,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/open-orders",
      "label": "Meus pedidos",
      "permission": "commercial.accounts.view",
      "icon": "clipboard-list",
      "order": 17,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/customers",
      "label": "Minha Carteira",
      "permission": "commercial.accounts.view",
      "icon": "users",
      "order": 18,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/proposals",
      "label": "Propostas",
      "permission": "commercial.proposals.view",
      "icon": "file-text",
      "order": 19,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/analytics",
      "label": "Visão geral",
      "permission": "commercial.analytics.view",
      "icon": "bar-chart-2",
      "order": 20,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/analytics/otd",
      "label": "Pontualidade (OTD)",
      "permission": "commercial.analytics.view",
      "icon": "clock",
      "order": 21,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/analytics/team",
      "label": "Equipe",
      "permission": "commercial.accounts.team.view",
      "icon": "users",
      "order": 22,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/analytics/opportunities",
      "label": "Oportunidades",
      "permission": "commercial.analytics.view",
      "icon": "target",
      "order": 23,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/administration",
      "label": "Administração",
      "permission": "commercial.seller-portfolios.manage",
      "icon": "settings",
      "order": 24,
      "showInMenu": false
    },
    {
      "path": "/apps/commercial/seller-portfolios",
      "label": "Carteiras",
      "permission": "commercial.seller-portfolios.manage",
      "icon": "settings",
      "order": 25,
      "showInMenu": false
    }
  ],
  "ui": {
    "renderMode": "federated"
  }
}
