{
  "schemaVersion": "1.0.0",
  "id": "commercial",
  "name": "Portal Comercial",
  "description": "Portal comercial nativo: início, visão geral, minhas tarefas, pedidos, carteira e administração de carteiras.",
  "icon": "briefcase-business",
  "version": "0.4.0",
  "type": "microfrontend",
  "basePath": "/apps/commercial",
  "entry": "/apps/commercial/assets/remoteEntry.js",
  "permissions": [
    {
      "code": "commercial.access",
      "name": "Acessar Portal Comercial",
      "description": "Acesso às funcionalidades do produto (pedidos, tarefas, visão geral, propostas). Minha Carteira exige membership ou commercial.manage.",
      "module": "commercial"
    },
    {
      "code": "commercial.manage",
      "name": "Administrar Portal Comercial",
      "description": "Administração (CRUD carteiras/equipe/grupos), escopo irrestrito e visão de todas as carteiras.",
      "module": "commercial"
    },
    {
      "code": "commercial.billing.notify",
      "name": "Receber notificação de faturamento",
      "description": "Receber notificação quando pedido entra em Pronto para faturar. Não libera telas admin nem escopo de carteiras.",
      "module": "commercial"
    }
  ],
  "routes": [
