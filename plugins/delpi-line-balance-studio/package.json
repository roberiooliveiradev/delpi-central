{
  "name": "@delpi/line-balance-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/studio.d.ts",
      "default": "./dist/ui/studio.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && node scripts/prepare-preview.mjs --assets",
    "build:preview": "npm run build && node scripts/prepare-preview.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:preview": "node tests/preview-smoke.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "playwright": "1.62.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3"
  }
}
