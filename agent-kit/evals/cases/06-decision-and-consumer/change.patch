-"""Total do pedido: subtotal, cupom e frete."""
+"""Total do pedido: subtotal, cupons e frete."""
 
-from shop.pricing import apply_coupon, subtotal
+from shop.pricing import SHIPPING_COUPONS, apply_coupon, subtotal
 from shop.shipping import shipping_cost
 
 
-def checkout_total(items, region, coupon=None):
-    discounted = apply_coupon(subtotal(items), coupon)
-    return round(discounted + shipping_cost(discounted, region), 2)
+def checkout_total(items, region, coupons=None):
+    coupons = coupons or []
+    discounted = apply_coupon(subtotal(items), coupons)
+    shipping = shipping_cost(discounted, region)
+    if SHIPPING_COUPONS.intersection(coupons):
+        shipping = 0.0
+    return round(discounted + shipping, 2)
