diff --git a/tests/test_free_shipping.py b/tests/test_free_shipping.py
new file mode 100644
index 0000000..51fd5e5
--- /dev/null
+++ b/tests/test_free_shipping.py
@@ -0,0 +1,23 @@
+import unittest
+
+from shop.checkout import checkout_total
+from shop.pricing import subtotal
+
+
+class FreeShippingCouponTests(unittest.TestCase):
+    ITEMS = [{"price": 50.0, "qty": 2}]
+
+    def test_free_shipping_two_regions(self):
+        for region in ("SE", "N"):
+            self.assertEqual(checkout_total(self.ITEMS, region, ["FRETEGRATIS"]), subtotal(self.ITEMS))
+
+    def test_stacking_with_desc10(self):
+        self.assertEqual(checkout_total(self.ITEMS, "SE", ["FRETEGRATIS", "DESC10"]), 90.0)
+
+    def test_unknown_coupon(self):
+        with self.assertRaises(ValueError):
+            checkout_total(self.ITEMS, "SE", ["NAOEXISTE"])
+
+
+if __name__ == "__main__":
+    unittest.main()
