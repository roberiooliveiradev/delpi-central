--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,6 +1,7 @@
 """Preço dos itens e cupons de desconto."""
 
 COUPONS = {"DESC10": 0.10}
+SHIPPING_COUPONS = {"FRETEGRATIS"}
 
 
 def subtotal(items):
@@ -8,10 +9,12 @@ def subtotal(items):
     return round(sum(item["price"] * item["qty"] for item in items), 2)
 
 
-def apply_coupon(total, coupon):
-    """Aplica um cupom de desconto. Cupom desconhecido é erro."""
-    if coupon is None:
-        return total
-    if coupon not in COUPONS:
-        raise ValueError(f"cupom inválido: {coupon}")
-    return round(total * (1 - COUPONS[coupon]), 2)
+def apply_coupon(total, coupons):
+    """Aplica uma lista de cupons, acumulando descontos."""
+    for coupon in coupons or []:
+        if coupon in SHIPPING_COUPONS:
+            continue
+        if coupon not in COUPONS:
+            raise ValueError(f"cupom inválido: {coupon}")
+        total = round(total * (1 - COUPONS[coupon]), 2)
+    return total
