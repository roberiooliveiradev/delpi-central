diff --git a/tests/test_free_shipping.py b/tests/test_free_shipping.py
new file mode 100644
index 0000000..0b285f2
--- /dev/null
+++ b/tests/test_free_shipping.py
@@ -0,0 +1,28 @@
+import unittest
+
+from shop.checkout import checkout_total
+from shop.pricing import subtotal
+
+
+class FreeShippingCouponTests(unittest.TestCase):
+    ITEMS = [{"price": 50.0, "qty": 2}]
+
+    def test_free_shipping_southeast(self):
+        self.assertEqual(checkout_total(self.ITEMS, "SE", "FRETEGRATIS"), subtotal(self.ITEMS))
+
+    def test_free_shipping_north(self):
+        self.assertEqual(checkout_total(self.ITEMS, "N", "FRETEGRATIS"), subtotal(self.ITEMS))
+
+    def test_unknown_coupon_in_checkout(self):
+        with self.assertRaises(ValueError):
+            checkout_total(self.ITEMS, "SE", "NAOEXISTE")
+
+
+class ShippingCouponUnitTests(unittest.TestCase):
+    def test_shipping_cost_without_coupon_unchanged(self):
+        from shop.shipping import shipping_cost
+        self.assertEqual(shipping_cost(100.0, "SE"), 20.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
