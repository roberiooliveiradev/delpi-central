[Unit]
Description=ATLAS HML SNAPSHOT PRODUCER CANDIDATE
ConditionPathExists=/run/atlas-hml-candidate/REVIEW-ONLY-NEVER-CREATE
RefuseManualStart=yes

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/false
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
ReadWritePaths=/run/atlas-hml-readonly
