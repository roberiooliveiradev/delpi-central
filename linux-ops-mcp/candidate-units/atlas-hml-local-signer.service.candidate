[Unit]
Description=ATLAS HML LOCAL SIGNER CANDIDATE
ConditionPathExists=/run/atlas-hml-candidate/REVIEW-ONLY-NEVER-CREATE
RefuseManualStart=yes

[Service]
Type=simple
User=atlas-hml-signer
Group=atlas-hml-signer
ExecStart=/usr/bin/false
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
SupplementaryGroups=
InaccessiblePaths=/run/docker.sock /var/run/docker.sock
ReadOnlyPaths=/run/atlas-hml-signer
ReadWritePaths=/run/atlas-hml-signer-socket /var/lib/atlas-hml-signer-state
