[Unit]
Description=ATLAS HML LOCAL SIGNER CANDIDATE
ConditionPathExists=/run/atlas-hml-candidate/REVIEW-ONLY-NEVER-CREATE
RefuseManualStart=yes

[Service]
Type=simple
User=atlas-hml-signer
Group=atlas-hml-signer
SupplementaryGroups=
ExecStart=/usr/bin/false
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
StandardInput=null
FileDescriptorStoreMax=0
InaccessiblePaths=/run/docker.sock /var/run/docker.sock
ReadOnlyPaths=/run/atlas-hml-signer
ReadWritePaths=/run/atlas-hml-signer-socket /var/lib/atlas-hml-signer-state
