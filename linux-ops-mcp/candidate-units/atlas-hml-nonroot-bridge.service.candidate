[Unit]
Description=ATLAS HML NONROOT BRIDGE CANDIDATE
ConditionPathExists=/run/atlas-hml-candidate/REVIEW-ONLY-NEVER-CREATE
RefuseManualStart=yes

[Service]
Type=oneshot
User=atlas-hml-bridge
Group=atlas-hml-bridge
SupplementaryGroups=atlas-hml
ExecStart=/usr/bin/false
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
StandardInput=null
FileDescriptorStoreMax=0
InaccessiblePaths=/run/docker.sock /var/run/docker.sock /run/atlas-hml-signer /var/lib/atlas-hml-signer-state /var/lib/atlas-hml-signer-keys
ReadOnlyPaths=/run/atlas-hml-readonly
