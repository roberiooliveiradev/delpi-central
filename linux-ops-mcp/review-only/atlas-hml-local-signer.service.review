# ATLAS HML - DESIGN REVIEW ONLY. NOT AN INSTALLABLE SYSTEMD UNIT.
# Local Ed25519 signer: no Docker Engine access; private key path review-only.
# Owner-accepted residual: root on the same host can still read the key file.
[Unit]
Description=ATLAS HML LOCAL SIGNER REVIEW ONLY
ConditionPathExists=/run/atlas-hml-signer/REVIEW-ONLY-NEVER-CREATE
RefuseManualStart=yes

[Service]
Type=simple
User=atlas-hml-signer
Group=atlas-hml-signer
SupplementaryGroups=
ExecStart=/usr/bin/false
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/run/docker.sock /var/run/docker.sock
ReadOnlyPaths=/run/atlas-hml-signer
UMask=0077
