# -----------------
# portal - DOCKERFILE PROD
# Build context: monorepo root (delpi-central/)
# Compose: context: ..  dockerfile: portal/Dockerfile.prod
# -----------------

# -------- build stage --------
FROM node:20-alpine AS build

WORKDIR /app

COPY portal/package*.json ./
RUN npm ci

COPY portal/ ./

# Reexport em portal/vite/cacheBustEntryPlugin.ts → ../../plugins/vite/...
# resolve para /plugins/vite a partir de /app/vite/
RUN mkdir -p /plugins/vite
COPY plugins/vite/cacheBustEntryPlugin.ts /plugins/vite/cacheBustEntryPlugin.ts

RUN chmod -R +x node_modules/.bin

ARG VITE_KC_URL
ARG VITE_KC_REALM
ARG VITE_KC_CLIENT_ID
ARG VITE_KC_REDIRECT_URI

ENV VITE_KC_URL=$VITE_KC_URL
ENV VITE_KC_REALM=$VITE_KC_REALM
ENV VITE_KC_CLIENT_ID=$VITE_KC_CLIENT_ID
ENV VITE_KC_REDIRECT_URI=$VITE_KC_REDIRECT_URI

RUN npm run build


# -------- runtime --------
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY portal/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
